    /* ===== 联机匹配 ===== */
    .battle-matching { max-width:600px; margin:40px auto; padding:20px 0; text-align:center; }
    .match-container { background:linear-gradient(160deg,rgba(0,212,255,0.06),rgba(168,85,247,0.06)); border:2px solid rgba(0,212,255,0.2); border-radius:24px; padding:50px 30px; position:relative; overflow:hidden; }
    .match-container::before { content:''; position:absolute; top:0;left:0;right:0; height:3px; background:linear-gradient(90deg,transparent,var(--primary),#a855f7,transparent); animation:matchShimmer 2s ease-in-out infinite; }
    @keyframes matchShimmer { 0%,100%{opacity:0.5;} 50%{opacity:1;} }
    .match-icon { font-size:56px; animation:matchPulse 1.5s ease-in-out infinite; }
    @keyframes matchPulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.15);} }
    .match-container h2 { font-size:28px; margin:15px 0 8px; background:linear-gradient(135deg,var(--primary),#a855f7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
    .match-sub { color:var(--text-muted); font-size:15px; margin-bottom:25px; }
    .match-ring { width:140px; height:140px; border-radius:50%; margin:0 auto 25px; border:4px solid rgba(0,212,255,0.15); position:relative; display:flex; align-items:center; justify-content:center; }
    .match-ring::before { content:''; position:absolute; top:-4px;left:-4px;right:-4px;bottom:-4px; border-radius:50%; border:4px solid transparent; border-top-color:var(--primary); animation:matchSpin 1s linear infinite; }
    @keyframes matchSpin { to{transform:rotate(360deg);} }
    .match-ring-inner { display:flex; flex-direction:column; align-items:center; gap:2px; z-index:1; }
    .match-time { font-size:32px; font-weight:900; color:var(--primary); font-family:'Cascadia Code','Consolas',monospace; }
    .match-dots { display:flex; gap:8px; justify-content:center; margin-bottom:20px; }
    .match-dot { width:10px; height:10px; border-radius:50%; background:var(--primary); opacity:0.3; animation:matchDotBounce 1.4s ease-in-out infinite; }
    .match-dot:nth-child(2){ animation-delay:0.2s; }
    .match-dot:nth-child(3){ animation-delay:0.4s; }
    @keyframes matchDotBounce { 0%,80%,100%{transform:scale(0.6);opacity:0.3;} 40%{transform:scale(1.2);opacity:1;} }
    .match-hint { color:var(--text-muted); font-size:14px; margin-bottom:20px; min-height:20px; }
    .match-progress-bar { width:100%; height:6px; background:rgba(255,255,255,0.06); border-radius:3px; overflow:hidden; margin-bottom:20px; }
    .match-progress-fill { height:100%; background:linear-gradient(90deg,var(--primary),#a855f7); border-radius:3px; width:0%; transition:width 1s linear; }
    .match-container .battle-btn-ghost { margin-top:10px; }

    /* ===== 弹窗通用样式（修复位置错乱） ===== */
    .modal-overlay {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: rgba(0, 0, 0, 0.72) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        display: none !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 99999 !important;
        padding: 20px !important;
        box-sizing: border-box !important;
    }

    .modal-overlay.show {
        display: flex !important;
        animation: overlayFadeIn 0.3s ease;
    }

    @keyframes overlayFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-box {
        background: linear-gradient(145deg, #111827 0%, #1a1d2e 100%) !important;
        border: 1px solid rgba(0, 212, 255, 0.2) !important;
        border-radius: 20px !important;
        padding: 35px 30px !important;
        max-width: 560px !important;
        width: 100% !important;
        max-height: 90vh !important;
        overflow-y: auto !important;
        position: relative !important;
        animation: modalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6), 0 0 40px rgba(0, 212, 255, 0.08) !important;
    }

    @keyframes modalSlideUp {
        from { opacity: 0; transform: translateY(40px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .modal-box::-webkit-scrollbar { width: 6px; }
    .modal-box::-webkit-scrollbar-thumb { background: rgba(0,212,255,0.2); border-radius: 3px; }

    .modal-icon {
        font-size: 44px !important;
        text-align: center !important;
        margin-bottom: 12px !important;
        animation: iconBounce 2s ease infinite !important;
    }

    @keyframes iconBounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    .modal-box h2 {
        text-align: center !important;
        font-size: 24px !important;
        margin-bottom: 8px !important;
    }

    .modal-actions {
        display: flex !important;
        gap: 14px !important;
        justify-content: center !important;
        flex-wrap: wrap !important;
        margin-top: 20px !important;
    }

    .btn-confirm, .btn-cancel {
        padding: 12px 30px !important;
        border-radius: 10px !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        cursor: pointer !important;
        transition: all 0.3s !important;
        border: none !important;
        color: #fff !important;
    }

    .btn-confirm {
        background: linear-gradient(135deg, #00d4ff, #0090b8) !important;
        box-shadow: 0 4px 15px rgba(0, 212, 255, 0.3) !important;
    }

    .btn-confirm:hover {
        transform: scale(1.05) !important;
        box-shadow: 0 6px 25px rgba(0, 212, 255, 0.5) !important;
    }

    .btn-cancel {
        background: rgba(255,255,255,0.06) !important;
        border: 1px solid rgba(255,255,255,0.12) !important;
        color: var(--text-muted) !important;
    }

    .btn-cancel:hover {
        background: rgba(255,255,255,0.12) !important;
        color: var(--text-light) !important;
    }

    /* ===== 问题上报弹窗特殊样式 ===== */
    #reportOverlay .modal-box {
        border-color: rgba(239, 68, 68, 0.35) !important;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6), 0 0 40px rgba(239, 68, 68, 0.1) !important;
    }

    .report-form-label {
        display: block !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        margin-bottom: 8px !important;
        color: var(--text-light) !important;
    }

    .report-form-select, .report-form-textarea {
        width: 100% !important;
        padding: 10px 14px !important;
        border-radius: 8px !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        background: rgba(0,0,0,0.3) !important;
        color: var(--text-light) !important;
        font-size: 14px !important;
        font-family: inherit !important;
        box-sizing: border-box !important;
        margin-bottom: 15px !important;
        transition: border-color 0.3s !important;
    }

    .report-form-select:focus, .report-form-textarea:focus {
        outline: none !important;
        border-color: rgba(239, 68, 68, 0.5) !important;
    }

    .report-form-textarea {
        min-height: 120px !important;
        line-height: 1.6 !important;
        resize: vertical !important;
    }

    .report-meta {
        display: flex !important;
        gap: 15px !important;
        flex-wrap: wrap !important;
        font-size: 12px !important;
        color: var(--text-muted) !important;
        margin-top: 5px !important;
    }

    .report-meta label {
        display: flex !important;
        align-items: center !important;
        gap: 4px !important;
        cursor: pointer !important;
    }

    .report-meta input[type="checkbox"] {
        accent-color: #ef4444 !important;
    }

    #reportStatus {
        margin-top: 15px !important;
        font-size: 13px !important;
        padding: 12px 16px !important;
        border-radius: 8px !important;
        display: none !important;
        line-height: 1.7 !important;
    }

    #reportStatus.success {
        display: block !important;
        background: rgba(16,185,129,0.1) !important;
        border: 1px solid rgba(16,185,129,0.25) !important;
        color: #10b981 !important;
    }

    #reportStatus.error {
        display: block !important;
        background: rgba(239,68,68,0.1) !important;
        border: 1px solid rgba(239,68,68,0.25) !important;
        color: #ef4444 !important;
    }

    /* ===== 云端连接状态栏 ===== */
    .cloud-status-bar {
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        padding: 8px 14px !important;
        border-radius: 8px !important;
        background: rgba(0,0,0,0.25) !important;
        border: 1px solid rgba(255,255,255,0.08) !important;
        margin-bottom: 16px !important;
        font-size: 12px !important;
        transition: all 0.3s !important;
    }

    .cloud-status-bar.cloud-online {
        background: rgba(16,185,129,0.08) !important;
        border-color: rgba(16,185,129,0.3) !important;
    }

    .cloud-status-bar.cloud-offline {
        background: rgba(239,68,68,0.08) !important;
        border-color: rgba(239,68,68,0.3) !important;
    }

    .cloud-status-bar.cloud-checking {
        background: rgba(245,158,11,0.08) !important;
        border-color: rgba(245,158,11,0.3) !important;
    }

    .cloud-dot {
        width: 8px !important;
        height: 8px !important;
        border-radius: 50% !important;
        flex-shrink: 0 !important;
        transition: all 0.3s !important;
    }

    .cloud-status-bar.cloud-online .cloud-dot {
        background: #10b981 !important;
        box-shadow: 0 0 8px #10b981 !important;
        animation: cloudPulse 2s infinite !important;
    }

    .cloud-status-bar.cloud-offline .cloud-dot {
        background: #ef4444 !important;
        box-shadow: 0 0 6px #ef4444 !important;
    }

    .cloud-status-bar.cloud-checking .cloud-dot {
        background: #f59e0b !important;
        animation: cloudBlink 0.8s infinite !important;
    }

    @keyframes cloudPulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }

    @keyframes cloudBlink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .cloud-text {
        flex: 1 !important;
        color: var(--text-muted) !important;
        font-size: 12px !important;
    }

    .cloud-status-bar.cloud-online .cloud-text { color: #10b981 !important; }
    .cloud-status-bar.cloud-offline .cloud-text { color: #ef4444 !important; }
    .cloud-status-bar.cloud-checking .cloud-text { color: #f59e0b !important; }

    .cloud-retry-btn {
        background: rgba(255,255,255,0.1) !important;
        border: 1px solid rgba(255,255,255,0.15) !important;
        color: var(--text-light) !important;
        padding: 3px 10px !important;
        border-radius: 5px !important;
        font-size: 11px !important;
        cursor: pointer !important;
        transition: all 0.2s !important;
    }
    .cloud-retry-btn:hover { background: rgba(255,255,255,0.18) !important; }

    /* 云端提交按钮 */
    .cloud-submit-btn .btn-cloud-icon {
        display: inline-block;
        transition: transform 0.3s !important;
    }
    .cloud-submit-btn:hover .btn-cloud-icon {
        transform: translateY(-2px) !important;
    }

    .local-submit-btn {
        font-size: 13px !important;
        padding: 10px 16px !important;
    }

    /* 云端提交进度条 */
    .cloud-progress {
        margin-top: 12px !important;
        height: 4px !important;
        background: rgba(255,255,255,0.08) !important;
        border-radius: 2px !important;
        overflow: hidden !important;
    }

    .cloud-progress-bar {
        height: 100% !important;
        width: 0% !important;
        background: linear-gradient(90deg, #10b981, #00d4ff) !important;
        border-radius: 2px !important;
        transition: width 0.3s ease !important;
    }

    /* 云端提交成功动画 */
    .cloud-success-anim {
        animation: cloudSuccessPop 0.5s ease !important;
    }
    @keyframes cloudSuccessPop {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    /* 导航栏云端指示器 */
    .nav-cloud-indicator {
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
        padding: 3px 10px !important;
        border-radius: 12px !important;
        font-size: 11px !important;
        font-weight: 600 !important;
        margin-left: 10px !important;
        cursor: pointer !important;
        transition: all 0.3s !important;
        vertical-align: middle !important;
    }

    .nav-cloud-indicator.online {
        background: rgba(16,185,129,0.15) !important;
        border: 1px solid rgba(16,185,129,0.35) !important;
        color: #10b981 !important;
    }

    .nav-cloud-indicator.offline {
        background: rgba(239,68,68,0.12) !important;
        border: 1px solid rgba(239,68,68,0.3) !important;
        color: #ef4444 !important;
    }

    .nav-cloud-indicator.checking {
        background: rgba(245,158,11,0.12) !important;
        border: 1px solid rgba(245,158,11,0.3) !important;
        color: #f59e0b !important;
    }

    .nav-cloud-indicator .nc-dot {
        width: 6px !important;
        height: 6px !important;
        border-radius: 50% !important;
        display: inline-block !important;
    }
    .nav-cloud-indicator.online .nc-dot { background: #10b981; box-shadow: 0 0 6px #10b981; }
    .nav-cloud-indicator.offline .nc-dot { background: #ef4444; }
    .nav-cloud-indicator.checking .nc-dot { background: #f59e0b; animation: cloudBlink 0.8s infinite; }

    /* ===== 浏览器适配提示条 ===== */
    .browser-bar {
        display: none;
        position: fixed;
        top: 70px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9998;
        padding: 10px 24px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        animation: slideDownBar 0.4s ease;
        max-width: 90vw;
        box-sizing: border-box;
    }

    @keyframes slideDownBar {
        from { opacity: 0; transform: translateX(-50%) translateY(-15px); }
        to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    .browser-bar.warning {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.35);
        color: #f59e0b;
    }

    .browser-bar.info {
        background: rgba(0, 212, 255, 0.1);
        border: 1px solid rgba(0, 212, 255, 0.25);
        color: var(--primary);
    }

    .browser-bar .close-bar {
        margin-left: 12px;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.2s;
    }

    .browser-bar .close-bar:hover { opacity: 1; }

    /* ===== Edge 深度适配专属样式 ===== */
    body.browser-edge {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
    }

    body.browser-edge .navbar {
        -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
        backdrop-filter: blur(20px) saturate(180%) !important;
        background: rgba(10, 14, 26, 0.9) !important;
    }

    body.browser-edge .bg-animation span {
        will-change: transform, opacity !important;
        transform: translateZ(0) !important;
    }

    body.browser-edge .modal-overlay {
        -webkit-backdrop-filter: blur(8px) saturate(120%) !important;
        backdrop-filter: blur(8px) saturate(120%) !important;
    }

    body.browser-edge .modal-box {
        transform: translateZ(0) !important;
        will-change: transform, opacity !important;
    }

    body.browser-edge .action-btn,
    body.browser-edge .diff-btn,
    body.browser-edge .practice-option,
    body.browser-edge .judge-btn,
    body.browser-edge .btn-confirm,
    body.browser-edge .btn-cancel {
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease !important;
    }

    body.browser-edge .terminal-animation,
    body.browser-edge .practice-code-block {
        font-family: 'Consolas', 'Cascadia Code', 'Courier New', monospace !important;
    }

    body.browser-edge .gradient-text,
    body.browser-edge .hero-section h1,
    body.browser-edge .page-header h1 {
        -webkit-background-clip: text !important;
        background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }

    /* Edge 兼容：backdrop-filter 降级 */
    @supports not ((-webkit-backdrop-filter: blur(8px)) or (backdrop-filter: blur(8px))) {
        .modal-overlay { background: rgba(0, 0, 0, 0.88) !important; }
        .navbar { background: rgba(10, 14, 26, 0.96) !important; }
    }

    /* ===== 全局响应式适配 ===== */
    @media (max-width: 1200px) {
        .hero-stats { grid-template-columns: repeat(2, 1fr); }
        .quick-actions { grid-template-columns: 1fr; max-width: 500px; }
        .module-grid { grid-template-columns: 1fr; }
        .score-overview { grid-template-columns: 1fr; }
        .navbar { padding: 0 20px; }
        .page { padding: 100px 20px 40px; }
    }

    @media (max-width: 768px) {
        .navbar { height: 60px; padding: 0 12px; }
        .navbar .logo { font-size: 16px; }
        .nav-links { gap: 2px; }
        .nav-links a { padding: 6px 10px; font-size: 12px; }
        .hero-section h1 { font-size: 36px; }
        .hero-section .subtitle { font-size: 16px; }
        .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .stat-card { padding: 20px 12px; }
        .stat-card .number { font-size: 28px; }
        .quick-actions { grid-template-columns: 1fr; }
        .action-btn { padding: 16px 20px; font-size: 14px; }
        .page { padding: 80px 12px 30px; }
        .page-header h1 { font-size: 28px; }
        .question-card { padding: 25px 18px; }
        .question-text { font-size: 17px; }
        .judge-buttons { gap: 12px; }
        .judge-btn { padding: 12px 30px; font-size: 16px; }
        .modal-box { padding: 25px 20px; border-radius: 16px; }
        .modal-box h2 { font-size: 20px; }
        .btn-confirm, .btn-cancel { padding: 10px 22px; font-size: 14px; }
        .practice-code-block { font-size: 12px; padding: 15px; }
        .terminal-animation { font-size: 12px; padding: 15px; }
    }

    @media (max-width: 480px) {
        .hero-section h1 { font-size: 28px; }
        .hero-stats { grid-template-columns: 1fr; }
        .difficulty-selector { gap: 6px; }
        .diff-btn { padding: 8px 16px; font-size: 12px; }
        .judge-btn { padding: 10px 24px; font-size: 14px; }
        .nav-links a { padding: 5px 7px; font-size: 11px; }
        .navbar .logo .icon { font-size: 20px; }
    }

    /* ===== 高 DPI / 缩放适配 ===== */
    @media (min-resolution: 2dppx) {
        body.browser-edge {
            text-rendering: optimizeLegibility !important;
        }
    }

    /* ===== 系统深色/浅色模式适配 ===== */
    @media (prefers-color-scheme: light) {
        /* 保持深色主题为主，但调整对比度 */
        body.browser-edge {
            background: #0a0e1a !important;
        }
    }

    /* ===== 减少动画偏好适配 ===== */
    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
        .bg-animation { display: none !important; }
    }

    /* ===== 打印适配 ===== */
    @media print {
        .navbar, .bg-animation, .browser-bar, .modal-overlay { display: none !important; }
        body { background: #fff !important; color: #000 !important; }
        .page { display: block !important; padding: 20px !important; }
    }

    /* ===== 设置页面 ===== */
    .settings-container {
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .settings-section {
        background: var(--bg-card);
        border: 1px solid rgba(0, 212, 255, 0.12);
        border-radius: 18px;
        padding: 32px;
        position: relative;
        overflow: hidden;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

    .settings-section::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--primary), transparent);
    }

    .settings-section:hover {
        border-color: rgba(0, 212, 255, 0.25);
        box-shadow: 0 8px 32px rgba(0, 212, 255, 0.06);
    }

    .settings-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .settings-section-title .section-icon {
        font-size: 28px;
    }

    .settings-section-title h2 {
        font-size: 22px;
        font-weight: 800;
        background: var(--gradient-1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }

    .settings-section-desc {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 24px;
        line-height: 1.6;
    }

    /* 兼容性 - 浏览器选择 */
    .browser-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .browser-card {
        background: rgba(255,255,255,0.03);
        border: 2px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 20px 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        user-select: none;
    }

    .browser-card:hover {
        background: rgba(255,255,255,0.06);
        transform: translateY(-3px);
    }

    .browser-card.active {
        border-color: var(--primary);
        background: rgba(0, 212, 255, 0.08);
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.15);
    }

    .browser-card .browser-logo {
        font-size: 36px;
        margin-bottom: 8px;
        display: block;
    }

    .browser-card .browser-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-light);
        margin-bottom: 4px;
    }

    .browser-card .browser-tag {
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 600;
    }

    .browser-tag.exclusive {
        background: rgba(168, 85, 247, 0.18);
        color: #c4b5fd;
    }

    .browser-tag.deep {
        background: rgba(245, 158, 11, 0.18);
        color: #fbbf24;
    }

    .browser-tag.standard {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
    }

    .browser-card .browser-check {
        position: absolute;
        top: 8px;
        right: 8px;
        font-size: 16px;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .browser-card.active .browser-check {
        opacity: 1;
    }

    .browser-card .browser-badge-auto {
        position: absolute;
        top: 8px;
        left: 8px;
        font-size: 9px;
        padding: 1px 6px;
        border-radius: 8px;
        background: rgba(0, 212, 255, 0.2);
        color: var(--primary);
        font-weight: 700;
        display: none;
    }

    .browser-card.auto-detected .browser-badge-auto {
        display: block;
    }

    /* 手机适配提示 */
    .mobile-notice {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        background: rgba(0, 212, 255, 0.06);
        border: 1px solid rgba(0, 212, 255, 0.15);
        border-radius: 10px;
        font-size: 13px;
        color: var(--text-muted);
        margin-top: 16px;
    }

    .mobile-notice .mn-icon {
        font-size: 20px;
    }

    /* 性能 - 画质档位 */
    .perf-levels {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }

    .perf-card {
        background: rgba(255,255,255,0.03);
        border: 2px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 18px 10px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        user-select: none;
    }

    .perf-card:hover {
        background: rgba(255,255,255,0.06);
        transform: translateY(-2px);
    }

    .perf-card.active {
        border-color: var(--primary);
        background: rgba(0, 212, 255, 0.08);
        box-shadow: 0 0 16px rgba(0, 212, 255, 0.12);
    }

    .perf-card .perf-icon {
        font-size: 28px;
        margin-bottom: 6px;
        display: block;
    }

    .perf-card .perf-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-light);
    }

    .perf-card .perf-name-cn {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .perf-card.active .perf-name {
        color: var(--primary);
    }

    /* 性能模式开关 */
    .perf-mode-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        background: rgba(16, 185, 129, 0.06);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 14px;
        margin-bottom: 20px;
    }

    .perf-mode-info {
        flex: 1;
    }

    .perf-mode-info .perf-mode-title {
        font-size: 16px;
        font-weight: 700;
        color: #34d399;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .perf-mode-info .perf-mode-desc {
        font-size: 13px;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* Toggle Switch */
    .toggle-switch {
        position: relative;
        width: 56px;
        height: 30px;
        flex-shrink: 0;
        margin-left: 16px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255,255,255,0.12);
        border-radius: 30px;
        transition: 0.3s;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .toggle-slider::before {
        content: '';
        position: absolute;
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background: #fff;
        border-radius: 50%;
        transition: 0.3s;
    }

    .toggle-switch input:checked + .toggle-slider {
        background: linear-gradient(135deg, #10b981, #059669);
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16,185,129,0.4);
    }

    .toggle-switch input:checked + .toggle-slider::before {
        transform: translateX(26px);
    }

    /* 性能详情 */
    .perf-details {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .perf-detail-item {
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 10px;
        padding: 14px;
        text-align: center;
    }

    .perf-detail-item .pd-label {
        font-size: 11px;
        color: var(--text-muted);
        margin-bottom: 4px;
    }

    .perf-detail-item .pd-value {
        font-size: 18px;
        font-weight: 800;
        color: var(--primary);
    }

    .perf-detail-item .pd-value.on {
        color: #10b981;
    }

    .perf-detail-item .pd-value.off {
        color: #6b7280;
    }

    /* 设置保存提示 */
    .settings-saved-toast {
        position: fixed;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        padding: 12px 28px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 8px 32px rgba(16,185,129,0.3);
        opacity: 0;
        pointer-events: none;
        transition: all 0.4s;
        z-index: 9999;
    }

    .settings-saved-toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    /* ===== 学习模式 ===== */
    .study-mode-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        background: rgba(99, 102, 241, 0.06);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 14px;
        margin-bottom: 20px;
    }

    .study-mode-row.study-active {
        background: rgba(16, 185, 129, 0.06);
        border-color: rgba(16, 185, 129, 0.25);
    }

    .study-mode-info { flex: 1; }

    .study-mode-info .study-mode-title {
        font-size: 16px;
        font-weight: 700;
        color: #818cf8;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .study-mode-row.study-active .study-mode-title {
        color: #34d399;
    }

    .study-mode-info .study-mode-desc {
        font-size: 13px;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .study-mode-row .toggle-switch {
        margin-left: 16px;
        flex-shrink: 0;
    }

    .toggle-switch input:checked + .toggle-slider.study-slider {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border-color: #6366f1;
        box-shadow: 0 0 12px rgba(99,102,241,0.4);
    }

    .toggle-switch input:checked + .toggle-slider.study-slider-on {
        background: linear-gradient(135deg, #10b981, #059669);
        border-color: #10b981;
        box-shadow: 0 0 12px rgba(16,185,129,0.4);
    }

    /* 学习模式状态徽章 */
    .study-badge {
        display: none;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 10px;
        background: rgba(16,185,129,0.2);
        color: #34d399;
        font-weight: 600;
    }

    .study-badge.show { display: inline-block; }

    .study-badge.locked {
        background: rgba(239,68,68,0.2);
        color: #fca5a5;
    }

    /* 学习模式提示条 */
    .study-notice {
        display: none;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        background: rgba(99,102,241,0.08);
        border: 1px solid rgba(99,102,241,0.2);
        border-radius: 10px;
        font-size: 13px;
        color: var(--text-muted);
        margin-top: 16px;
    }

    .study-notice.show { display: flex; }

    .study-notice .sn-icon { font-size: 20px; }

    /* 密码区域 */
    .password-area {
        display: none;
        margin-top: 16px;
        padding: 16px 20px;
        background: rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
    }

    .password-area.show { display: block; }

    .password-area-label {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 10px;
        line-height: 1.6;
    }

    .password-input-row {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .password-input-row input[type="password"],
    .password-input-row input[type="text"] {
        flex: 1;
        min-width: 200px;
        padding: 10px 14px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.04);
        color: var(--text-light);
        font-size: 14px;
        outline: none;
        transition: border-color 0.3s;
    }

    .password-input-row input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 8px rgba(0,212,255,0.2);
    }

    .password-btn {
        padding: 10px 18px;
        border-radius: 8px;
        border: 1px solid rgba(99,102,241,0.3);
        background: rgba(99,102,241,0.15);
        color: #a5b4fc;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        white-space: nowrap;
    }

    .password-btn:hover {
        background: rgba(99,102,241,0.25);
        color: #fff;
    }

    .password-btn.confirm {
        border-color: rgba(16,185,129,0.3);
        background: rgba(16,185,129,0.15);
        color: #6ee7b7;
    }

    .password-btn.confirm:hover {
        background: rgba(16,185,129,0.25);
        color: #fff;
    }

    .password-btn.danger {
        border-color: rgba(239,68,68,0.3);
        background: rgba(239,68,68,0.15);
        color: #fca5a5;
    }

    .password-btn.danger:hover {
        background: rgba(239,68,68,0.25);
        color: #fff;
    }

    .password-hint {
        font-size: 11px;
        color: #6b7280;
        margin-top: 8px;
    }

    .password-error {
        font-size: 12px;
        color: #fca5a5;
        margin-top: 8px;
        display: none;
    }

    .password-error.show { display: block; }

    /* 学习模式遮罩（访问受限页面时） */
    .study-lock-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10,14,26,0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 9998;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 16px;
    }

    .study-lock-overlay.show {
        display: flex;
    }

    .study-lock-box {
        background: var(--bg-card);
        border: 1px solid rgba(99,102,241,0.3);
        border-radius: 18px;
        padding: 36px 40px;
        text-align: center;
        max-width: 420px;
    }

    .study-lock-box .sl-icon { font-size: 48px; margin-bottom: 12px; }

    .study-lock-box h3 {
        font-size: 20px;
        color: #a5b4fc;
        margin-bottom: 8px;
    }

    .study-lock-box p {
        font-size: 13px;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .study-lock-box .password-input-row { margin-bottom: 12px; }

    .study-lock-box .password-error { text-align: left; }

    /* 当前检测信息 */
    .detect-info {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        background: rgba(0,0,0,0.25);
        border-radius: 10px;
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 16px;
        flex-wrap: wrap;
    }

    .detect-info .di-label {
        color: var(--primary);
        font-weight: 600;
    }

    .detect-info .di-tag {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .di-tag.di-pc { background: rgba(59,130,246,0.15); color: #60a5fa; }
    .di-tag.di-mobile { background: rgba(168,85,247,0.15); color: #c4b5fd; }

    /* ===== 安全模式（封测版）v3.3 ===== */
    .sec-overlay {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        display: flex; align-items: center; justify-content: center;
        animation: fadeIn 0.25s ease;
    }
    .sec-modal {
        background: linear-gradient(160deg, #111827 0%, #0f172a 100%);
        border: 1px solid rgba(239,68,68,0.35);
        border-radius: 20px; padding: 36px 40px; max-width: 520px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(239,68,68,0.08) inset;
        animation: slideUp 0.3s ease;
    }
    @keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .sec-modal-icon { font-size: 44px; text-align: center; margin-bottom: 8px; }
    .sec-modal h2 { font-size: 22px; color: #fca5a5; text-align: center; margin-bottom: 16px; }
    .sec-modal-body { font-size: 14px; color: var(--text-light); line-height: 1.8; }
    .sec-modal-body hr { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 14px 0; }
    .sec-warn { color: #fca5a5; font-weight: 600; }
    .sec-modal-body ul { padding-left: 20px; margin: 8px 0; }
    .sec-modal-body li { margin: 4px 0; }
    .sec-note { font-size: 12px; color: var(--text-muted); margin-top: 10px; padding: 10px; background: rgba(239,68,68,0.08); border-radius: 8px; border-left: 3px solid rgba(239,68,68,0.4); }
    .sec-modal-actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; }
    .sec-btn { padding: 10px 22px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; border: 1px solid transparent; transition: all 0.2s; }
    .sec-btn-cancel { background: transparent; color: var(--text-muted); border-color: rgba(255,255,255,0.15); }
    .sec-btn-cancel:hover { background: rgba(255,255,255,0.06); color: var(--text-light); }
    .sec-btn-confirm { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
    .sec-btn-confirm:hover { filter: brightness(1.15); transform: scale(1.03); }
    .sec-btn-danger { background: rgba(239,68,68,0.15); color: #fca5a5; border-color: rgba(239,68,68,0.3); }
    .sec-btn-danger:hover { background: rgba(239,68,68,0.25); }

    /* 顶部状态徽章 */
    .sec-badge {
        position: fixed; top: 76px; left: 50%; transform: translateX(-50%);
        z-index: 999; background: rgba(239,68,68,0.92); color: #fff;
        padding: 6px 20px; border-radius: 20px; font-size: 13px; font-weight: 700;
        box-shadow: 0 4px 16px rgba(239,68,68,0.35); letter-spacing: 0.5px;
        animation: secBadgePulse 2s ease-in-out infinite;
    }
    @keyframes secBadgePulse { 0%,100% { opacity: 1; } 50% { opacity: 0.75; } }

    /* Toast */
    .sec-toast {
        position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(20px);
        padding: 12px 24px; border-radius: 12px; font-size: 14px; font-weight: 600;
        z-index: 10000; opacity: 0; transition: all 0.3s; pointer-events: none;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }
    .sec-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .sec-toast-ok    { background: rgba(16,185,129,0.92); color: #fff; }
    .sec-toast-warn  { background: rgba(239,68,68,0.92); color: #fff; }
    .sec-toast-info  { background: rgba(59,130,246,0.92); color: #fff; }

    /* 设置区块 - 安全模式 */
    .sec-status { font-size: 13px; font-weight: 600; padding: 4px 12px; border-radius: 20px; }
    .sec-status.on  { background: rgba(16,185,129,0.15); color: #34d399; }
    .sec-status.off { background: rgba(239,68,68,0.15); color: #fca5a5; }

    .sec-beta-tag {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(239,68,68,0.12); color: #fca5a5;
        padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 700;
        margin-left: 8px; vertical-align: middle;
        border: 1px solid rgba(239,68,68,0.25);
    }

    .sec-disclaimer {
        margin-top: 14px; padding: 14px 16px;
        background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.18);
        border-radius: 10px; font-size: 12px; color: var(--text-muted); line-height: 1.7;
    }
    .sec-disclaimer strong { color: #fca5a5; }

    /* 引导卡片 */
    .sec-guide-card {
        margin-top: 20px; padding: 20px 24px;
        background: linear-gradient(135deg, rgba(59,130,246,0.06) 0%, rgba(16,185,129,0.04) 100%);
        border: 1px solid rgba(59,130,246,0.2); border-radius: 14px;
    }
    .sec-guide-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
    .sec-guide-icon { font-size: 24px; }
    .sec-guide-title { font-size: 16px; font-weight: 700; color: #93c5fd; }
    .sec-guide-device { font-size: 12px; color: var(--text-muted); background: rgba(255,255,255,0.05); padding: 2px 10px; border-radius: 12px; }
    .sec-guide-steps { padding-left: 20px; margin: 0; }
    .sec-guide-steps li { font-size: 13px; color: var(--text-light); line-height: 1.9; }
    .sec-guide-steps li:last-child { color: var(--text-muted); font-size: 12px; margin-top: 4px; }

    .sec-protect-list { margin: 12px 0 0; padding-left: 20px; }
    .sec-protect-list li { font-size: 13px; color: var(--text-light); line-height: 1.9; }

    /* 响应式 */
    @media (max-width: 768px) {
        .browser-grid { grid-template-columns: repeat(3, 1fr); }
        .perf-levels { grid-template-columns: repeat(3, 1fr); }
        .perf-details { grid-template-columns: repeat(2, 1fr); }
        .settings-section { padding: 22px 18px; }
        .settings-section-title h2 { font-size: 18px; }
        .sec-modal { padding: 24px 20px; max-width: 92vw; }
        .sec-badge { font-size: 11px; padding: 4px 14px; }
    }

    @media (max-width: 480px) {
        .browser-grid { grid-template-columns: repeat(2, 1fr); }
        .perf-levels { grid-template-columns: repeat(2, 1fr); }
        .perf-mode-row { flex-direction: column; gap: 12px; align-items: flex-start; }
        .toggle-switch { margin-left: 0; }
    }

    /* ===== v4.7 扫描阶段可视化 ===== */
    .scan-stages { margin-bottom: 16px; }
    .stages-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .stage-item { display: flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 8px; font-size: 12px; background: rgba(255,255,255,0.04); color: var(--text-muted); border: 1px solid rgba(255,255,255,0.08); transition: all .3s; }
    .stage-item .s-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.15); flex-shrink: 0; }
    .stage-item.running { background: rgba(0,212,255,0.12); border-color: var(--primary); color: var(--primary); }
    .stage-item.running .s-dot { background: var(--primary); animation: pulse-dot 1s infinite; }
    .stage-item.done { background: rgba(16,185,129,0.1); border-color: #10b981; color: #6ee7b7; }
    .stage-item.done .s-dot { background: #10b981; }
    .stage-item.failed { background: rgba(239,68,68,0.1); border-color: #ef4444; color: #fca5a5; }
    .stage-item.failed .s-dot { background: #ef4444; }
    .stage-item.repair { background: rgba(245,158,11,0.1); border-color: #f59e0b; color: #fcd34d; }
    .stage-item.repair .s-dot { background: #f59e0b; animation: pulse-dot .6s infinite; }
    /* 关闭状态 — 灰色 */
    .stage-item.disabled { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05); color: #4b5563; cursor: not-allowed; }
    .stage-item.disabled .s-dot { background: #374151; }
    .stage-item.disabled span:not(.s-dot)::after { content: '（已关闭）'; font-size: 10px; color: #4b5563; margin-left: 4px; }
    /* 扫描中状态 — 青色（区别于running的脉冲动画） */
    .stage-item.scanning { background: rgba(0,212,255,0.08); border-color: rgba(0,212,255,0.5); color: var(--primary); }
    .stage-item.scanning .s-dot { background: var(--primary); animation: none; }
    .stage-item.scanning span:not(.s-dot)::after { content: ' · 扫描中'; font-size: 10px; color: var(--primary); margin-left: 2px; }
    @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(1.4)} }

    /* 引擎分数条 */
    .engine-scores { display: flex; flex-direction: column; gap: 6px; }
    .es-row { display: flex; align-items: center; gap: 10px; }
    .es-label { font-size: 12px; color: var(--text-muted); min-width: 60px; }
    .es-bar-bg { flex: 1; height: 5px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; }
    .es-bar { height: 100%; border-radius: 3px; transition: width .4s; }
    .es-bar.es-qvm { background: linear-gradient(90deg, #00d4ff, #0090b8); }
    .es-bar.es-qex { background: linear-gradient(90deg, #a855f7, #7c3aed); }
    .es-bar.es-rev { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .es-bar.es-yara { background: linear-gradient(90deg, #f59e0b, #ef4444); }
    .es-bar.es-ai { background: linear-gradient(90deg, #a855f7, #ec4899); }
    /* AI 引擎开关锁 - 简化版，不依赖复杂CSS */
    .esw-ai { border: 1px solid rgba(168,85,247,0.25); background: rgba(168,85,247,0.06); }
    .esw-ai .toggle-switch input:disabled + .toggle-slider { opacity: 0.6; cursor: not-allowed; }
    /* 密码弹窗 - 纯内联样式驱动，此处不定义类 */
    .pwd-input { width: 100%; padding: 10px 14px; font-size: 14px; border: 1px solid rgba(168,85,247,0.3); background: rgba(0,0,0,0.3); color: var(--text-light); border-radius: 8px; outline: none; margin-bottom: 14px; transition: border .2s; }
    .pwd-input:focus { border-color: #a855f7; box-shadow: 0 0 10px rgba(168,85,247,0.3); }
    .pwd-actions { display: flex; gap: 10px; justify-content: center; }
    .pwd-btn-confirm { background: linear-gradient(135deg, #a855f7, #7c3aed); color: #fff; padding: 9px 24px; border-radius: 8px; border: none; cursor: pointer; font-size: 13px; font-weight: 600; }
    .pwd-btn-cancel { background: #374151; color: var(--text-light); padding: 9px 24px; border-radius: 8px; border: none; cursor: pointer; font-size: 13px; }
    .pwd-error { color: #ef4444; font-size: 12px; margin-top: 8px; min-height: 18px; }
    /* 引擎关闭时分数条变灰 */
    .es-bar.es-disabled { background: rgba(255,255,255,0.06) !important; }
    .es-row.disabled .es-label { color: #4b5563 !important; }
    .es-row.disabled .es-val { color: #4b5563 !important; }
    .es-val { font-size: 12px; color: var(--text-light); min-width: 28px; text-align: right; font-weight: 600; }

    /* 修复弹窗 */
    .repair-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9998; align-items: center; justify-content: center; }
    .repair-overlay.show { display: flex; }
    .repair-dialog { background: var(--bg-card); border: 2px solid #f59e0b; border-radius: 16px; padding: 24px; max-width: 420px; width: 90%; }
    .repair-dialog h3 { color: #f59e0b; font-size: 16px; margin-bottom: 10px; }
    .repair-dialog .r-msg { color: var(--text-muted); font-size: 12px; line-height: 1.6; margin-bottom: 12px; }
    .repair-dialog .r-progress { display: flex; align-items: center; gap: 8px; }
    .r-spinner { width: 18px; height: 18px; border: 2px solid #f59e0b44; border-top-color: #f59e0b; border-radius: 50%; animation: spin .8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* 错误弹窗 */
    .error-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; }
    .error-overlay.show { display: flex; }
    .error-dialog { background: var(--bg-card); border: 2px solid #ef4444; border-radius: 16px; padding: 28px; max-width: 480px; width: 90%; }
