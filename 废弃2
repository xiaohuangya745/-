      // 但 analyzeFile 是同步函数，无法直接 await
      // 所以这里用 aiScanSync 做本地兜底，云端结果由 startScan 流程单独获取
      if(typeof aiScanSync==='function'){ ai=aiScanSync(fileInfo); }
      else if(typeof _aiScan==='function'){ ai=_aiScan(fileInfo); }
    }catch(ae){ console.error('[AI] 异常:'+ae.message); }
    result.aiScore=ai.score||0;
    if(ai.flags) for(var aiI=0;aiI<ai.flags.length;aiI++){ result.flags.push(ai.flags[aiI]); }
