        var rev=scoreReverse(pe);
        score+=rev.score*0.3;
        for(var fi=0;fi<rev.matched.length;fi++){ if(flags.indexOf(rev.matched[fi])===-1) flags.push(rev.matched[fi]); }
        // PE 导入表深度检查（QVM增强）
