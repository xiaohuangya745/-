    // QEX
    var qex=_qexScan(fileInfo, {aggressive:aggressive, proMode:aggressive});
    result.qexScore=qex.score||0;
    if(qex.events) for(var qi=0;qi<qex.events.length;qi++){ result.flags.push('[QEX] '+qex.events[qi].desc); }
