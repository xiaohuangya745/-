<script>
/* YB Sandbox v4.7 → v3.7 适配层（桥接原有交互逻辑）*/
/**
 * YB Sandbox v4.7 → v3.7 适配层
 * 
 * 原有交互逻辑调用方式：
 *   YBSandbox.analyze(file, { aggressive }) → {log, findings, level, qvmScore, qvmHits}
 *   YBSandbox.getExclusions()
 *   YBSandbox.addExclusion(type, value)
 *   YBSandbox.removeExclusion(index)
 *   YBSandbox.formatSize(bytes)
 *
 * v4.7 引擎提供：
 *   YBSandbox.analyzeFile(fileInfo) → {score, qvmScore, qexScore, reverseScore, level, flags, engines, confidence}
 *   YBSandbox.scoreFile(fileInfo) → {score, flags, level, details}
 *   YBSandbox.qexScan(fileInfo) → {score, events, riskLevel}
 *   YBSandbox.getExt(name)
 *   YBSandbox.formatSize(bytes)
 *
 * 适配层负责：File → fileInfo 转换、API 签名适配、排除项管理
 */
(function(global) {
    'use strict';

    // ===== 安全 localStorage 辅助函数（最先定义，解决 TDZ 问题）=====
    var _storage = {}; // 内存后备存储
    function safeGetLS(key, def) {
        try { var v = localStorage.getItem(key); return v === null ? def : v; } catch(e) { return _storage[key] || def; }
    }
    function safeSetLS(key, val) {
        try { localStorage.setItem(key, val); } catch(e) { _storage[key] = val; }
    }
    // 暴露到全局
    window.safeGetLS = safeGetLS;
    window.safeSetLS = safeSetLS;
    // 初始化 safeStorage
    var safeStorage = {
      getItem: function(k){ try{ return safeGetLS(k); }catch(e){ return _storage[k]||null; } },
      setItem: function(k,v){ try{ safeSetLS(k,v); }catch(e){ _storage[k]=v; } },
      removeItem: function(k){ try{ safeSetLS(k,null); }catch(e){ delete _storage[k]; } }
    };

    // ===== 日志函数 =====
    function log(msg, type){ try{ var el=document.getElementById('logArea'); if(!el) return; var d=document.createElement('div'); d.className='log-line'+(type?' '+type:''); var t=new Date().toTimeString().slice(0,8); d.textContent='['+t+'] '+msg; el.appendChild(d); el.scrollTop=el.scrollHeight; }catch(e){ console.log('[YB]',msg); } }

    // ===== 排除项管理（原版 v3.7 有此功能） =====
    var exclusions = JSON.parse(safeGetLS('yb_exclusions', '[]'));

    function saveExclusions() {
        safeSetLS('yb_exclusions', JSON.stringify(exclusions));
    }

    global.YBSandbox.getExclusions = function() {
        return exclusions.slice();
    };

    global.YBSandbox.addExclusion = function(type, value) {
        exclusions.push({ type: type, value: value.toLowerCase(), addedAt: Date.now() });
        saveExclusions();
    };

    global.YBSandbox.removeExclusion = function(index) {
        if (index >= 0 && index < exclusions.length) {
            exclusions.splice(index, 1);
            saveExclusions();
        }
    };

    // ===== 排除项匹配 =====
    function isExcluded(file) {
        var name = (file.name || '').toLowerCase();
        var path = (file.webkitRelativePath || file.name || '').toLowerCase();
        for (var i = 0; i < exclusions.length; i++) {
            var ex = exclusions[i];
            if (ex.type === 'name' && name === ex.value) return true;
            if (ex.type === 'ext') {
                var ext = name.lastIndexOf('.') >= 0 ? name.slice(name.lastIndexOf('.')) : '';
                if (ext === ex.value) return true;
            }
            if (ex.type === 'path') {
                if (path.indexOf(ex.value) === 0) return true;
            }
        }
        return false;
    }

    // ===== File → fileInfo 转换（带缓存） =====
    var fileInfoCache = new Map();

    function fileToInfo(file) {
        if (fileInfoCache.has(file)) return fileInfoCache.get(file);
        var info = { name: file.name, size: file.size, data: new Uint8Array(0) };
        fileInfoCache.set(file, info);
        return info;
    }

    // 读取文件数据（异步）
    function readFileData(file) {
        return new Promise(function(resolve, reject) {
            try {
                var reader = new FileReader();
                reader.onload = function(e) {
                    resolve(new Uint8Array(e.target.result));
                };
                reader.onerror = function() {
                    resolve(new Uint8Array(0));
                };
                reader.readAsArrayBuffer(file);
            } catch(e) {
                resolve(new Uint8Array(0));
            }
        });
    }

    // ===== 核心适配：analyze(file, options) → v3.7 格式结果 =====
    // 完整四引擎：QVM + QEX + REV + AI → 融合评分
    global.YBSandbox.analyze = async function(file, options) {
        options = options || {};
        var aggressive = options.aggressive || false;

        // 检查排除项
        if (isExcluded(file)) {
            return {
                log: [{ type: 'info', msg: '✅ ' + file.name + ' 在排除项中，跳过扫描' }],
                findings: [],
                level: 'info',
                qvmScore: 0,
                qvmHits: [],
                _engines: { qvm: 0, qex: 0, rev: 0, fused: 0 }
            };
        }

        // 引擎故障自动修复
        if (global.YBAutoRepair && typeof global.YBAutoRepair.verifyEngine === 'function') {
            var verify = global.YBAutoRepair.verifyEngine();
            if (!verify.healthy && typeof global.YBAutoRepair.autoRepair === 'function') {
                log('⚠️ 引擎缺失 (' + verify.missing.join(',') + ')，自动修复中...', 'warn');
                global.YBAutoRepair.autoRepair();
            }
        }

        // 读取文件数据
        var buf = await readFileData(file);
        var info = { name: file.name, size: file.size, data: buf };

        // 调用 v4.7 四引擎
        var result = { log: [], findings: [], level: 'info', qvmScore: 0, qvmHits: [], _engines: { qvm: 0, qex: 0, rev: 0, yara: 0, ai: 0, fused: 0 } };

        try {
            // 读取引擎开关状态（与 UI 层 engineState 双向同步）
            var engState = { qvm: true, qex: true, rev: true, yara: true, ai: true };
            try {
                var savedState = JSON.parse(safeGetLS('yb_engines', '{}'));
                // 优先用 window.engineState（UI层实时状态），其次 localStorage
                var uiState = (window.engineState && typeof window.engineState === 'object') ? window.engineState : null;
                engState = Object.assign(engState, savedState, uiState || {});
            } catch(e) {}

            // ===== QVM 评分（可关闭）=====
            var qvmResult = { score: 0, flags: [], level: 'safe' };
            if (engState.qvm !== false && (global.YBSandbox.scoreFile || global.scoreFile)) {
                var _scoreFileFn = global.YBSandbox.scoreFile || global.scoreFile;
                qvmResult = _scoreFileFn(info, { aggressive: aggressive });
            } else {
                result.log.push({ type: 'info', msg: '🧠 QVM: 已关闭，跳过' });
            }
            result._engines.qvm = qvmResult.score || 0;
            // 确保 level 正确映射
            if (qvmResult.score >= 70) qvmResult.level = 'critical';
            else if (qvmResult.score >= 45) qvmResult.level = 'high';
            else if (qvmResult.score >= 25) qvmResult.level = 'medium';
            else if (qvmResult.score >= 10) qvmResult.level = 'low';
            else qvmResult.level = 'safe';

            // 转换 QVM flags → findings
            if (qvmResult.flags && qvmResult.flags.length) {
                for (var fi = 0; fi < qvmResult.flags.length; fi++) {
                    result.findings.push({
                        name: qvmResult.flags[fi],
                        desc: qvmResult.flags[fi],
                        risk: qvmResult.level === 'high' || qvmResult.level === 'critical' ? 'high' : (qvmResult.level === 'medium' ? 'medium' : 'low'),
                        engine: 'QVM'
                    });
                }
            }

            // ===== QEX 脚本查杀（可关闭）=====
            var qexResult = { score: 0, events: [] };
            var _qexFn = global.YBSandbox.qexScan || global.qexScan;
            if (engState.qex !== false && _qexFn) {
                qexResult = _qexFn(info, { aggressive: aggressive });
            } else {
                result.log.push({ type: 'info', msg: '📜 QEX: 已关闭，跳过' });
            }
            result._engines.qex = qexResult.score || 0;
            if (qexResult.events && qexResult.events.length) {
                for (var qi = 0; qi < qexResult.events.length; qi++) {
                    var ev = qexResult.events[qi];
                    result.findings.push({
                        name: ev.desc || ev.rule || 'QEX',
                        desc: ev.desc || '',
                        risk: ev.score >= 20 ? 'high' : (ev.score >= 10 ? 'medium' : 'low'),
                        engine: 'QEX'
                    });
                }
            }

            // ===== REV 逆向扫描（可关闭，仅 PE 文件）=====
            var revResult = { score: 0, valid: false };
            try {
                var ext = (file.name || '').toLowerCase().slice((file.name||'').lastIndexOf('.'));
                var isPe = ext === '.exe' || ext === '.dll' || ext === '.sys' || ext === '.scr' || ext === '.ocx' || ext === '.drv';
                if (engState.rev !== false && isPe && (global.YBSandbox.reverseScan || global.reverseScan)) {
                    var _revFn = global.YBSandbox.reverseScan || global.reverseScan;
                    revResult = _revFn(info);
                    result._engines.rev = revResult.score || 0;
                    if (revResult.flags && revResult.flags.length) {
                        for (var ri = 0; ri < revResult.flags.length; ri++) {
                            result.findings.push({
                                name: revResult.flags[ri],
                                desc: revResult.flags[ri],
                                risk: 'high',
                                engine: 'REV'
                            });
                        }
                    }
                    if (revResult.matched && revResult.matched.length) {
                        for (var mi = 0; mi < revResult.matched.length; mi++) {
                            result.log.push({ type: 'info', msg: '🔬 REV: ' + revResult.matched[mi] });
                        }
                    }
                } else if (engState.rev === false) {
                    result.log.push({ type: 'info', msg: '🔬 REV: 已关闭，跳过' });
                }
            } catch(revErr) {
                log('  REV 跳过: ' + revErr.message, 'warn');
            }

            // ===== GLM-5.2 引擎（始终运行，不可关闭）=====
            var aiResult = { score: 0, flags: [], confidence: 85 };
            try {
                var _aiFn = global.aiScan || global.YBSandbox && global.YBSandbox.aiScan;
                if (typeof _aiFn === 'function') {
                    aiResult = _aiFn(info, { aggressive: aggressive });
                }
                result._engines.ai = aiResult.score || 0;
                if (aiResult.flags && aiResult.flags.length) {
                    for (var aiFi = 0; aiFi < aiResult.flags.length; aiFi++) {
                        result.findings.push({
                            name: aiResult.flags[aiFi],
                            desc: aiResult.flags[aiFi],
                            risk: (aiResult.score >= 20) ? 'high' : ((aiResult.score >= 10) ? 'medium' : 'low'),
                            engine: 'AI'
                        });
                        result.log.push({ type: 'info', msg: '🧠 GLM-5.2: ' + aiResult.flags[aiFi] });
                    }
                }
                result.log.push({ type: 'info', msg: '🧠 GLM-5.2: 评分 ' + (aiResult.score||0) + ' (置信度 ' + (aiResult.confidence||85) + '%)' });
            } catch(aiErr) {
                log('  AI 跳过: ' + aiErr.message, 'warn');
                result._engines.ai = 0;
            }

            
            // ===== YARA 规则引擎扫描（可关闭）=====
            var yaraResult = { score: 0, matches: [], severityCounts: {low:0,medium:0,high:0,critical:0} };
            var _yaraFn = global.yaraScan || global.YBSandbox && global.YBSandbox.yaraScan;
            try {
                if (engState.yara !== false && typeof _yaraFn === 'function') {
                    yaraResult = _yaraFn(info, { aggressive: aggressive });
                    result._engines.yara = yaraResult.score || 0;
                    if (yaraResult.matches && yaraResult.matches.length) {
                        for (var yri = 0; yri < yaraResult.matches.length; yri++) {
                            var ym = yaraResult.matches[yri];
                            result.findings.push({
                                name: ym.name || ym.rule || 'YARA',
                                desc: (ym.name || ym.rule) + ' (' + ym.score + '分)',
                                risk: ym.severity === 'high' || ym.severity === 'critical' ? 'high' : (ym.severity === 'medium' ? 'medium' : 'low'),
                                engine: 'yara'
                            });
                            result.log.push({ type: 'info', msg: '🏷️ YARA: ' + (ym.name||ym.rule) + ' [+' + ym.score + ']' });
                        }
                    }
                    result.log.push({ type: 'info', msg: '🏷️ YARA: 评分 ' + (yaraResult.score||0) + ' (' + (yaraResult.matches?yaraResult.matches.length:0) + ' 条规则命中)' });
                } else {
                    result.log.push({ type: 'info', msg: '🏷️ YARA: 已关闭，跳过' });
                    result._engines.yara = 0;
                }
            } catch(yaraErr) {
                log('  YARA 跳过: ' + yaraErr.message, 'warn');
                result._engines.yara = 0;
            }

// ===== 融合评分（QVM+QEX+REV+YARA+AI 五引擎加权）=====
            var wQVM = (engState.qvm !== false) ? 1 : 0;
            var wQEX = (engState.qex !== false) ? 1 : 0;
            var wREV = (engState.rev !== false && result._engines.rev > 0) ? 1 : 0;
            var wYARA = (engState.yara !== false && result._engines.yara > 0) ? 1 : 0;
            var wAI = 1; // AI 始终参与
            var totalW = wQVM + wQEX + wREV + wYARA + wAI;
            if (totalW === 0) totalW = 1;
            // 修复：整个分子包在括号内再除 totalW
            var fused = Math.round(((result._engines.qvm * wQVM) + (result._engines.qex * wQEX) + (result._engines.rev * wREV) + ((result._engines.yara||0) * wYARA) + ((aiResult.score||0) * wAI)) / totalW);
            if (fused > 100) fused = 100;
            result._engines.fused = fused;
            result.qvmScore = fused;

            // 映射 level
            if (fused >= 60) result.level = 'high';
            else if (fused >= 35) result.level = 'medium';
            else if (fused >= 15) result.level = 'low';
            else result.level = 'info';

            // 强力模式：强度升级 +30%（阈值降低30%，权重×1.3，新增高敏规则集）
            if (aggressive) {
                // 阈值降低30%（更敏感）
                // 原: ≥15 low / ≥35 medium / ≥60 high
                // 新: ≥10 low / ≥24 medium / ≥42 high
                var fusedPro = result.qvmScore;
                // 权重×1.3
                fusedPro = Math.round(fusedPro * 1.3);
                if (fusedPro > 100) fusedPro = 100;
                result.qvmScore = fusedPro;
                result._engines.fused = fusedPro;

                // 重新映射等级（阈值降低30%）
                if (fusedPro >= 42) result.level = 'high';
                else if (fusedPro >= 24) result.level = 'medium';
                else if (fusedPro >= 10) result.level = 'low';
                else result.level = 'info';

                // 强力模式额外加分（保留兼容）
                result.qvmScore = Math.min(100, result.qvmScore + 10);
                if (result.qvmScore >= 42 && result.level === 'info') result.level = 'low';
                if (result.qvmScore >= 60 && result.level !== 'high') result.level = 'high';

                result.log.push({ type: 'warn', msg: '⚡ 强力模式激活：阈值降低30%，规则权重×1.3，新增高敏规则集 (QVM+QEX+REV+YARA+AI)' });
            // YARA 强力模式：额外规则加权
            if (result._engines.yara > 0) {
                result._engines.yara = Math.round(result._engines.yara * 1.3);
                if (result._engines.yara > 100) result._engines.yara = 100;
            }
            }

            // qvmHits
            result.qvmHits = result.findings.slice(0, 5).map(function(f) {
                return { name: '[' + (f.engine||'?') + '] ' + f.name, weight: f.risk === 'high' ? 10 : (f.risk === 'medium' ? 5 : 2) };
            });

            // 日志（标注关闭的引擎）
            var engStatus = '🧠 QVM:' + (wQVM?'ON':'OFF') + ' 📜 QEX:' + (wQEX?'ON':'OFF') + ' 🔬 REV:' + (wREV?'ON':'OFF') + ' 🏷️ YARA:' + (wYARA?'ON':'OFF');
            result.log.push({ type: 'info', msg: engStatus + ' → 融合: ' + fused + ' | 等级: ' + result.level });

        } catch (e) {
            // 异常时尝试修复后重试一次
            console.error('❌ 扫描异常: ' + e.message + '，尝试自动修复...');
            if (global.YBAutoRepair && global.YBAutoRepair.autoRepair) {
                global.YBAutoRepair.autoRepair();
            }
            result.log.push({ type: 'finding', level: 'medium', msg: '❌ 扫描异常: ' + e.message });
            result.level = 'medium';
        }

        return result;
    };

    // ===== 确保 formatSize 存在 =====
    if (typeof global.YBSandbox.formatSize !== 'function') {
        global.YBSandbox.formatSize = function(b) {
            if (b < 1024) return b + ' B';
            if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
            return (b / 1048576).toFixed(1) + ' MB';
        };
    }

    console.log('%c[YB Adapter v4.7→v3.7] 适配层就绪 ✓', 'color:#10b981;font-weight:bold;');

    // 暴露关键函数到全局
    try { global.readFileData = readFileData; } catch(e) {}
    try { window.readFileData = readFileData; } catch(e) {}

})(window);

