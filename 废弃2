function qexScan(fileInfo, options){
  var result={score:0,events:[],riskLevel:'safe',desc:''};
  try{
    var buf=fileInfo.data; if(!buf) return result;
    var ext=getExt(fileInfo.name);
    var isScript=ext==='.ps1'||ext==='.js'||ext==='.vbs'||ext==='.bat'||ext==='.cmd'||ext==='.wsf'||ext==='.hta'||ext==='.wsh';
    if(!isScript&&ext!=='.exe'&&ext!=='.dll') return result;
    var content=bufToStr(buf.slice(0,Math.min(buf.length,1048576)));
    if(!content) return result;
    // 尝试解压常见混淆
    var decompressed=content;
    if(content.indexOf('GZIP:')===0||content.indexOf('BZIP2:')===0||content.indexOf('LZMA:')===0){
      // 标记但不过度处理
      result.events.push({rule:'COMPRESSED',score:5,desc:'检测到压缩/编码脚本内容'});
      result.score+=5;
    }
    for(var i=0;i<QEX_RULES.length;i++){
      var rule=QEX_RULES[i];
      var matches=decompressed.match(rule.pat);
      if(matches){
        var cnt=rule.isGlobal?Math.min(matches.length,10):1;
        var add=rule.sc*cnt;
        result.score+=add;
        result.events.push({rule:rule.id,score:add,desc:rule.desc+(rule.isGlobal?' x'+cnt:'')});
      }
    }
    // PowerShell 深度检测
    if(ext==='.ps1'||content.toLowerCase().indexOf('powershell')>=0){
      var encMatch=content.match(/-enc(?:odedcommand)?\s+([A-Za-z0-9+\/=]{20,})/i);
      if(encMatch){
        result.score+=20;
        result.events.push({rule:'PS_ENCODED_DEEP',score:20,desc:'PowerShell深度编码命令'});
        // 尝试解码
        try{
          var decB64=atob(encMatch[1]);
          var decText=bufToStr(new Uint8Array(decB64.split('').map(function(c){return c.charCodeAt(0);})));
          for(var j=0;j<QEX_RULES.length;j++){
            if(QEX_RULES[j].pat.test(decText)){ result.score+=5; result.events.push({rule:'PS_DECODED_'+QEX_RULES[j].id,score:5,desc:'解码后匹配: '+QEX_RULES[j].desc}); }
          }
        }catch(e){ /* ignore */ }
      }
    }
    // ===== 强力模式：QEX +30% 强度 =====
    if(options&&options.proMode){
      // 权重×1.3
      result.score=Math.round(result.score*1.3);
      // 额外高敏 QEX 规则
      var proQexRules=[
        {pat:/Get-Clipboard|Set-Clipboard/i,sc:8,desc:'剪贴板操作'},
        {pat:/Add-Type\s+-TypeDefinition/i,sc:12,desc:'Add-Type动态编译'},
        {pat:/New-Object\s+Net\.Socket/i,sc:10,desc:'Net.Socket网络连接'},
        {pat:/Start-Process.*-Verb\s+runas/i,sc:14,desc:'提权启动进程'},
