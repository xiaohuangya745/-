      var sect={name:sname.trim(),virtualSize:ssize,rawSize:srawsz,entropy:sectEntropy.toFixed(2),RWX:isRWX,exec:exec,write:write,read:read};
      r.sections.push(sect);
      if(isRWX){ r.flags.push('RWX section: '+sname.trim()); r.riskScore+=15; }
      if(sectEntropy>7.5){ r.flags.push('High entropy section: '+sname.trim()+' ('+sectEntropy.toFixed(2)+')'); r.riskScore+=10; }
    }
    // 导入表
    var impRva=dv.getUint32(optHdrOff+104,true);
    if(impRva>0&&numRva>=2){
      // 简化：只解析第一个导入描述符
      var impOff=impRva;
      // 需要节映射，简化处理
      for(var d=0;d<64;d++){
        var descOff=impOff+d*20;
        if(descOff+16>=buf.length) break;
        var iltRva=dv.getUint32(descOff,true);
        var dllNameRva=dv.getUint32(descOff+12,true);
        if(iltRva===0||dllNameRva===0) break;
        // 读DLL名
        var dllName=''; for(var di=dllNameRva;di<buf.length&&di<dllNameRva+64;di++){ var dc=buf[di]; if(dc===0) break; if(dc>=32) dllName+=String.fromCharCode(dc); }
        if(dllName){
          r.importsList.push(dllName);
          // 读IAT
          var apiList=[];
          var is64=magic===0x20b;
          var entrySize=is64?8:4;
          for(var ai=0;ai<128;ai++){
            var aeOff=iltRva+ai*entrySize;
            if(aeOff+entrySize>buf.length) break;
            var apiRva=is64?dv.getUint32(aeOff,true):dv.getUint32(aeOff,true);
            if(apiRva===0) break;
            if(apiRva>buf.length) continue;
            var apiName=''; for(var api=apiRva;api<buf.length&&api<apiRva+64;api++){ var ac=buf[api]; if(ac===0) break; if(ac>=32) apiName+=String.fromCharCode(ac); }
            if(apiName&&apiName.length<64){ r.apis.push(dllName.toLowerCase()+'.'+apiName); apiList.push(apiName); }
          }
        }
      }
    }
  }catch(e){ r.valid=false; r.error=e.message; }
  return r;
}

