    var yaraR={score:0,matches:[]};
    try{ if(typeof _yaraScan==='function'){ yaraR=_yaraScan(fileInfo, {aggressive:aggressive}); } }catch(ye){ console.error('[YARA] 异常:'+ye.message); }
