}

// ===== 文件读取（带超时保护） =====
function readFileSafe(file,timeoutMs){
  timeoutMs=timeoutMs||30000;
  return new Promise(function(resolve,reject){
    var done=false;
    var timer=setTimeout(function(){ if(!done){ done=true; reject(new Error('文件读取超时: '+file.name)); } },timeoutMs);
    try{
      var reader=new FileReader();
      reader.onload=function(e){ if(!done){ done=true; clearTimeout(timer); resolve(new Uint8Array(e.target.result)); } };
      reader.onerror=function(){ if(!done){ done=true; clearTimeout(timer); reject(new Error('FileReader错误: '+file.name)); } };
      reader.readAsArrayBuffer(file);
    }catch(e){ if(!done){ done=true; clearTimeout(timer); reject(e); } }
  });
}

