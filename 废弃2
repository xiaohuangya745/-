(function(){
    try { safeGetLS('__test__'); }
    catch(e) {
        console.warn('[YB] localStorage unavailable, using memory fallback');
        var mem = {};
        window.localStorage = {
            getItem: function(k){ return mem[k] !== undefined ? mem[k] : null; },
            setItem: function(k,v){ mem[k] = String(v); },
            removeItem: function(k){ delete mem[k]; },
            clear: function(){ mem = {}; },
            get length(){ return Object.keys(mem).length; },
            key: function(i){ return Object.keys(mem)[i] || null; }
        };
    }
    // 全局安全包装（即使原生可用也提供 try-catch 版本）
    window.safeGetLS = function(key, def) {
        try { var v = localStorage.getItem(key); return v === null ? def : v; }
        catch(e) { return def; }
    };
    window.safeSetLS = function(key, val) {
        try { localStorage.setItem(key, val); } catch(e) {}
    };
    console.log('%c[YB] Storage ready ✓', 'color:#10b981');
})();
