            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 25px;
            padding: 10px 22px;
            border-radius: 10px;
            border: 1px solid rgba(0, 212, 255, 0.15);
            background: rgba(0, 212, 255, 0.04);
            color: var(--text-muted);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
