        {pat:/Unrestricted|ByPass/i,sc:6,desc:'无限制执行策略'},
        {pat:/Invoke-WebRequest|iwr\s+/i,sc:8,desc:'Web请求下载'},
        {pat:/ConvertTo-Shellcode|msfvenom|Metasploit/i,sc:20,desc:'Shellcode/Metasploit'},
        {pat:/CreateObject\s*\(\s*["']WScript/i,sc:10,desc:'WScript创建对象'},
        {pat:/RegWrite|RegDelete/i,sc:8,desc:'注册表写入/删除'},
        {pat:/appdata\\roaming|%temp%|tmp%/i,sc:4,desc:'敏感目录引用'},
        {pat:/firewall\s+cx|cx\s+firewall|netsh\s+advfirewall/i,sc:10,desc:'防火墙操作'}
      ];
      for(var pq=0;pq<proQexRules.length;pq++){
        if(proQexRules[pq].pat.test(content)){
          result.score+=proQexRules[pq].sc;
          result.events.push({rule:'PRO_'+pq,score:proQexRules[pq].sc,desc:'[强力]'+proQexRules[pq].desc});
        }
      }
      // 强力模式：阈值降低30%
      result.events.push({rule:'PRO_MODE',score:0,desc:'⚡ 强力模式：QEX权重×1.3，阈值降低30%'});
    }
  }catch(e){
    log('QEX 异常: '+e.message,'err');
  }
  if(result.score>100) result.score=100;
  // 强力模式：阈值降低30%
  if(options&&options.proMode){
    if(result.score>=42) result.riskLevel='critical';
    else if(result.score>=24) result.riskLevel='high';
    else if(result.score>=14) result.riskLevel='medium';
    else if(result.score>=6) result.riskLevel='low';
  }else{
    if(result.score>=70) result.riskLevel='critical';
    else if(result.score>=45) result.riskLevel='high';
    else if(result.score>=25) result.riskLevel='medium';
    else if(result.score>=10) result.riskLevel='low';
  }
  return result;
}

// ===== 逆向扫描接口 =====
function reverseScan(fileInfo){
  var result={score:0,apis:[],sections:[],flags:[],valid:false,matched:[]};
  try{
    var buf=fileInfo.data; if(!buf) return result;
    var magic=detectMagic(buf);
    if(magic.type!=='pe'){ result.desc='非PE文件，跳过逆向扫描'; return result; }
    var pe=parsePE(buf);
    if(!pe.valid){ result.desc='PE解析失败'; return result; }
    result.valid=true;
    var sr=scoreReverse(pe);
    result.score=sr.score; result.apis=pe.apis; result.sections=pe.sections; result.flags=pe.flags; result.matched=sr.matched;
  }catch(e){
    log('REV 异常: '+e.message,'err');
    result.error=e.message;
  }
  return result;
}

