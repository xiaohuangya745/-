        .score-ring .ring-label {
            font-size: 14px;
            color: var(--text-muted);
        }

        .score-details {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(0, 212, 255, 0.1);
        }

        .score-details h3 {
            margin-bottom: 20px;
            color: var(--primary);
        }

        .score-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }

        .score-row:last-child {
            border-bottom: none;
        }

        .score-row .diff-label {
            font-size: 14px;
            font-weight: 600;
        }

        .score-row .diff-score {
            font-size: 18px;
            font-weight: 700;
        }

        .score-comment {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 30px;
            border: 1px solid rgba(0, 212, 255, 0.1);
            text-align: center;
        }

        .score-comment .comment-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .score-comment .comment-text {
            font-size: 18px;
            line-height: 1.8;
            color: var(--text-light);
        }

        .score-comment .comment-suggestion {
            margin-top: 15px;
            padding: 15px;
            background: rgba(0, 212, 255, 0.05);
            border-radius: 10px;
            font-size: 14px;
            color: var(--text-muted);
            text-align: left;
        }

        /* ===== 歇后语 ===== */
        .xiehouyu-container {
            max-width: 700px;
            margin: 0 auto;
            text-align: center;
        }

        .xiehouyu-card {
            background: var(--bg-card);
            border: 2px solid rgba(0, 212, 255, 0.15);
            border-radius: 20px;
            padding: 50px 40px;
            margin-bottom: 30px;
