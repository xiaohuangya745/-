        .practice-back-btn {
            display: inline-block;
            margin: 10px;
            padding: 10px 24px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
            background: var(--bg-card);
            color: var(--text-muted);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .practice-back-btn:hover {
            color: var(--primary);
            border-color: var(--primary);
        }

