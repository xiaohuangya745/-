// ===== JWT Token 生成（纯 JS 实现，无需外部库）=====
// 智谱 AI 的 id.secret 格式 Key 需要转为 JWT Token 才能调用 API
// secret 是 HMAC-SHA256 密钥，id 放入 payload.api_key
function base64UrlEncode(input) {
    var str = (input instanceof Uint8Array) ? 
        Array.from(input, function(b) { return String.fromCharCode(b); }).join('') : String(input);
    var b64 = btoa(str);
    return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

// 检查 crypto.subtle 是否可用（file:// 协议下可能不可用）
function isCryptoAvailable() {
    return !!(window.crypto && window.crypto.subtle && typeof window.crypto.subtle.sign === 'function');
}

async function generateGlmJwt(apiKey, expSeconds) {
    expSeconds = expSeconds || 3600;
    var parts = apiKey.split('.');
    if (parts.length !== 2) {
        // 不是 id.secret 格式，可能已经是 JWT 或 sk- 格式，直接返回
        return apiKey;
    }
    var id = parts[0];
    var secret = parts[1];
    
    var header = { alg: 'HS256', sign_type: 'SIGN' };
    var nowMs = Date.now();
    var payload = {
        api_key: id,
        exp: nowMs + expSeconds * 1000,
        timestamp: nowMs
    };
    
    var headerB64 = base64UrlEncode(JSON.stringify(header));
    var payloadB64 = base64UrlEncode(JSON.stringify(payload));
    var dataToSign = headerB64 + '.' + payloadB64;
    
    // 使用 Web Crypto API 做 HMAC-SHA256
    if (!isCryptoAvailable()) {
        console.warn('[GLM-5.2] Web Crypto API 不可用（可能因为是 file:// 协议），尝试直接发送原始 Key');
        // 部分智谱 API 版本支持直接用 id.secret 格式
        return apiKey;
    }
    
    try {
        var enc = new TextEncoder();
        var keyData = enc.encode(secret);
        var msgData = enc.encode(dataToSign);
        var cryptoKey = await crypto.subtle.importKey(
            'raw', keyData, { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']
        );
        var sigBuf = await crypto.subtle.sign('HMAC', cryptoKey, msgData);
        var sigBytes = new Uint8Array(sigBuf);
        var sigB64 = base64UrlEncode(sigBytes);
        var token = dataToSign + '.' + sigB64;
        console.log('[GLM-5.2] ✅ JWT Token 生成成功（长度:' + token.length + '）');
        return token;
    } catch(e) {
        console.error('[GLM-5.2] JWT 生成失败:', e.message, '→ 使用原始 Key');
        return apiKey;
    }
}

// ===== 本地启发式降级引擎（GLM 不可用时的后备）=====
function aiScanLocal(fileInfo, options) {
    options = options || {};
    var score = 0;
    var flags = [];
    var confidence = 70;
    var fname = (fileInfo.name || '').toLowerCase();
    var ext = fname.slice(fname.lastIndexOf('.'));
    var data = fileInfo.data;
    var content = '';
    if (data) {
        try {
            var uint8 = (data instanceof Uint8Array) ? data : new Uint8Array(data);
            var len = Math.min(uint8.length, 4096);
            var chars = [];
            for (var i = 0; i < len; i++) {
                var c = uint8[i];
                if (c >= 32 && c < 127) chars.push(String.fromCharCode(c));
                else chars.push(' ');
            }
            content = chars.join('');
        } catch(e) { content = ''; }
    }
    var highRiskExts = ['.exe','.dll','.scr','.com','.pif','.bat','.cmd','.ps1','.vbs','.js','.wsh','.wsf'];
    if (highRiskExts.indexOf(ext) !== -1) { score += 8; flags.push('[AI-本地] 高风险文件类型: ' + ext); }
    var suspiciousNames = [/crack/i,/keygen/i,/patch/i,/activator/i,/loader/i,/inject/i,/hook/i,/rootkit/i,/backdoor/i,/trojan/i,/worm/i,/rat_/i,/stealer/i,/cryptor/i];
    for (var si = 0; si < suspiciousNames.length; si++) {
        if (suspiciousNames[si].test(fname)) { score += 12; flags.push('[AI-本地] 文件名可疑: ' + suspiciousNames[si].source.replace(/[\/i]/g,'')); break; }
    }
    var aiPatterns = [
        { pat: /powershell.*-enc|-exec\s+bypass|iex\s*\(|downloadstring/i, sc: 18, desc: 'PS恶意执行' },
        { pat: /eval\s*\(|base64.*decode|frombase64string/i, sc: 15, desc: '代码混淆/解码' },
        { pat: /wmic.*process|taskkill.*\/f|net\s+user\s+\/add/i, sc: 16, desc: '系统提权/持久化' },
        { pat: /socket\.connect|http.*downloadfile|webclient.*download/i, sc: 14, desc: '远程下载执行' },
        { pat: /cryptoserviceprovider|rsaencrypt|aes.*cbc|ransom/i, sc: 20, desc: '勒索软件行为' },
        { pat: /getasynckeystate|setwindowshookex|keylog/i, sc: 18, desc: '键盘记录/窃密' },
        { pat: /virtualalloc.*write|createthread.*remote|dllmain/i, sc: 17, desc: '进程注入' },
        { pat: /mimikatz|sekurlsa|lsass.*dmp/i, sc: 19, desc: '凭证窃取' }
    ];
    for (var ai = 0; ai < aiPatterns.length; ai++) {
        if (aiPatterns[ai].pat.test(content)) {
            score += aiPatterns[ai].sc;
            flags.push('[AI-本地] ' + aiPatterns[ai].desc + ' (+' + aiPatterns[ai].sc + ')');
        }
    }
    if (data) {
        try {
            var uint8b = (data instanceof Uint8Array) ? data : new Uint8Array(data);
            var sampleLen = Math.min(uint8b.length, 8192);
            var freq = {};
            for (var fi = 0; fi < sampleLen; fi++) { var b = uint8b[fi]; freq[b] = (freq[b]||0)+1; }
            var ent = 0;
            for (var k in freq) { var p = freq[k]/sampleLen; if (p > 0) ent -= p * Math.log2(p); }
            if (ent > 7.8) { score += 14; flags.push('[AI-本地] 极高熵值 ' + ent.toFixed(2) + ' (疑似加密/加壳)'); }
            else if (ent > 7.2) { score += 8; flags.push('[AI-本地] 高熵值 ' + ent.toFixed(2)); }
        } catch(e) {}
    }
    if (flags.length === 0) confidence = 85;
    else if (flags.length >= 4) confidence = 90;
    var level = 'safe';
    if (score >= 50) level = 'critical';
    else if (score >= 30) level = 'high';
    else if (score >= 15) level = 'medium';
    else if (score >= 5) level = 'low';
    return { score: Math.min(score,100), flags: flags, confidence: confidence, level: level, engine: 'GLM-LocalFallback', modelVersion: 'local-v1.0', _fallback: true };
}

// ===== GLM-5.2 API 调用（核心·重写版）=====
// 修复清单：
//  1. id.secret → JWT Token（HMAC-SHA256，毫秒时间戳）
//  2. 请求体用 "thinking": {"type": "enabled"} 开启深度思考
//  3. 用流式响应读取，实时提取 delta.reasoning_content
//  4. 双端点自动切换（open.bigmodel.cn → api.z.ai）
//  5. 30 秒超时控制
//  6. 解析失败时文本兜底 + 本地降级
async function callGlmAPI(fileInfo, context) {
    var rawKey = getGlmApiKey();
    if (!rawKey) {
        console.warn('[GLM-5.2] 无API Key，使用本地降级');
        return aiScanLocal(fileInfo, {});
    }

    // ---- 1. 生成 JWT Token ----
    var token;
    try {
        token = await generateGlmJwt(rawKey, 3600);
    } catch(e) {
        console.warn('[GLM-5.2] JWT生成异常，使用原始Key:', e.message);
        token = rawKey;
    }
    // 如果 JWT 生成返回了未签名的 token（同步降级），尝试直接用原始 key
    if (token.indexOf('.unsigned') !== -1) {
        console.warn('[GLM-5.2] JWT 未签名，尝试直接使用原始 Key');
        token = rawKey;
    }

    // ---- 2. 构造文件信息摘要 ----
    var fileDesc = '';
    if (fileInfo.name) fileDesc += '文件名: ' + fileInfo.name + '\n';
    if (fileInfo.size) fileDesc += '文件大小: ' + fileInfo.size + ' 字节\n';

    var content = '';
    if (fileInfo.data) {
        try {
            var uint8 = (fileInfo.data instanceof Uint8Array) ? fileInfo.data : new Uint8Array(fileInfo.data);
            var clen = Math.min(uint8.length, 4096);
            var cchars = [];
            for (var ci = 0; ci < clen; ci++) {
                var cc = uint8[ci];
                if (cc >= 32 && cc < 127) cchars.push(String.fromCharCode(cc));
            }
            content = cchars.join('');
        } catch(e) { content = ''; }
    }
    if (content) fileDesc += '文件内容摘要:\n' + content.substring(0, 2000) + '\n';

    var prompt = '你是一个专业的恶意软件分析专家。请分析以下文件的安全威胁等级。\n\n' +
        fileDesc + '\n上下文: ' + (context || '标准扫描') +
        '\n\n请严格按照JSON格式返回，不要输出其他内容：\n{"score":0到100的整数, "level":"safe/low/medium/high/critical", "flags":["威胁特征1","威胁特征2"]}';

    var messages = [
        {role: 'system', content: '你是一个专业的恶意软件分析专家。请仔细分析用户提供的文件信息，判断其威胁等级。请严格只返回JSON格式结果，不要包含任何其他文字。'},
        {role: 'user', content: prompt}
    ];

    // ---- 3. 请求体（正确格式）----
    var body = JSON.stringify({
        model: GLM_MODEL,
        messages: messages,
        thinking: { type: 'enabled' },
        reasoning_effort: 'max',
        temperature: 0.3,
        max_tokens: 4096,
        stream: true
    });

    console.log('[GLM-5.2] 🚀 请求发送... 文件:' + (fileInfo.name||'unknown'));

    // ---- 4. 双端点 + 超时 ----
    var endpoints = [GLM_API_ENDPOINT, GLM_API_ENDPOINT_BACKUP];
    var lastError = null;

    for (var epIdx = 0; epIdx < endpoints.length; epIdx++) {
        var ep = endpoints[epIdx];
        try {
            console.log('[GLM-5.2] 尝试端点: ' + ep);

            var controller = new AbortController();
            var timeoutId = setTimeout(function() { controller.abort(); }, 30000);

            var resp = await fetch(ep, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: body,
                signal: controller.signal
            });
            clearTimeout(timeoutId);

            if (!resp.ok) {
                var errText = await resp.text().catch(function(){return '';});
                console.error('[GLM-5.2] HTTP ' + resp.status + ' ' + resp.statusText + ' | ' + errText.substring(0, 200));
                lastError = new Error('HTTP ' + resp.status + ': ' + errText.substring(0, 100));
                continue; // 尝试下一个端点
            }

            // ---- 5. 解析流式响应 ----
            var reasoning = '';
            var content_resp = '';
            var jsonStr = '';

            if (resp.body && typeof resp.body.getReader === 'function') {
                // 流式读取
                var reader = resp.body.getReader();
                var decoder = new TextDecoder('utf-8');
                var buffer = '';

                while (true) {
                    var r = await reader.read();
                    if (r.done) break;
                    buffer += decoder.decode(r.value, { stream: true });
                    var lines = buffer.split('\n');
                    buffer = lines.pop(); // 保留未完成的行

                    for (var li = 0; li < lines.length; li++) {
                        var line = lines[li].trim();
                        if (!line || line.indexOf('data:') !== 0) continue;
                        var dataStr = line.substring(5).trim();
                        if (dataStr === '[DONE]') continue;
                        try {
                            var chunk = JSON.parse(dataStr);
                            if (chunk.choices && chunk.choices[0]) {
                                var delta = chunk.choices[0].delta || {};
                                if (delta.reasoning_content) {
                                    reasoning += delta.reasoning_content;
                                }
                                if (delta.content) {
                                    content_resp += delta.content;
                                }
                            }
                        } catch(parseErr) {
                            // 单行解析失败不影响整体
                        }
                    }
                }
            } else {
                // 非流式兜底
                var jsonData = await resp.json();
                if (jsonData.choices && jsonData.choices[0]) {
                    var msg = jsonData.choices[0].message || {};
                    reasoning = msg.reasoning_content || msg.reasoning || '';
                    content_resp = msg.content || '';
                }
            }

            console.log('[GLM-5.2] ✅ 响应完成 | 思考长度:' + reasoning.length + ' | 内容长度:' + content_resp.length);

            // ---- 6. 保存到全局（供思考区渲染）----
            window.__lastGlmResult = { reasoning: reasoning, content: content_resp };
            window.__lastGlmReasoning = reasoning;

            // ---- 7. 解析 JSON 结果 ----
            var score = 0, level = 'safe', flags = [];
            // 尝试从 content 中提取 JSON
            try {
                var jsonMatch = content_resp.match(/\{[\s\S]*"score"[\s\S]*\}/);
                if (jsonMatch) {
                    var parsed = JSON.parse(jsonMatch[0]);
                    score = parseInt(parsed.score) || 0;
                    level = parsed.level || 'safe';
                    flags = parsed.flags || [];
                } else {
                    var directMatch = content_resp.match(/\{[\s\S]*\}/);
                    if (directMatch) {
                        var p2 = JSON.parse(directMatch[0]);
                        score = parseInt(p2.score) || 0;
                        level = p2.level || 'safe';
                        flags = p2.flags || [];
                    }
                }
            } catch(e) {
                console.warn('[GLM-5.2] JSON解析失败，使用文本分析');
            }

            // 文本分析兜底（如果 JSON 没解析出有效分数）
            if (score === 0 && content_resp.length > 0) {
                if (/恶意|危险|病毒|木马|后门|勒索/i.test(content_resp)) score = Math.max(score, 60);
                else if (/可疑|风险|警告|威胁/i.test(content_resp)) score = Math.max(score, 30);
                else score = Math.max(score, 10);
            }

            // 确保 reasoning 有内容
            if (!reasoning || reasoning.trim() === '') {
                if (content_resp && content_resp.length > 50) {
                    reasoning = '（GLM-5.2 未返回独立思考过程，以下是完整响应）\n\n' + content_resp.substring(0, 1000);
                } else {
                    reasoning = 'GLM-5.2 未返回思考过程。这可能是因为：\n1. API Key 权限不足\n2. 模型未开启 thinking 模式\n3. 网络环境限制\n\n原始响应长度: ' + content_resp.length + ' 字符';
                }
            }

            // 等级兜底
            if (score >= 70) level = 'critical';
            else if (score >= 40) level = 'high';
            else if (score >= 15) level = 'medium';
            else if (score >= 5) level = 'low';
            else level = 'safe';

            // 置信度
            var confidence = 75;
            if (flags.length === 0) confidence = 85;
            else if (flags.length >= 4) confidence = 92;
            else if (flags.length >= 2) confidence = 82;
            if (reasoning && reasoning.length > 100) confidence = Math.min(95, confidence + 5);

            console.log('[GLM-5.2] ✅ 分析完成: score=' + score + ' level=' + level + ' flags=' + flags.length + ' confidence=' + confidence + '%');

            return {
                score: Math.min(100, Math.max(0, score)),
                level: level,
                flags: flags,
                reasoning: reasoning,
                content: content_resp,
                engine: 'glm-5.2',
                modelVersion: GLM_MODEL,
                confidence: confidence
            };

        } catch(epErr) {
            console.error('[GLM-5.2] 端点 ' + ep + ' 失败:', epErr.message);
            lastError = epErr;
        }
    }

    // ---- 8. 全部端点失败 → 本地降级 ----
    console.error('[GLM-5.2] ❌ 所有端点失败:', lastError ? lastError.message : 'unknown');
    window.__lastGlmFallback = true;
    window.__lastGlmError = lastError ? lastError.message : '所有端点不可用';
    window.__lastGlmReasoning = '（GLM-5.2 云端调用失败：' + (lastError ? lastError.message.substring(0, 80) : '未知错误') + '）\n\n已自动降级到本地规则引擎进行分析。';
    return aiScanLocal(fileInfo, {});
}

