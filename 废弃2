    for(var si=0;si<strs.length;si++){
      for(var ri=0;ri<suspicious.length;ri++){
        if(suspicious[ri].pat.test(strs[si])){
          score+=suspicious[ri].sc;
          if(flags.indexOf(suspicious[ri].desc)===-1) flags.push(suspicious[ri].desc);
        }
      }
    }
    // 文件大小异常
    if(buf.length<4096&&buf.length>0){ score+=5; flags.push('异常小文件 ('+formatSize(buf.length)+')'); }
    if(buf.length>50*1048576){ score+=5; flags.push('大文件 ('+formatSize(buf.length)+')'); }
    // PE 特征
    if(magic.type==='pe'){
      var pe=parsePE(buf); details.pe=pe;
