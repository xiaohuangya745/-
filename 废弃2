        .bq-meta { display:flex; gap:10px; margin-bottom:16px; }
        .bq-cat { background:rgba(0,212,255,0.1); color:var(--primary); padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600; }
        .bq-diff { padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600; }
        .bq-diff::before { content:''; }
        .bq-text { font-size:18px; line-height:1.7; margin-bottom:24px; color:var(--text-light); }
        .bq-judge { display:flex; gap:16px; justify-content:center; margin-bottom:20px; }
        .bq-btn { padding:14px 40px; border-radius:12px; border:2px solid; font-size:16px; font-weight:700; cursor:pointer; transition:all .3s; }
        .bq-btn.true-btn { border-color:var(--success); color:var(--success); background:rgba(16,185,129,0.05); }
        .bq-btn.true-btn:hover:not(:disabled) { background:var(--success); color:#fff; }
