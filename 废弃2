        .xiehouyu-card:hover {
            border-color: var(--primary);
            box-shadow: 0 10px 40px rgba(0, 212, 255, 0.1);
        }

        .xiehouyu-front {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .xiehouyu-hint {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 20px;
        }

        .xiehouyu-back {
            font-size: 22px;
            color: var(--warning);
            font-weight: 700;
            margin-top: 15px;
            display: none;
            animation: fadeIn 0.5s;
        }

        .xiehouyu-back.show {
            display: block;
        }

        .xiehouyu-back .emoji {
            font-size: 36px;
            display: block;
            margin-bottom: 10px;
        }

        .xiehouyu-nav {
            display: flex;
            gap: 15px;
            justify-content: center;
            align-items: center;
        }

        .xiehouyu-nav button {
            padding: 12px 24px;
            border-radius: 10px;
            border: 1px solid rgba(0, 212, 255, 0.2);
            background: var(--bg-card);
            color: var(--text-light);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .xiehouyu-nav button:hover {
            background: rgba(0, 212, 255, 0.08);
            border-color: var(--primary);
        }

        .xiehouyu-counter {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* ===== 大胆实践模块 ===== */
        .practice-intro {
            text-align: center;
            padding: 30px 0;
            animation: fadeIn 0.6s;
        }

        .practice-intro .intro-icon {
            font-size: 64px;
            margin-bottom: 20px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        .practice-intro h2 {
            font-size: 32px;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #f59e0b, #ef4444, #a855f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .practice-intro p {
            color: var(--text-muted);
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto 30px;
            line-height: 1.8;
        }

        .practice-animation-area {
            background: #0d1117;
            border: 1px solid rgba(0, 212, 255, 0.1);
            border-radius: 16px;
            padding: 30px;
            margin: 20px auto 30px;
            max-width: 800px;
            min-height: 200px;
            position: relative;
            overflow: hidden;
        }

        .practice-scenario {
            text-align: center;
            animation: fadeIn 0.5s;
        }

        .practice-scenario .scenario-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .practice-scenario h3 {
            font-size: 22px;
            margin-bottom: 15px;
            color: var(--text-light);
        }

        .practice-scenario .scenario-desc {
            color: var(--text-muted);
            font-size: 15px;
            line-height: 1.8;
            max-width: 600px;
            margin: 0 auto 20px;
        }

        .practice-code-block {
            background: #161b22;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
            padding: 20px;
            margin: 15px auto;
            max-width: 650px;
            text-align: left;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 13px;
            line-height: 1.8;
            color: #c9d1d9;
            overflow-x: auto;
        }

        .practice-code-block .comment { color: #8b949e; }
        .practice-code-block .keyword { color: #ff7b72; }
        .practice-code-block .string { color: #a5d6ff; }
        .practice-code-block .function { color: #d2a8ff; }
        .practice-code-block .highlight { color: #ffa657; }
        .practice-code-block .good { color: #3fb950; }
        .practice-code-block .bad { color: #f85149; }

        .practice-options {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 650px;
            margin: 20px auto;
        }

        .practice-option {
            padding: 16px 20px;
            border-radius: 12px;
            border: 2px solid rgba(255,255,255,0.08);
            background: var(--bg-card);
            color: var(--text-light);
            font-size: 15px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: left;
            line-height: 1.6;
        }

        .practice-option:hover {
            border-color: var(--primary);
            background: rgba(0, 212, 255, 0.05);
        }

        .practice-option.correct {
            border-color: var(--success);
            background: rgba(16,185,129,0.1);
            animation: pulse 0.5s;
        }

        .practice-option.wrong {
            border-color: var(--danger);
            background: rgba(239,68,68,0.1);
            animation: shake 0.5s;
        }

        .practice-option .opt-label {
            font-weight: 700;
            margin-right: 8px;
            color: var(--primary);
        }

        .practice-feedback {
            margin-top: 20px;
            padding: 18px 22px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.8;
            display: none;
            animation: fadeIn 0.4s;
            max-width: 650px;
            margin-left: auto;
            margin-right: auto;
        }

        .practice-feedback.show { display: block; }
        .practice-feedback.fb-correct {
            background: rgba(16,185,129,0.08);
            border: 1px solid rgba(16,185,129,0.2);
        }
        .practice-feedback.fb-wrong {
            background: rgba(239,68,68,0.08);
            border: 1px solid rgba(239,68,68,0.2);
        }

        .practice-progress {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 20px 0;
        }

        .practice-progress .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            transition: all 0.3s;
        }

        .practice-progress .dot.active {
            background: var(--primary);
            box-shadow: 0 0 8px var(--primary);
        }

        .practice-progress .dot.done {
            background: var(--success);
        }

        .practice-level-badge {
            display: inline-block;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .practice-level-badge.lb-easy { background: rgba(16,185,129,0.15); color: #10b981; }
        .practice-level-badge.lb-medium { background: rgba(59,130,246,0.15); color: #3b82f6; }
        .practice-level-badge.lb-hard { background: rgba(245,158,11,0.15); color: #f59e0b; }
        .practice-level-badge.lb-expert { background: rgba(239,68,68,0.15); color: #ef4444; }
        .practice-level-badge.lb-insane { background: rgba(168,85,247,0.15); color: #a855f7; }

        .practice-summary {
            text-align: center;
            padding: 40px 20px;
            animation: fadeIn 0.6s;
        }

        .practice-summary .summary-icon {
            font-size: 60px;
            margin-bottom: 20px;
        }

        .practice-summary h2 {
            font-size: 28px;
            margin-bottom: 15px;
        }

        .practice-summary .summary-stats {
            display: flex;
            gap: 30px;
            justify-content: center;
            margin: 25px 0;
        }

        .practice-summary .summary-stat {
            text-align: center;
        }

        .practice-summary .summary-stat .num {
            font-size: 32px;
            font-weight: 800;
        }

        .practice-summary .summary-stat .num.correct-num { color: var(--success); }
        .practice-summary .summary-stat .num.wrong-num { color: var(--danger); }
        .practice-summary .summary-stat .lbl {
            font-size: 13px;
            color: var(--text-muted);
        }

        .terminal-animation {
            background: #0d1117;
            border-radius: 10px;
            padding: 20px;
            margin: 15px auto;
            max-width: 650px;
            text-align: left;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 13px;
            color: #c9d1d9;
            min-height: 120px;
            position: relative;
        }

        .terminal-animation .prompt { color: #3fb950; }
        .terminal-animation .cursor {
            display: inline-block;
            width: 8px;
            height: 16px;
            background: var(--primary);
            vertical-align: middle;
            animation: blink 1s infinite;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .terminal-line {
            opacity: 0;
            animation: typeIn 0.4s forwards;
        }

        @keyframes typeIn {
            from { opacity: 0; transform: translateX(-10px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .scan-animation {
            position: relative;
            width: 100%;
            height: 60px;
            background: rgba(0, 212, 255, 0.03);
            border-radius: 8px;
            overflow: hidden;
            margin: 15px 0;
        }

        .scan-line {
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.15), transparent);
            animation: scanMove 2s ease-in-out infinite;
        }

        @keyframes scanMove {
            0% { left: -100%; }
            100% { left: 100%; }
        }

        .shield-animation {
            text-align: center;
            margin: 20px 0;
        }

        .shield-emoji {
            font-size: 60px;
            display: inline-block;
            animation: shieldPulse 2s ease-in-out infinite;
        }

        @keyframes shieldPulse {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(0,212,255,0.3)); }
            50% { transform: scale(1.1); filter: drop-shadow(0 0 25px rgba(0,212,255,0.6)); }
        }

        .lock-animation {
            text-align: center;
            margin: 20px 0;
        }

        .lock-emoji {
            font-size: 50px;
            display: inline-block;
        }

        .lock-emoji.locked { animation: lockShake 0.5s; }
        .lock-emoji.unlocked { animation: unlockSpin 0.6s; }

        @keyframes lockShake {
            0%, 100% { transform: rotate(0); }
            25% { transform: rotate(-10deg); }
            75% { transform: rotate(10deg); }
        }

        @keyframes unlockSpin {
            0% { transform: rotate(0) scale(1); }
            50% { transform: rotate(180deg) scale(1.2); }
            100% { transform: rotate(360deg) scale(1); }
        }

        .matrix-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            opacity: 0.1;
            pointer-events: none;
        }

        .matrix-char {
            position: absolute;
            color: #00ff00;
            font-family: monospace;
            font-size: 14px;
            animation: matrixFall linear infinite;
        }

        @keyframes matrixFall {
            from { transform: translateY(-100%); opacity: 1; }
            to { transform: translateY(100vh); opacity: 0; }
        }

        .difficulty-stars {
            font-size: 20px;
            margin: 10px 0;
        }

        .practice-start-btn {
            display: inline-block;
            margin: 20px auto;
            padding: 16px 50px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            color: #fff;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .practice-start-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 30px rgba(239, 68, 68, 0.4);
