    if (typeof qvmScan === 'function') window.qvmScan = qvmScan;
    // setEng：IIFE 顶层版本（原 setEng 定义在 startScan 内部，外层不可见）
    window.setEng = function setEng(name, val) {
        try {
            var bar = document.getElementById('es' + String(name).toUpperCase());
            var v = document.getElementById('es' + String(name).toUpperCase() + 'v');
            var lower = String(name).toLowerCase();
            var enabled = (lower === 'ai') ? true : (window.isEngineEnabled ? window.isEngineEnabled(lower) : true);
            if (bar) {
                if (!enabled) { bar.style.width = '0%'; bar.classList.add('es-disabled'); }
                else { bar.style.width = Math.min(100, val) + '%'; bar.classList.remove('es-disabled'); }
            }
            if (v) v.textContent = enabled ? val : '—';
        } catch(e) {}
    };
    // updateGlmReasoning 别名（复用 renderGlmReasoning）
    try { window.updateGlmReasoning = window.renderGlmReasoning || renderGlmReasoning; } catch(e) {}

    // 暴露 GLM 常量
    window.GLM_API_ENDPOINT = GLM_API_ENDPOINT;
    window.GLM_MODEL = GLM_MODEL;
    window.AI_ENGINE_PASSWORD = AI_ENGINE_PASSWORD;

    // 验证 GLM 就绪状态
    if (isGlmReady()) {
        console.log('%c[GLM-5.2] API Key 已就绪 ✓ 云端大模型引擎可用', 'color:#a855f7;font-weight:bold');
    } else {
        console.warn('%c[GLM-5.2] API Key 未配置，将使用本地降级引擎', 'color:#f59e0b');
    }
})();
</script>

    <script>
    try { window.startScan = startScan; } catch(e) {}
    try { window.isEngineEnabled = isEngineEnabled; } catch(e) {}
    try { window.__lastGlmReasoning = window.__lastGlmReasoning || ''; } catch(e) {}
    try { window.__lastGlmResult = window.__lastGlmResult || null; } catch(e) {}
    try { window.glmReasoningText = window.glmReasoningText || ''; } catch(e) {}
</script>
