        }
        function hideRepairPopup() {
            var o = document.getElementById('repairOverlay');
            if (o) o.classList.remove('show');
        }

        // ── 错误弹窗 ──
        function showErrorPopup(stage, msg, idx, total) {
            var o = document.getElementById('errorOverlay');
            if (!o) {
                var div = document.createElement('div');
