          }
        }
      }
    }
    // ===== 强力模式高敏规则集（aggressive 时启用，额外 +30% 强度）=====
    if(aggressive){
      var highSensRules=[
        {pat:/GetProcAddress/i,sc:12,desc:'GetProcAddress动态解析'},
