<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔐 网络安全中心</title>
    <!-- 全局polyfill：确保global在file://协议下也可用 -->
    <script>
    try { window.global = window; } catch(e) {}
    try { window.self = window; } catch(e) {}
    try { window.globalThis = window; } catch(e) {}
    console.log('[YB] Polyfill loaded');
    
function renderGlmReasoning(rt) {
    var p=document.getElementById('glmReasoningPanel');
    var b=document.getElementById('glmReasoningBody');
    var t=document.getElementById('glmReasoningText');
    var bd=document.getElementById('glmReasoningBadge');
    if(!p||!b||!t) return;
    if(!rt||rt.trim()==='') rt='(GLM-5.2 未返回思考过程)';
    t.textContent=rt; p.style.display='block'; b.style.display='block';
    if(bd) bd.textContent='已展开';
    console.log('[GLM-5.2] 思考区已渲染, 长度:',rt.length);
}
(function(){
    var h=document.getElementById('glmReasoningHeader');
    var b=document.getElementById('glmReasoningBody');
    var bd=document.getElementById('glmReasoningBadge');
    if(h&&b){h.onclick=function(){var o=b.style.display!=='none';b.style.display=o?'none':'block';if(bd)bd.textContent=o?'点击展开':'已展开';};}
})();
</script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #00d4ff;
            --primary-dark: #0090b8;
            --bg-dark: #0a0e1a;
            --bg-card: #111827;
            --bg-card-hover: #1a2235;
            --text-light: #e4e6eb;
            --text-muted: #9ca3af;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --gradient-1: linear-gradient(135deg, #00d4ff 0%, #0090b8 100%);
            --gradient-2: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-3: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --gradient-success: linear-gradient(135deg, #10b981 0%, #059669 100%);
            --gradient-danger: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            /* 设置中心动态变量 */
            --particle-count: 50;
            --blur-radius: 20px;
            --shadow-strength: 1;
            --anim-enabled: 1;
            --backdrop-strength: 1;
            --saturate-strength: 1;
        }

        /* 性能模式：关闭动画 */
        body.no-anim *, body.no-anim *::before, body.no-anim *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
        body.no-anim .bg-animation { display: none !important; }

        /* 背景模糊由 JS 变量驱动 */
        .navbar {
            backdrop-filter: blur(calc(20px * var(--backdrop-strength))) saturate(var(--saturate-strength));
            -webkit-backdrop-filter: blur(calc(20px * var(--backdrop-strength))) saturate(var(--saturate-strength));
        }

        /* 阴影强度由 JS 变量驱动 */
        .stat-card:hover {
            box-shadow: 0 calc(10px * var(--shadow-strength)) calc(40px * var(--shadow-strength)) rgba(0, 212, 255, calc(0.1 * var(--shadow-strength)));
        }

        /* IE 深度兼容：关模糊、关动画、关阴影 */
        body.compat-deep .bg-animation { display: none !important; }
        body.compat-deep .navbar { background: rgba(10,14,26,0.98) !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
        body.compat-deep * { animation: none !important; transition: none !important; }
        body.compat-deep .stat-card:hover { transform: none !important; box-shadow: none !important; }

        /* 手机端触控优化 */
        body.touch-optimized:hover .stat-card { transform: none; }
        body.touch-optimized .action-btn:hover { transform: none; background: var(--bg-card); }

        body {
            font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: var(--bg-dark);
            color: var(--text-light);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ===== 背景动画 ===== */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .bg-animation span {
            position: absolute;
            display: block;
            width: 4px;
            height: 4px;
            background: var(--primary);
            border-radius: 50%;
            animation: float 15s infinite;
            opacity: 0.3;
        }

        @keyframes float {
            0%, 100% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 0.5; }
            90% { opacity: 0.5; }
            100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
        }

        /* ===== 导航栏 ===== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(10, 14, 26, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 212, 255, 0.15);
            padding: 0 40px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar .logo {
            font-size: 22px;
            font-weight: 800;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .navbar .logo .icon {
            font-size: 28px;
            -webkit-text-fill-color: initial;
        }

        .nav-links {
            display: flex;
            gap: 8px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 18px;
            border-radius: 8px;
            transition: all 0.3s;
            font-size: 14px;
            font-weight: 500;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--primary);
            background: rgba(0, 212, 255, 0.08);
        }

        /* ===== 页面通用 ===== */
        .page {
            display: none;
            padding: 100px 40px 60px;
            max-width: 1200px;
            margin: 0 auto;
            animation: fadeIn 0.5s ease;
        }

        .page.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .page-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .page-header h1 {
            font-size: 42px;
            margin-bottom: 15px;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 17px;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.7;
        }

        /* ===== 首页 ===== */
        .hero-section {
            text-align: center;
            padding: 60px 0 40px;
        }

        .hero-section h1 {
            font-size: 56px;
            font-weight: 900;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #00d4ff, #667eea, #f093fb);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 4s ease infinite;
            background-size: 200% 200%;
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .hero-section .subtitle {
            font-size: 20px;
            color: var(--text-muted);
            margin-bottom: 40px;
        }

        .hero-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 50px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid rgba(0, 212, 255, 0.1);
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            transition: all 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
            box-shadow: 0 10px 40px rgba(0, 212, 255, 0.1);
        }

        .stat-card .number {
            font-size: 36px;
            font-weight: 800;
            color: var(--primary);
        }

        .stat-card .label {
            color: var(--text-muted);
            margin-top: 8px;
            font-size: 14px;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            max-width: 700px;
            margin: 0 auto;
        }

        .action-btn {
            padding: 20px 30px;
            border-radius: 14px;
            border: 1px solid rgba(0, 212, 255, 0.2);
            background: var(--bg-card);
            color: var(--text-light);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 12px;
            justify-content: center;
        }

        .action-btn:hover {
            background: rgba(0, 212, 255, 0.08);
            border-color: var(--primary);
            transform: scale(1.02);
        }

        .action-btn .emoji {
            font-size: 24px;
        }

        /* ===== 制作人页脚 ===== */
        .site-footer {
            margin-top: 60px;
            padding: 28px 20px 32px;
            border-top: 1px solid rgba(0, 212, 255, 0.12);
            background: linear-gradient(180deg, rgba(0, 212, 255, 0.02) 0%, rgba(0, 0, 0, 0) 100%);
            text-align: center;
            position: relative;
        }

        .site-footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
        }

        .site-footer .footer-content {
            display: inline-flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 18px;
            font-size: 15px;
            color: var(--text-muted);
            line-height: 1.8;
        }

        .site-footer .footer-label {
            color: var(--text-muted);
            opacity: 0.85;
        }

        .site-footer .footer-author {
            color: transparent;
            background: linear-gradient(90deg, var(--primary), #00ffff);
            -webkit-background-clip: text;
            background-clip: text;
            font-weight: 700;
            font-size: 16px;
            text-decoration: none;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .site-footer .footer-author:hover {
            filter: brightness(1.3);
            text-shadow: 0 0 16px var(--primary);
        }

        .site-footer .footer-author:visited {
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .site-footer .footer-ai {
            color: #a855f7;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s;
        }

        .site-footer .footer-ai:hover {
            color: #c4b5fd;
            text-shadow: 0 0 10px rgba(168, 85, 247, 0.6);
        }

        .site-footer .footer-divider {
            color: rgba(255,255,255,0.15);
            font-size: 14px;
        }

        .site-footer .footer-icon {
            font-size: 18px;
        }

        /* ===== 历史更新区块 ===== */
        .update-block {
            margin: 36px auto 0;
            max-width: 820px;
            background: linear-gradient(160deg, rgba(17,24,39,0.92) 0%, rgba(15,23,42,0.95) 100%);
            border: 1px solid rgba(0, 212, 255, 0.15);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,212,255,0.04) inset;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            position: relative;
        }

        .update-block::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--primary), #a855f7, transparent);
            animation: updateShimmer 4s ease-in-out infinite;
        }

        @keyframes updateShimmer {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .update-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 26px;
            cursor: pointer;
            user-select: none;
            background: rgba(0, 212, 255, 0.03);
            transition: background 0.25s;
        }

        .update-header:hover {
            background: rgba(0, 212, 255, 0.07);
        }

        .update-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .update-title .update-icon {
            font-size: 24px;
            animation: updateIconSpin 6s linear infinite;
        }

        @keyframes updateIconSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .update-title h3 {
            font-size: 17px;
            font-weight: 700;
            color: var(--text-light);
            margin: 0;
            letter-spacing: 0.5px;
        }

        .update-title .update-count {
            font-size: 12px;
            background: linear-gradient(135deg, var(--primary), #a855f7);
            color: #fff;
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 600;
            white-space: nowrap;
        }

        .update-toggle {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            font-size: 13px;
            transition: color 0.2s;
        }

        .update-toggle .toggle-arrow {
            display: inline-block;
            transition: transform 0.35s ease;
            font-size: 16px;
        }

        .update-block.open .toggle-arrow {
            transform: rotate(180deg);
        }

        .update-body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
            opacity: 0;
        }

        .update-block.open .update-body {
            max-height: 1200px;
            opacity: 1;
        }

        .update-list {
            padding: 8px 26px 24px;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .update-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 14px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            position: relative;
        }

        .update-item:last-child {
            border-bottom: none;
        }

        .update-item::before {
            content: '';
            position: absolute;
            left: -26px;
            top: 22px;
            bottom: -14px;
            width: 2px;
            background: linear-gradient(180deg, rgba(0,212,255,0.3), transparent);
        }

        .update-item:last-child::before {
            bottom: 50%;
        }

        .update-dot {
            flex-shrink: 0;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-top: 6px;
            margin-left: -6px;
            position: relative;
            z-index: 1;
        }

        .update-dot.current {
            background: linear-gradient(135deg, #f59e0b, #f97316);
            box-shadow: 0 0 12px rgba(245,158,11,0.6);
        }

        .update-dot.major {
            background: linear-gradient(135deg, var(--primary), #00ffff);
            box-shadow: 0 0 10px rgba(0,212,255,0.5);
        }

        .update-dot.minor {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            box-shadow: 0 0 8px rgba(99,102,241,0.4);
        }

        .update-dot.patch {
            background: linear-gradient(135deg, #10b981, #34d399);
            box-shadow: 0 0 8px rgba(16,185,129,0.4);
        }

        .update-content {
            flex: 1;
        }

        .update-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 4px;
            flex-wrap: wrap;
        }

        .update-version {
            font-size: 13px;
            font-weight: 800;
            padding: 2px 10px;
            border-radius: 6px;
            letter-spacing: 0.3px;
        }

        .update-version.current {
            background: linear-gradient(135deg, #f59e0b, #f97316);
            color: #1a1a1a;
            animation: currentBadgePulse 2s ease-in-out infinite;
        }

        @keyframes currentBadgePulse {
            0%, 100% { box-shadow: 0 0 6px rgba(245,158,11,0.4); }
            50% { box-shadow: 0 0 14px rgba(245,158,11,0.7); }
        }

        .update-version.major {
            background: linear-gradient(135deg, var(--primary), #00a8d8);
            color: #fff;
        }

        .update-version.minor {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: #fff;
        }

        .update-version.patch {
            background: linear-gradient(135deg, #10b981, #059669);
            color: #fff;
        }

        .update-date {
            font-size: 12px;
            color: var(--text-muted);
            opacity: 0.8;
        }

        .update-tag {
            font-size: 11px;
            padding: 1px 8px;
            border-radius: 4px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .update-tag.new { background: rgba(0,212,255,0.15); color: var(--primary); }
        .update-tag.fix { background: rgba(16,185,129,0.15); color: #34d399; }
        .update-tag.ui  { background: rgba(168,85,247,0.15); color: #c4b5fd; }
        .update-tag.perf{ background: rgba(245,158,11,0.15); color: #fbbf24; }

        .update-text {
            font-size: 13.5px;
            color: rgba(228,230,235,0.85);
            line-height: 1.7;
        }

        .update-text strong {
            color: var(--text-light);
            font-weight: 600;
        }

        .update-footer-note {
            padding: 0 26px 20px;
            font-size: 12px;
            color: var(--text-muted);
            opacity: 0.6;
            text-align: center;
        }

        /* 响应式 */
        @media (max-width: 600px) {
            .update-block { margin: 24px 8px 0; border-radius: 14px; }
            .update-header { padding: 16px 18px; }
            .update-list { padding: 8px 18px 20px; }
            .update-item { gap: 12px; }
            .update-title h3 { font-size: 15px; }
        }

        /* ===== 教学模块 ===== */
        .module-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .module-card {
            background: var(--bg-card);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            padding: 30px;
            transition: all 0.3s;
            cursor: pointer;
        }

        .module-card:hover {
            transform: translateY(-3px);
            border-color: var(--primary);
            box-shadow: 0 8px 30px rgba(0, 212, 255, 0.08);
        }

        .module-card .module-icon {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .module-card h3 {
            font-size: 20px;
            margin-bottom: 10px;
            color: var(--primary);
        }

        .module-card p {
            color: var(--text-muted);
            line-height: 1.7;
            font-size: 14px;
        }

        .module-card .steps {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .module-card .step {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
            font-size: 13px;
            color: var(--text-muted);
        }

        .module-card .step .step-num {
            background: var(--gradient-1);
            color: #fff;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .module-card .step .step-text {
            flex: 1;
            line-height: 1.5;
        }

        .module-card .step .step-text strong {
            color: var(--text-light);
        }

        .module-card .tip-box {
            margin-top: 12px;
            padding: 10px 14px;
            background: rgba(0, 212, 255, 0.05);
            border-left: 3px solid var(--primary);
            border-radius: 6px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .module-card .tip-box strong {
            color: var(--warning);
        }

        /* ===== 答题区域 ===== */
        .quiz-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .difficulty-selector {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .diff-btn {
            padding: 12px 28px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.1);
            background: var(--bg-card);
            color: var(--text-light);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .diff-btn:hover {
            transform: scale(1.05);
        }

        .diff-btn.active {
            border-color: var(--primary);
            color: var(--primary);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
        }

        .diff-btn[data-diff="easy"] { border-color: #10b981; color: #10b981; }
        .diff-btn[data-diff="medium"] { border-color: #3b82f6; color: #3b82f6; }
        .diff-btn[data-diff="hard"] { border-color: #f59e0b; color: #f59e0b; }
        .diff-btn[data-diff="expert"] { border-color: #ef4444; color: #ef4444; }
        .diff-btn[data-diff="insane"] { border-color: #a855f7; color: #a855f7; }

        .question-card {
            background: var(--bg-card);
            border: 1px solid rgba(0, 212, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 30px;
            animation: slideUp 0.4s ease;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .question-progress {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .progress-bar {
            flex: 1;
            height: 6px;
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            margin: 0 15px;
            overflow: hidden;
        }

        .progress-bar .fill {
            height: 100%;
