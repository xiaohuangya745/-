<script>
// ===== YBSandbox.analyze 异步适配层 =====
(function(){
    function waitForYBSandbox(callback, retries) {
        retries = retries || 0;
        if (window.YBSandbox && window.YBSandbox.analyzeFile) {
            // Provide async analyze that wraps sync analyzeFile
            // FIX: 先把 File 对象读成 ArrayBuffer，再构造 fileInfo 传给 analyzeFile
            // 否则 fileInfo.data 为 undefined → scoreFile/qexScan 全部返回"无数据"
            function _readFileToBuffer(file) {
                return new Promise(function(resolve, reject) {
                    try {
                        var fr = new FileReader();
                        fr.onload = function(e) { resolve(new Uint8Array(e.target.result)); };
                        fr.onerror = function() { resolve(new Uint8Array(0)); };
                        fr.readAsArrayBuffer(file);
                    } catch(e) { resolve(new Uint8Array(0)); }
                });
            }
            window.YBSandbox.analyze = function(file, options) {
                options = options || {};
                return new Promise(function(resolve) {
                    // 如果已经是 fileInfo 对象（带 .data），直接用
                    if (file && file.data) {
                        try {
                            var r = window.YBSandbox.analyzeFile(file, options);
                            resolve(r);
                        } catch(e) {
                            resolve({score:0, level:'safe', flags:[], engines:{}, error: e.message});
                        }
                        return;
                    }
                    // File 对象 → 先读成 buffer
                    _readFileToBuffer(file).then(function(buf) {
                        try {
                            var info = { name: file.name, size: file.size, data: buf };
                            var result = window.YBSandbox.analyzeFile(info, options);
                            resolve(result);
                        } catch(e) {
                            resolve({score:0, level:'safe', flags:[], engines:{}, error: e.message});
                        }
                    }).catch(function() {
                        resolve({score:0, level:'safe', flags:['文件读取失败'], engines:{}, error:'read failed'});
                    });
                });
            };
            // Also provide sync analyze alias (需要调用方自己先读好 data)
            window.YBSandbox.scan = window.YBSandbox.analyzeFile;
            if (callback) callback();
        } else if (retries < 100) {
            setTimeout(function() { waitForYBSandbox(callback, retries+1); }, 50);
        }
    }
    // Start waiting
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { waitForYBSandbox(); });
    } else {
        waitForYBSandbox();
    }
})();
</script>


