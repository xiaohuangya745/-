        // ── 递归遍历文件夹条目 ──
        async function traverseEntry(entry, fileList, parentPath) {
            const path = parentPath ? parentPath + '/' + entry.name : entry.name;
            if (entry.isFile) {
                await new Promise(resolve => {
                    entry.file(file => {
                        // 注入相对路径
                        try { file.webkitRelativePath = path; } catch(e) {}
                        fileList.push(file);
                        resolve();
                    }, () => resolve());
                });
            } else if (entry.isDirectory) {
                const reader = entry.createReader();
                let entries = [];
                // 循环读取（避免一次最多 100 条限制）
                while (true) {
                    const batch = await new Promise(res => reader.readEntries(res));
                    if (batch.length === 0) break;
                    entries = entries.concat(batch);
                }
                for (const child of entries) {
                    await traverseEntry(child, fileList, path);
                }
            }
        }

        // ── 提取根文件夹名 ──
        function extractRootName(files) {
            if (!files.length) return '文件夹';
            const first = files[0].webkitRelativePath || files[0].name;
            const parts = first.split('/');
            return parts.length > 1 ? parts[0] : '文件夹';
        }

        // ── 构建文件夹树（用于展示） ──
        function buildFolderTree(files, rootName) {
            if (!folderTreeEl) return;
            folderTreeEl.style.display = 'block';
            folderTreeEl.innerHTML = `<div class="folder-tree-title">📂 ${escapeHtml(rootName)} <span style="font-size:11px;color:var(--text-muted);font-weight:400;">(${files.length} 个文件)</span></div>`;

            // 构建树结构
            const root = { name: rootName, type: 'folder', children: {}, files: [], path: '' };
            for (const f of files) {
                const relPath = f.webkitRelativePath || f.name;
                const parts = relPath.split('/');
                let cur = root;
                for (let i = 1; i < parts.length; i++) {
                    const seg = parts[i];
                    if (i === parts.length - 1) {
                        // 文件
                        cur.files.push({ name: seg, file: f, level: 'pending' });
                    } else {
                        if (!cur.children[seg]) {
                            cur.children[seg] = { name: seg, type: 'folder', children: {}, files: [], path: cur.path + '/' + seg };
                        }
                        cur = cur.children[seg];
                    }
                }
            }

            // 渲染树
            const treeRoot = document.createElement('div');
            treeRoot.className = 'tree-node';
            renderTreeNode(root, treeRoot, 0);
            folderTreeEl.appendChild(treeRoot);

            // 统计行
            const stats = document.createElement('div');
            stats.className = 'tree-stats';
            stats.id = 'treeStats';
            stats.innerHTML = `
                <span class="ts-item">总计：<strong>${files.length}</strong> 个文件</span>
                <span class="ts-item">待扫描：<strong style="color:var(--primary)">${files.length}</strong></span>
                <span class="ts-item">安全：<strong style="color:#6ee7b7">0</strong></span>
                <span class="ts-item">发现威胁：<strong style="color:#fca5a5">0</strong></span>
            `;
            folderTreeEl.appendChild(stats);

            folderRoot = root;
        }

        // ── 渲染单个树节点 ──
        function renderTreeNode(node, parentEl, depth) {
            // 子文件夹
            const folderNames = Object.keys(node.children).sort();
            for (const fname of folderNames) {
                const child = node.children[fname];
                const folderEl = document.createElement('div');
                folderEl.className = 'tree-folder open';
                folderEl.style.paddingLeft = (depth * 16) + 'px';
                folderEl.textContent = child.name;
                folderEl.addEventListener('click', () => {
                    folderEl.classList.toggle('open');
                    const next = folderEl.nextElementSibling;
                    if (next && next.classList.contains('tree-children')) {
                        next.classList.toggle('collapsed');
                    }
                });
                parentEl.appendChild(folderEl);

                const childrenWrap = document.createElement('div');
                childrenWrap.className = 'tree-children';
                renderTreeNode(child, childrenWrap, depth + 1);
                parentEl.appendChild(childrenWrap);
            }
            // 文件
            for (const f of node.files) {
                const fileEl = document.createElement('div');
                fileEl.className = 'tree-file';
                fileEl.style.paddingLeft = ((depth + 1) * 16) + 'px';
                fileEl.dataset.filename = f.name;
                fileEl.innerHTML = `
                    <span>📄</span>
                    <span class="tf-name">${escapeHtml(f.name)}</span>
                    <span class="tf-badge scanning" data-badge="${escapeHtml(f.name)}">⏳ 待扫描</span>
                `;
                parentEl.appendChild(fileEl);
            }
        }

        // ── 更新树中某个文件的状态 ──
        function updateTreeFile(file, level) {
            if (!folderTreeEl) return;
            const name = file.name || (file.webkitRelativePath || '').split('/').pop();
            const badges = folderTreeEl.querySelectorAll('.tf-badge');
            for (const b of badges) {
                if (b.dataset.badge === name) {
                    const labelMap = { info: '✅ 安全', low: '💡 低风险', medium: '⚠️ 可疑', high: '🚨 高风险' };
                    b.className = 'tf-badge ' + level;
                    b.textContent = labelMap[level] || '✅ 安全';
                    break;
                }
            }
            // 更新统计
            updateTreeStats();
        }

        // ── 更新树统计 ──
        function updateTreeStats() {
            const stats = document.getElementById('treeStats');
            if (!stats) return;
            const all = folderTreeEl.querySelectorAll('.tf-badge');
            let total = 0, safe = 0, threat = 0, pending = 0;
            all.forEach(b => {
                total++;
                if (b.classList.contains('scanning')) pending++;
                else if (b.classList.contains('high') || b.classList.contains('medium')) threat++;
                else if (b.classList.contains('safe') || b.classList.contains('low')) safe++;
            });
            stats.innerHTML = `
                <span class="ts-item">总计：<strong>${total}</strong> 个文件</span>
                <span class="ts-item">待扫描：<strong style="color:var(--primary)">${pending}</strong></span>
                <span class="ts-item">安全：<strong style="color:#6ee7b7">${safe}</strong></span>
                <span class="ts-item">发现威胁：<strong style="color:#fca5a5">${threat}</strong></span>
            `;
        }

        // ── 清除文件夹树 ──
        function clearFolderTree() {
            if (folderTreeEl) {
                folderTreeEl.style.display = 'none';
                folderTreeEl.innerHTML = '';
            }
            folderRoot = null;
        }

        
        // 注意：isEngineEnabled 必须在 startScan 外部，否则暴露到 window 时是 undefined
        function isEngineEnabled(name) {
            if (name === 'qvm') return swQVM ? swQVM.checked : true;
            if (name === 'qex') return swQEX ? swQEX.checked : true;
            if (name === 'rev') return swREV ? swREV.checked : true;
            if (name === 'yara') return swYARA ? swYARA.checked : true;
            if (name === 'ai')  return window.engineState ? !!window.engineState.ai : true;
            return true;
        }
        window.isEngineEnabled = isEngineEnabled;
        try { global.isEngineEnabled = isEngineEnabled; } catch(e) {}
        function buildEngineFlags(engines, details) {
            var flags = [];
            if (engines.qvm > 0) flags.push('[QVM] 评分 ' + engines.qvm);
            if (engines.qex > 0) flags.push('[QEX] 评分 ' + engines.qex + ' (' + ((details.qexEvents||[]).length) + '事件)');
            if (engines.rev > 0) flags.push('[REV] 评分 ' + engines.rev + ' (' + ((details.revFlags||[]).length) + '异常)');
            if (engines.yara > 0) flags.push('[YARA] 评分 ' + engines.yara + ' (' + ((details.yaraMatches||[]).length) + '规则)');
            if (engines.ai > 0) flags.push('[AI] 评分 ' + engines.ai + ' (' + ((details.aiFlags||[]).length) + '特征)');
            return flags;
        }

        // ── 扫描主流程 ──
        async function startScan(files, rootName) {
            if (scanning) return;
            scanning = true;
            currentFileList = files;
            resultEl.classList.remove('active');
            progressEl.classList.add('active');
            progressFill.style.width = '0%';
            progressPct.textContent = '0%';
            progressLabel.textContent = '初始化...';

            // 重置 GLM-5.2 思考区域
            window.__lastGlmReasoning = '';
            window.glmReasoningText = '';
            var glmPanel = document.getElementById('glmReasoningPanel');
            var glmLoading = document.getElementById('glmReasoningLoading');
            var glmText = document.getElementById('glmReasoningText');
            var glmBadge = document.getElementById('glmReasoningBadge');
            if (glmPanel) {
                glmPanel.classList.remove('open');
                glmPanel.classList.remove('hidden'); // 保持可见（显示加载中状态）
            }
            if (glmLoading) glmLoading.style.display = 'flex';
            if (glmText) { glmText.classList.add('hidden'); glmText.innerHTML = ''; }
            if (glmBadge) {
                glmBadge.textContent = '思考中...';
                glmBadge.style.background = 'rgba(168,85,247,0.3)';
                glmBadge.style.color = '#ddd6fe';
            }

            // 显示阶段指示器 + 引擎分数
            const stagesEl = document.getElementById('sbStages');
            const engEl = document.getElementById('sbEngScores');
            if (stagesEl) stagesEl.style.display = 'block';
            if (engEl) engEl.style.display = 'block';

            // 重置深度扫描项状态
            function resetSdp(id) {
                var el = document.getElementById(id);
                if (el) { el.className = 'sdp-val pass'; el.textContent = '等待扫描...'; }
            }
            resetSdp('sdpEntropy'); resetSdp('sdpStrings'); resetSdp('sdpPE');
            resetSdp('sdpFuzzy'); resetSdp('sdpCross'); resetSdp('sdpImport');
            resetSdp('sdpTLS'); resetSdp('sdpRsrc');

            // 根据引擎开关同步阶段胶囊 + 分数条灰色状态
            syncStageDisabled();
            // 引擎分数条也同步灰色
            [{name:'QVM',sw:swQVM},{name:'QEX',sw:swQEX},{name:'REV',sw:swREV},{name:'YARA',sw:swYARA},{name:'AI',sw:null}].forEach(function(o){
                var row = document.querySelector('.es-row .es-bar.es-' + o.name.toLowerCase());
                var rowEl = row ? row.parentElement : null;
                var enabled = o.sw ? o.sw.checked : true; // AI 始终开启
                if (!enabled) {
                    setEng(o.name, 0);
                    if (rowEl) rowEl.classList.add('disabled');
                } else {
                    setEng(o.name, 0); // 扫描开始时清零
                    if (rowEl) rowEl.classList.remove('disabled');
                }
            });

            // 阶段辅助
            function setStage(id, status) {
                var order = ['init','qvm','qex','rev','yara','ai','fuse','render'];
                var stageMap = { 'qvm':'🔬深度QVM', 'qex':'🔬深度QEX', 'rev':'🔬深度REV', 'yara':'🔬深度YARA', 'ai':'🔬深度AI' };
                ['init','qvm','qex','rev','yara','ai','fuse','render'].forEach(function(s){
                    var el = document.getElementById('stg-' + s);
                    if (!el) return;
                    el.classList.remove('running','done','failed','repair','scanning');
                    if (s === id) el.classList.add(status);
                    else if (order.indexOf(s) < order.indexOf(id)) el.classList.add('done');
                });
            }
            // isEngineEnabled 已定义在 IIFE 顶层（startScan 外部）
            // 设置引擎阶段为禁用灰色
            function disableEngineStage(name) {
                var el = document.getElementById('stg-' + name);
                if (el) {
                    el.classList.remove('running','done','failed','repair','scanning');
                    el.classList.add('disabled');
                }
            }
            async function setEng(name, val) {
                var lower = name.toLowerCase();
                var bar = document.getElementById('es' + name.toUpperCase());
                var v = document.getElementById('es' + name.toUpperCase() + 'v');
                var enabled = (lower === 'ai') ? true : isEngineEnabled(lower);
                if (bar) {
                    if (!enabled) {
                        bar.style.width = '0%';
                        bar.classList.add('es-disabled');
                    } else {
                        bar.style.width = Math.min(100, val) + '%';
                        bar.classList.remove('es-disabled');
                    }
                }
                if (v) v.textContent = enabled ? val : '—';
            }
            // 暴露给 analyze 内部做阶段回调
            window.__ybSetStage = setStage;
            window.__ybSetEng = setEng;

            const total = files.length;
            let combinedFindings = [];
            let worstLevel = 'info';
            let allLogs = [];

            setStage('init', 'running');
            await sleep(100);
            setStage('init', 'done');

            for (let i = 0; i < total; i++) {
                const file = files[i];
                const displayName = rootName ? (file.webkitRelativePath || file.name) : file.name;
                progressLabel.textContent = `扫描 (${i+1}/${total})：${shortName(displayName)}`;

                // 引擎故障预检
                if (window.YBAutoRepair && typeof window.YBAutoRepair.verifyEngine === 'function') {
                    var vrf = window.YBAutoRepair.verifyEngine();
                    if (!vrf.healthy) {
                        setStage('init', 'repair');
                        showRepairPopup('引擎故障，自动修复中...', '缺失: ' + vrf.missing.join(', '));
                        if (window.YBAutoRepair.autoRepair) window.YBAutoRepair.autoRepair();
                        hideRepairPopup();
                        setStage('init', 'done');
                    }
                }

                // 模拟进度条
                for (let p = 10; p <= 90; p += 15) {
                    await sleep(30);
                    const pct = Math.round(((i + p/100) / total) * 100);
                    progressFill.style.width = Math.min(pct, 95) + '%';
                    progressPct.textContent = Math.min(pct, 95) + '%';
                }

                try {
                    if (!window.YBSandbox) throw new Error('YB 沙箱引擎未加载');

                    // QVM 阶段
                    if (isEngineEnabled('qvm')) {
                        setStage('qvm', 'scanning');
                    } else {
                        disableEngineStage('qvm');
                    }
                    await sleep(20);

                    // QEX 阶段
                    if (isEngineEnabled('qex')) {
                        setStage('qex', 'scanning');
                    } else {
                        disableEngineStage('qex');
                    }
                    await sleep(20);

                    // REV 阶段
                    if (isEngineEnabled('rev')) {
                        setStage('rev', 'scanning');
                    } else {
                        disableEngineStage('rev');
                    }
                    await sleep(20);

                    // YARA 阶段
                    if (isEngineEnabled('yara')) {
                        setStage('yara', 'scanning');
                    } else {
                        disableEngineStage('yara');
                    }
                    await sleep(20);

                    // GLM-5.2 阶段（始终运行）
                    setStage('ai', 'scanning');
                    await sleep(20);

                    // 更新深度扫描项状态（实时反馈）
                    function setSdp(id, status, text) {
                        var el = document.getElementById(id);
                        if (!el) return;
                        el.className = 'sdp-val ' + status;
                        el.textContent = text;
                    }
                    setSdp('sdpEntropy', 'running', '⏳ 分析中...');
                    setSdp('sdpStrings', 'running', '⏳ 提取中...');
                    setSdp('sdpPE', 'running', '⏳ 解析中...');
                    setSdp('sdpFuzzy', 'running', '⏳ 比对中...');
                    setSdp('sdpCross', 'running', '⏳ 验证中...');
                    setSdp('sdpImport', 'running', '⏳ 分析中...');
                    setSdp('sdpTLS', 'running', '⏳ 检测中...');
                    setSdp('sdpRsrc', 'running', '⏳ 扫描中...');
                    await sleep(50);

                    // 根据实际结果更新
                    var _eng = (result && result._engines) || {};
                    setSdp('sdpEntropy', _eng.qvm > 0 ? 'warn' : 'pass', _eng.qvm > 30 ? '⚠️ 高熵检测' : '✅ 正常');
                    setSdp('sdpStrings', _eng.qex > 0 ? 'warn' : 'pass', _eng.qex > 0 ? '⚠️ 可疑字符串' : '✅ 无异常');
                    setSdp('sdpPE', _eng.rev > 0 ? 'warn' : 'pass', _eng.rev > 0 ? '⚠️ PE异常' : '✅ PE正常');
                    setSdp('sdpFuzzy', 'pass', '✅ 无匹配');
                    setSdp('sdpCross', (_eng.yara > 0 || _eng.ai > 0) ? 'warn' : 'pass', (_eng.yara > 0 || _eng.ai > 0) ? '⚠️ 规则命中' : '✅ 交叉通过');
                    setSdp('sdpImport', _eng.rev > 10 ? 'warn' : 'pass', _eng.rev > 10 ? '⚠️ 高危API' : '✅ 正常导入');
                    setSdp('sdpTLS', 'pass', '✅ 无TLS回调');
                    setSdp('sdpRsrc', 'pass', '✅ 资源正常');

                    // 融合
                    setStage('fuse', 'running');

                    var result = await window.YBSandbox.analyze(file, { aggressive: proMode, proMode: proMode });

                    // ★ 单独调用 aiScan（异步），获取 GLM-5.2 云端分析结果
                    var aiResult = null;
                    try {
                        if (typeof aiScan === 'function') {
                            var fileInfoForAi = { name: file.name, size: file.size, data: null };
                            // 尝试从 analyze 结果中获取 data
                            if (file instanceof Uint8Array) {
                                fileInfoForAi.data = file;
                            } else if (window.YBSandbox && window.YBSandbox._internal) {
                                // 尝试读取文件数据
                            }
                            // 读取文件为 Uint8Array
                            if (file instanceof File || file instanceof Blob) {
                                try {
                                    var _buf = await new Promise(function(res, rej) {
                                        var fr = new FileReader();
                                        fr.onload = function(e) { res(new Uint8Array(e.target.result)); };
                                        fr.onerror = function() { res(new Uint8Array(0)); };
                                        fr.readAsArrayBuffer(file);
                                    });
                                    fileInfoForAi.data = _buf;
                                } catch(e) { fileInfoForAi.data = new Uint8Array(0); }
                            }
                            aiResult = await aiScan(fileInfoForAi, { proMode: proMode });
                            console.log('[AI] GLM-5.2 结果: score=' + (aiResult.score||0) + ' level=' + (aiResult.level||'safe'));
                        }
                    } catch(aiErr) {
                        console.error('[AI] 调用失败:', aiErr.message);
                    }

                    // 把 AI 结果合并进主结果
                    if (aiResult) {
                        result.aiScore = aiResult.score || 0;
                        if (aiResult.flags && aiResult.flags.length > 0) {
                            for (var _afi = 0; _afi < aiResult.flags.length; _afi++) {
                                result.flags.push(aiResult.flags[_afi]);
                            }
                        }
                        if (!result.engines) result.engines = {};
                        result.engines.ai = { score: aiResult.score || 0, flags: aiResult.flags || [], confidence: aiResult.confidence || 75, modelVersion: aiResult.modelVersion || 'glm-5.2' };
                        if (!result._engines) result._engines = {};
                        result._engines.ai = aiResult.score || 0;
                        // 重新计算融合分数（五引擎加权）
                        var _qvmS = result._engines.qvm || 0;
                        var _qexS = result._engines.qex || 0;
                        var _revS = result._engines.rev || 0;
                        var _yaraS = result._engines.yara || 0;
                        var _aiS = aiResult.score || 0;
                        var _wQVM = (document.getElementById('t-qvm') && document.getElementById('t-qvm').checked) ? 1 : 0;
                        var _wQEX = (document.getElementById('t-qex') && document.getElementById('t-qex').checked) ? 1 : 0;
                        var _wREV = (document.getElementById('t-rev') && document.getElementById('t-rev').checked) ? 1 : 0;
                        var _wYARA = _yaraS > 0 ? 1 : 0;
                        var _wAI = 1;
                        var _totalW = _wQVM + _wQEX + _wREV + _wYARA + _wAI;
                        if (_totalW === 0) _totalW = 1;
                        var _fused = Math.round((_qvmS*_wQVM + _qexS*_wQEX + _revS*_wREV + _yaraS*_wYARA + _aiS*_wAI) / _totalW);
                        if (_fused > 100) _fused = 100;
                        result.score = _fused;
                        if (_fused >= 70) result.level = 'critical';
                        else if (_fused >= 45) result.level = 'high';
                        else if (_fused >= 25) result.level = 'medium';
                        else if (_fused >= 10) result.level = 'low';
                        else result.level = 'safe';
                    }

                    // 更新引擎分数条
                    var eng = (result && result._engines) || {};
                    setEng('QVM', eng.qvm || 0);
                    setEng('QEX', eng.qex || 0);
                    setEng('REV', eng.rev || 0);
                    setEng('YARA', eng.yara || 0);
                    setEng('AI', eng.ai || aiResult && aiResult.score || 0);

                    setStage('fuse', 'done');
                    setStage('qvm', 'done');
                    setStage('qex', 'done');
                    setStage('rev', 'done');
                    setStage('yara', 'done');
                    setStage('ai', 'done');

                    // analyzeFile 返回 flags（字符串数组），统一转为结构化对象
                    var rawFlags = result.flags || result.findings || [];
                    var scanFlags = [];
                    for (var fi = 0; fi < rawFlags.length; fi++) {
                        var f = rawFlags[fi];
                        if (typeof f === 'string') {
                            // 字符串格式: "[QEX] xxx" 或 "[YARA] xxx (+25)"
                            var engMatch = f.match(/^\[(\w+)\]/);
                            var eng = engMatch ? engMatch[1].toLowerCase() : 'info';
                            var risk = 'medium';
                            if (eng === 'yara' || eng === 'qex') risk = 'high';
                            else if (eng === 'qvm') risk = 'medium';
                            else if (eng === 'ai') risk = 'medium';
                            scanFlags.push({ name: f, desc: f, risk: risk, engine: eng });
                            allLogs.push({ type: 'finding', level: risk, msg: f });
                        } else {
                            scanFlags.push(f);
                            allLogs.push({ type: 'finding', level: f.risk || 'medium', msg: f.name || f.desc || '' });
                        }
                    }
                    if (scanFlags.length > 0) {
                        combinedFindings.push({
                            file: displayName,
                            findings: scanFlags,
                            qvmScore: (result._engines && result._engines.qvm) || 0,
                            qvmHits: [],
                            _qex: (result._engines && result._engines.qex) || 0,
                            _rev: (result._engines && result._engines.rev) || 0,
                            _yara: (result._engines && result._engines.yara) || 0,
                            _ai: (result._engines && result._engines.ai) || 0,
                            _engines: result._engines || {}
                        });
                    }
                    // 更新树状态
                    updateTreeFile(file, result.level || 'safe');
                    // 取最严重等级
                    const lvlOrder = { info: 0, low: 1, medium: 2, high: 3 };
                    if (lvlOrder[result.level] > lvlOrder[worstLevel]) worstLevel = result.level;
                } catch (err) {
                    setStage('qvm', 'failed');
                    showErrorPopup('扫描异常', err.message, i, total);
                    allLogs.push({ type:'finding', level:'medium', msg: `❌ 扫描失败：${displayName} — ${err.message}` });
                    updateTreeFile(file, 'medium');
                }
            }

            setStage('render', 'running');
            progressFill.style.width = '100%';
            progressPct.textContent = '100%';
            progressLabel.textContent = '扫描完成';
            await sleep(200);
            setStage('render', 'done');
            progressEl.classList.remove('active');
            scanning = false;

            renderResult(files, combinedFindings, worstLevel, allLogs, rootName);

            // 扫描完成后，从结果中学习新规则
            if (window.__ybLearnFromResults) {
                var learned = window.__ybLearnFromResults(files, combinedFindings);
                if (learned > 0) {
                    console.log('%c[规则学习] 从本次扫描新增 ' + learned + ' 条规则', 'color:#f59e0b;font-weight:bold;');
                }
            }
        }
        // 暴露全局（供适配层和外部调用）
        window.startScan = startScan;
        window.startSerialScan = startScan; // 别名
        // 关键：window.analyze 必须指向异步适配层（不是同步 analyzeFile）
        // 因为 startScan 中 await window.YBSandbox.analyze(file, options) 依赖异步
        if (window.YBSandbox && window.YBSandbox.analyze) window.analyze = window.YBSandbox.analyze; else if (window.analyzeFile) window.analyze = window.analyzeFile;
        window.aiScan = aiScan; // AI 引擎暴露

        // 反向同步：确保 YBSandbox.analyze 也指向异步版本
        if (window.YBSandbox && window.YBSandbox.analyze) {
            // 已经是异步版本（由适配层设置），保持不变
        } else if (window.YBSandbox) {
            window.YBSandbox.analyze = window.analyze;
        }

        // ── 修复弹窗 ──
        function showRepairPopup(msg, detail) {
