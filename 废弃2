function yaraScan(fileInfo, options) {
  options=options||{};
  var aggressive=options.aggressive||options.proMode||false;
  var result = { score:0, matches:[], severityCounts:{low:0,medium:0,high:0,critical:0}, engine:'YARA', ruleCount:YARA_RULES.length };
  try {
    if (!fileInfo || !fileInfo.data) return result;
    var uint8 = (fileInfo.data instanceof Uint8Array) ? fileInfo.data : new Uint8Array(fileInfo.data);
    // 转换为文本（只取前 64KB 做规则匹配）
    var len = Math.min(uint8.length, 65536);
    var chars = [];
    for (var i = 0; i < len; i++) {
      var c = uint8[i];
      chars.push((c >= 32 && c < 127) ? String.fromCharCode(c) : ' ');
    }
    var content = chars.join('');

    for (var ri = 0; ri < YARA_RULES.length; ri++) {
      var rule = YARA_RULES[ri];
      var matched = false;
      // 自定义匹配函数优先
      if (typeof rule.custom === 'function') {
        try { matched = rule.custom(content, uint8); } catch(e) { matched = false; }
      }
      // 字符串匹配（文本 + 二进制双模式）
      if (!matched) {
        var hitCount = 0;
        for (var si = 0; si < rule.strings.length; si++) {
          var s = rule.strings[si];
          if (content.indexOf(s) !== -1) {
            hitCount++;
          } else {
            // 二进制回退匹配（防止特殊字符被空格替换导致漏检）
            var sb = [];
            for (var _bi = 0; _bi < s.length; _bi++) sb.push(s.charCodeAt(_bi));
            var _found = false;
            for (var _bj = 0; _bj <= uint8.length - sb.length && !_found; _bj++) {
              var _ok = true;
              for (var _bk = 0; _bk < sb.length; _bk++) {
                if (uint8[_bj + _bk] !== sb[_bk]) { _ok = false; break; }
              }
              if (_ok) _found = true;
            }
            if (_found) hitCount++;
          }
        }
        if (rule.matchAll) {
          matched = (hitCount === rule.strings.length);
        } else {
          matched = (hitCount > 0);
        }
      }
      if (matched) {
        result.matches.push({ rule:rule.id, name:rule.name, severity:rule.severity, score:rule.score });
        result.score += rule.score;
        if (result.severityCounts[rule.severity] !== undefined) {
          result.severityCounts[rule.severity]++;
        }
      }
    }
    if (result.score > 100) result.score = 100;
    // 强力模式：YARA 权重×1.3
    if (aggressive && result.score > 0) {
      result.score = Math.round(result.score * 1.3);
      if (result.score > 100) result.score = 100;
    }
  } catch(e) {
    // 异常时安全返回
    console.error('[YARA] 扫描异常: ' + e.message);
  }
  return result;
}

