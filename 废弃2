    if(yaraR.matches&&yaraR.matches.length){ for(var yfi=0;yfi<yaraR.matches.length;yfi++){ result.flags.push('[YARA] '+yaraR.matches[yfi].name+' (+'+yaraR.matches[yfi].score+')'); } }
    result.engines.yara={score:yaraR.score||0,matches:yaraR.matches||[],severityCounts:yaraR.severityCounts||{}}; result._engines.yara=yaraR.score||0;
    var ai={score:0,flags:[]};
