        for(var si2=0;si2<strs.length;si2++){
          if(highSensRules[hsi].pat.test(strs[si2])){
            score+=highSensRules[hsi].sc;
            var hd='[强力]'+highSensRules[hsi].desc;
            if(flags.indexOf(hd)===-1) flags.push(hd);
            break;
          }
        }
      }
      // 强力模式：熵值阈值降低（更敏感）
      if(ent>7.0 && ent<=7.5){ score+=10; if(flags.indexOf('[强力]中高熵值')===-1) flags.push('[强力]中高熵值 '+ent.toFixed(2)); }
      // 强力模式：极小文件更敏感
      if(buf.length<8192&&buf.length>0){ score+=8; if(flags.indexOf('[强力]极小文件')===-1) flags.push('[强力]极小文件 ('+formatSize(buf.length)+')'); }
    }
  }catch(e){
    log('scoreFile 异常: '+e.message,'err');
    return {score:0,flags:['评分异常: '+e.message],level:'unknown',details:{}};
  }
  if(score>100) score=100;
  // 强力模式等级映射（阈值降低30%）
  if(aggressive){
    if(score>=42) level='critical';
    else if(score>=24) level='high';
    else if(score>=10) level='medium';
    else level='low';
  }else{
    if(score>=70) level='critical';
    else if(score>=45) level='high';
    else if(score>=25) level='medium';
    else if(score>=10) level='low';
