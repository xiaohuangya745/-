// ===== 逆向评分 =====
function scoreReverse(peResult){
  var score=peResult.riskScore||0;
  var matched=[];
  for(var i=0;i<SEQUENCE_RULES.length;i++){
    var rule=SEQUENCE_RULES[i];
    var has=true;
    for(var j=0;j<rule.apis.length;j++){ if(peResult.apis.indexOf(rule.apis[j])<0){ has=false; break; } }
    if(has){ score+=rule.score; matched.push(rule.desc); }
  }
  // API 单项加分
  for(var k=0;k<peResult.apis.length;k++){
    var apiLower=peResult.apis[k].split('.').pop().toLowerCase();
    if(API_RISK_TABLE[apiLower]){ score+=API_RISK_TABLE[apiLower]; }
  }
  if(score>100) score=100;
  return {score:score,matched:matched,apis:peResult.apis.length,sections:peResult.sections.length,flags:peResult.flags};
}

