        }

        .explanation.correct-explain {
            background: rgba(16,185,129,0.08);
            border: 1px solid rgba(16,185,129,0.2);
        }

        .explanation.wrong-explain {
            background: rgba(239,68,68,0.08);
            border: 1px solid rgba(239,68,68,0.2);
        }

        .next-btn {
            display: block;
            margin: 30px auto 0;
            padding: 14px 40px;
            border-radius: 10px;
            border: none;
            background: var(--gradient-1);
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .next-btn:hover {
