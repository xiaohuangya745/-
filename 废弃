            });
            clearTimeout(timer);
            if (bar) bar.style.width = '80%';

            const result = await resp.json().catch(() => ({}));

            if (resp.ok) {
                if (bar) bar.style.width = '100%';
                const issueUrl = result.html_url || '';
                return { success: true, method: 'worker', status: resp.status, issueUrl: issueUrl, issueNumber: result.number };
            }

            // Worker 返回错误
            const errMsg = `Worker ${resp.status}: ${result.message || result.error || ''}`;
            throw new Error(errMsg);
        } catch(e1) {
            console.warn('[反馈] Worker 提交失败:', e1.message);
            // 方法2：XMLHttpRequest 兜底
            try {
                if (bar) bar.style.width = '60%';
                const xhr = new XMLHttpRequest();
                xhr.open('POST', url, false); // 同步
                xhr.setRequestHeader('Content-Type', 'application/json; charset=utf-8');
                xhr.setRequestHeader('User-Agent', 'SecurityCenter-Feedback');
                xhr.send(JSON.stringify(payload));
                if (xhr.status >= 200 && xhr.status < 300) {
                    if (bar) bar.style.width = '100%';
                    let r = {};
                    try { r = JSON.parse(xhr.responseText); } catch(e) {}
                    return { success: true, method: 'worker-xhr', status: xhr.status, issueUrl: r.html_url || '', issueNumber: r.number };
                }
                throw new Error('XHR ' + xhr.status + ': ' + xhr.statusText);
            } catch(e2) {
                // 方法3：指数退避重试
                if (retryCount < CLOUD_CONFIG.maxRetries) {
                    const delay = CLOUD_CONFIG.retryBase * Math.pow(2, retryCount);
                    if (bar) { bar.style.width = '50%'; bar.style.background = 'linear-gradient(90deg,#f59e0b,#ef4444)'; }
                    await new Promise(r => setTimeout(r, Math.min(delay, 10000)));
                    return submitToCloud(report, retryCount + 1);
                }
                // 全部失败 → 返回失败
                return { success: false, method: 'none', error: e2.message || '网络不可达' };
            }
        }
    }

