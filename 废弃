    // ===== 设置中心：兼容性 + 性能 =====
    const SETTINGS_KEY = 'cyberSecSettings';

    const PERF_PRESETS = {
        eco:     { particles: 0,  blur: 0,  shadow: 0, animation: 0, label: '节能' },
        smooth:  { particles: 0,  blur: 2,  shadow: 1, animation: 1, label: '流畅' },
        medium:  { particles: 15, blur: 6,  shadow: 1, animation: 1, label: '中等' },
        strong:  { particles: 30, blur: 12, shadow: 2, animation: 1, label: '强劲' },
        ultra:   { particles: 60, blur: 20, shadow: 3, animation: 1, label: '卓越' }
    };

    function defaultSettings() {
        return {
            browser: 'auto',   // 'auto' | 'edge' | 'chrome' | 'firefox' | 'ie' | 'mobile'
            perf: 'medium',    // eco | smooth | medium | strong | ultra
            perfMode: false    // 性能模式（全局省电）
        };
    }

    function loadSettings() {
        try {
            const raw = localStorage.getItem(SETTINGS_KEY);
            if (!raw) return defaultSettings();
            const s = JSON.parse(raw);
            return Object.assign(defaultSettings(), s);
        } catch(e) { return defaultSettings(); }
    }

    function saveSettings(s) {
        try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(s)); } catch(e) {}
    }

    let appSettings = loadSettings();

    // --- 设备 + 浏览器检测 ---
    function detectClient() {
        const ua = navigator.userAgent || '';
        const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
        const vw = Math.min(window.innerWidth || 9999, window.innerHeight || 9999);
        const isMobile = isTouch && vw < 768;

        let browser = 'chrome';
        if (/Edg\//.test(ua)) browser = 'edge';
        else if (/Edge\//.test(ua)) browser = 'ie';
        else if (/MSIE |Trident\//.test(ua)) browser = 'ie';
        else if (/Firefox\//.test(ua)) browser = 'firefox';
        else if (/Chrome\//.test(ua)) browser = 'chrome';
        else if (/Safari\//.test(ua)) browser = 'chrome';

        return { isMobile, browser };
    }

    // --- 应用兼容性设置 ---
    function applyCompatibility(browserKey) {
        // 清除旧 class
        document.body.classList.remove('compat-edge','compat-chrome','compat-firefox','compat-ie','compat-mobile');
        document.body.classList.add('compat-' + browserKey);

        // 性能预设根据兼容性微调
        const presets = {
            'edge':   { backdrop: 1.0, saturate: 1.15 },
            'chrome': { backdrop: 1.0, saturate: 1.0  },
            'firefox':{ backdrop: 0.7, saturate: 0.9  },
            'ie':     { backdrop: 0.0, saturate: 0.0  },
            'mobile': { backdrop: 0.6, saturate: 0.85 }
        };
        const p = presets[browserKey] || presets.chrome;
        document.documentElement.style.setProperty('--backdrop-strength', p.backdrop);
        document.documentElement.style.setProperty('--saturate-strength', p.saturate);

        // IE / 深度兼容：强制降级
        if (browserKey === 'ie') {
            document.body.classList.add('compat-deep');
        }

        // 手机端：关闭 hover 依赖样式，启用触控优化
        if (browserKey === 'mobile') {
            document.body.classList.add('touch-optimized');
        }
    }

    // --- 应用性能设置 ---
    function applyPerformance() {
        const s = appSettings;
        let presetKey = s.perf;
        // 性能模式开启 → 强制降到 smooth 或 eco（手机端 eco）
        if (s.perfMode) {
            presetKey = s.browser === 'mobile' || detectClient().isMobile ? 'eco' : 'smooth';
        }
        const p = PERF_PRESETS[presetKey];

        // CSS 变量驱动视觉效果
        document.documentElement.style.setProperty('--particle-count', p.particles);
        document.documentElement.style.setProperty('--blur-radius', p.blur + 'px');
        document.documentElement.style.setProperty('--shadow-strength', p.shadow);
        document.documentElement.style.setProperty('--anim-enabled', p.animation);

        // 粒子数量控制
        const container = document.getElementById('bgAnimation');
        if (container) {
            const spans = container.querySelectorAll('span');
            if (p.particles === 0) {
                spans.forEach(sp => sp.style.display = 'none');
            } else {
                spans.forEach((sp, i) => {
                    sp.style.display = i < p.particles ? '' : 'none';
                });
            }
        }

        // 全局动画开关
        if (p.animation === 0) {
            document.body.classList.add('no-anim');
        } else {
            document.body.classList.remove('no-anim');
        }

        // 更新性能详情面板
        const setText = (id, txt, on) => {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = txt;
            el.className = 'pd-value ' + (on ? 'on' : 'off');
        };
        setText('pdParticles', p.particles === 0 ? '关闭' : p.particles + ' 颗', p.particles > 0);
        setText('pdBlur',      p.blur === 0 ? '关闭' : p.blur + 'px', p.blur > 0);
        setText('pdShadow',    p.shadow === 0 ? '关闭' : '×' + p.shadow, p.shadow > 0);
        setText('pdAnimation', p.animation === 0 ? '关闭' : '开启', p.animation > 0);

        // 性能模式徽章
        const badge = document.getElementById('perfModeBadge');
        if (badge) badge.style.display = s.perfMode ? '' : 'none';
    }

