            const resp = await fetch(probeUrl, {
                method: 'GET',
                mode: 'cors',
                cache: 'no-cache',
                signal: ctrl.signal
            });
            clearTimeout(timer);

            // Worker 在线（返回 405 Method Not Allowed 是正常响应，说明 Worker 在运行）
            if (resp.status === 405 || resp.status === 200) {
