        studyUnlocked = false;
        saveStudy(studyState);

        // 清空输入
        if (input) input.value = '';
        if (confirmInput) { confirmInput.value = ''; confirmInput.style.display = 'none'; }

        renderStudyUI();
        showSettingsToast('✅ 密码已设置，学习模式已开启');

        // 跳回首页（如果当前在非允许页）
        const cur = document.querySelector('.page.active');
        if (cur) {
            const id = cur.id.replace('page-', '');
            if (!isPageAllowed(id)) navigateTo('home');
        }
    }

    // 密码验证（关闭时）
    async function onPasswordVerify() {
        clearPwdErrors();
