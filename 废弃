                const perfKey = appSettings.perf || 'medium';
                const perfMode = !!appSettings.perfMode;
                if (window.GameAPI) {
                    GameAPI.start({
                        difficulty: fpsDifficulty,
                        perfKey: perfKey,
                        perfMode: perfMode
