        const menu = document.getElementById('gameMenu');
        if (menu) menu.style.display = '';
        // 更新最佳分数
        const stats = window.GameAPI.getStats ? window.GameAPI.getStats() : null;
        const best = localStorage.getItem('fps_best') || '0';
        const bsEl = document.getElementById('gameBestScore');
        if (bsEl) bsEl.textContent = '🏅 最佳：' + best;
