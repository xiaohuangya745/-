    // ---- 答题逻辑 ----
    function battleAnswer(myAns){
        if(state.answered) return;
        state.answered=true;
        stopTimer();
        const q=state.questions[state.qIdx];
        const opp=state.opponent;
        const meRight = myAns===null?false:(myAns===q.a);
        const oppRight = aiAnswer(q,opp);

        if(meRight) state.score+=10+state.timeLeft;
        if(oppRight) state.oppScore+=8+Math.floor(Math.random()*5);

        state.history.push({q:q.q,meRight,oppRight,cat:q.cat,diff:q.diff});
        if(meRight) state.myStreak++; else state.myStreak=0;

        // 反馈
        const fb=$('bqFeedback');
        const btnT=$('btnTrue'),btnF=$('btnFalse');
        if(btnT&&btnF){
            btnT.disabled=true;btnF.disabled=true;
            if(meRight){btnT.className+=' correct';btnF.className+=' disabled';}
            else{btnF.className+=' wrong';btnT.className+=' disabled';}
        }
        if(fb){
            fb.style.display='block';
            if(meRight){
                fb.className='bq-feedback correct';
                fb.innerHTML=`🎉 <strong>正确！+${10+state.timeLeft}分</strong><br><small>${q.exp}</small>`;
            } else if(myAns===null){
                fb.className='bq-feedback wrong';
                fb.innerHTML=`⏰ <strong>时间到！</strong><br>正确答案：${q.a?'✓ 正确':'✗ 错误'}<br><small>${q.exp}</small>`;
            } else {
                fb.className='bq-feedback wrong';
                fb.innerHTML=`❌ <strong>错误！</strong><br>正确答案：${q.a?'✓ 正确':'✗ 错误'}<br><small>${q.exp}</small>`;
            }
        }

        // 检查是否有人先赢3局
        const myWins=state.history.filter(h=>h.meRight&&!h.oppRight).length;
        const oppWins=state.history.filter(h=>h.oppRight&&!h.meRight).length;

        setTimeout(()=>{
            if(state.inOvertime){
                // 加时赛：领先2局才算赢，否则继续
                if(myWins-oppWins>=2){state.overtimeWinner=true;battleEnd();return;}
                if(oppWins-myWins>=2){state.overtimeWinner=false;battleEnd();return;}
                // 安全上限：最多加时15轮
                if(state.overtimer>=15){battleEnd();return;}
                state.qIdx=(state.qIdx+1)%state.questions.length;
                renderBattle();
                return;
            }
            if(myWins>=3 || oppWins>=3){
                battleEnd();
            } else if(myWins===2 && oppWins===2){
                // 进入加时赛：越往后越难
                state.inOvertime=true;
                state.overtimer++;
                const ot=state.overtimer;
                // 第N轮加时只保留 diff>= (3+N) 的题，最低保底 diff>=3
                const minDiff=Math.min(5, 2+ot);
                const harder=state.questions.filter(x=>x.diff>=minDiff);
                if(harder.length>0){
                    state.questions=shuffle(harder);
                }
                // 加时赛不限时题目数，持续直到一方领先2局
                renderBattle();
            } else {
                state.qIdx=(state.qIdx+1)%state.questions.length;
                renderBattle();
            }
        },3000);
    }

