    function createParticles() {
        const container = document.getElementById('bgAnimation');
        for (let i = 0; i < 50; i++) {
            const particle = document.createElement('span');
            particle.style.left = Math.random() * 100 + '%';
            particle.style.animationDelay = Math.random() * 15 + 's';
            particle.style.animationDuration = (10 + Math.random() * 10) + 's';
            const size = 2 + Math.random() * 4;
            particle.style.width = size + 'px';
            particle.style.height = size + 'px';
            container.appendChild(particle);
        }
    }
    createParticles();

    // ===== 页面导航 =====
    function navigateTo(page) {
        try {
            // 离开联机页时，清理所有定时器和弹窗
            if (page !== 'battle') {
                if (typeof _clearAllTimers === 'function') _clearAllTimers();
                if (typeof window._battleCleanup === 'function') window._battleCleanup();
            }
            // 隐藏可能残留的弹窗
            const reportOverlay = document.getElementById('reportOverlay');
            if (reportOverlay) {
                reportOverlay.classList.remove('show');
                reportOverlay.style.display = '';
            }
            const reportStatus = document.getElementById('reportStatus');
            if (reportStatus) {
                reportStatus.style.display = 'none';
                reportStatus.className = '';
            }
            // 隐藏浏览器提示条
            const browserBar = document.getElementById('browserBar');
            if (browserBar) browserBar.style.display = 'none';

            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
            const targetPage = document.getElementById('page-' + page);
            if (targetPage) targetPage.classList.add('active');
            const navLink = document.querySelector(`[data-page="${page}"]`);
            if (navLink) navLink.classList.add('active');
            if (window.scrollTo) { try { window.scrollTo(0, 0); } catch(e) {} }

            if (page === 'score') updateScorePage();
            if (page === 'battle' && typeof window._battleCleanup === 'function') window._battleCleanup();
            if (page === 'practice') initPracticePage();
            if (page === 'battle') {
                if (typeof enterBattlePage === 'function') enterBattlePage();
            }
        } catch(e) {
            console.error('navigateTo error:', e);
            try {
                document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
                const tp = document.getElementById('page-' + page);
                if (tp) tp.classList.add('active');
            } catch(e2) {}
        }
    }

    document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            navigateTo(link.dataset.page);
        });
    });

