        const baseKeywords = ['安全', '攻击', '防御', '风险', '漏洞', '检测'];

        // 按题目内容动态匹配领域关键词
        const domainMap = [
            { match: ['密码', 'password', '强度'], kws: ['密码', '哈希', '加盐', 'bcrypt', '熵', '长度', '随机', 'diceware', '强度'] },
            { match: ['钓鱼', 'phishing', '邮件'], kws: ['钓鱼', '域名', '发件人', 'homograph', '紧迫', '重定向', 'spf', 'dkim', '认证'] },
            { match: ['wifi', 'wi-fi', '无线'], kws: ['wpa3', 'wpa2', '加密', 'vlan', '隔离', 'radius', 'psk', '认证'] },
            { match: ['日志', 'log', '取证'], kws: ['日志', '提权', '持久化', '后门', '溯源', '入侵', 'cron', '凭据'] },
            { match: ['sql', '注入', 'injection'], kws: ['sql', '注入', '参数化', '黑名单', '绕过', 'union', '盲注', '预处理'] },
            { match: ['tls', '证书', '中间人', 'mitm', 'ssl'], kws: ['证书', '中间人', '指纹', '签发链', 'pinning', '加密', 'https'] },
            { match: ['逆向', '反编译', '二进制', 'elf'], kws: ['逆向', '反调试', '提权', '持久化', 'shell', 'c2', '无文件', '反编译'] },
            { match: ['侧信道', '功耗', '时序', 'timing', '故障'], kws: ['侧信道', '功耗', '时序', '故障注入', '电磁', '硬件', 'dpa', '防御'] },
            { match: ['内核', 'kernel', 'uaf', 'use-after'], kws: ['内核', 'uaf', '堆喷射', '虚表', '提权', 'cred', 'use-after-free'] },
            { match: ['apt', '勒索', '应急响应', '溯源'], kws: ['apt', '横向移动', '持久化', '隔离', '凭据', '应急响应', '勒索', 'dns隧道'] },
            { match: ['零日', '漏洞', '武器化', '0day', 'zeroday'], kws: ['零日', '竞态', '提权', 'hvci', '补丁', 'etw', '防御'] },
            { match: ['量子', 'qkd', 'pqc', 'kyber'], kws: ['量子', 'otp', '一次一密', 'grover', 'shor', 'pqc', '混合', 'harvest'] },
            { match: ['后门', 'backdoor', '模型', 'ai ', '模型'], kws: ['后门', '触发', '权重', '供应链', '对齐', 'rlhf', '张量', '水印'] },
            { match: ['信息论', '香农', '协议', '不可攻破'], kws: ['信息论', '香农', 'otp', 'qkd', '不可克隆', '侧信道', '端点', '拒绝服务'] }
        ];

        let domainKeywords = [];
        domainMap.forEach(domain => {
            if (domain.match.some(m => allText.includes(m))) {
                domainKeywords.push(...domain.keywords);
            }
        });

        // 从参考答案中提取高频重要词
        const answerKeywords = extractFromAnswer(correct);

        // 合并去重
        let result = [...new Set([...baseKeywords, ...domainKeywords, ...answerKeywords])];
        return result.slice(0, 15);
    }

    function extractFromAnswer(text) {
        // 从参考答案中提取有分量的专业词汇
        const proTerms = [
