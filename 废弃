                const vict = document.getElementById('victoryScreen');
                if (vict) vict.style.display = 'none';
                const perfKey = appSettings.perf || 'medium', perfMode = !!appSettings.perfMode;
                if (window.GameAPI) GameAPI.start({ difficulty: fpsDifficulty, perfKey, perfMode });
            });
        }
    }, 200);

    // 页面卸载时清理
    window.addEventListener('beforeunload', () => {
        if (window.GameAPI) GameAPI.stop();
    });
