    function calculateInnovationBonus(input, diff) {
        let bonus = 0;
        const text = input.toLowerCase();

        // 创新加分项
        const innovationSignals = [
            { pattern: /不同|对比|比较|vs|versus/, points: 5, label: '对比分析' },
            { pattern: /假设|如果|万一|极端/, points: 5, label: '假设推理' },
            { pattern: /结合|综合|整体|系统/, points: 5, label: '系统思维' },
            { pattern: /实际|现实|工程|落地|权衡/, points: 5, label: '工程思维' },
            { pattern: /防御|缓解|对策|建议|应该/, points: 3, label: '防御意识' },
            { pattern: /攻击|利用|绕过|突破/, points: 3, label: '攻击思维' },
            { pattern: /风险|威胁|暴露|危害/, points: 3, label: '风险评估' },
            { pattern: /检测|发现|识别|监控/, points: 3, label: '检测思维' },
            { pattern: /纵深|多层|冗余|备份/, points: 5, label: '纵深防御' },
            { pattern: /人|社会工程|培训|意识/, points: 3, label: '人的因素' }
        ];

        innovationSignals.forEach(signal => {
            if (signal.pattern.test(text)) {
                bonus += signal.points;
            }
        });

        // 难度系数
        const diffMultiplier = { easy: 0.5, medium: 0.8, hard: 1.0, expert: 1.2, insane: 1.5 }[diff] || 1;
        bonus = Math.round(bonus * diffMultiplier);

        return Math.min(bonus, 25);
    }

