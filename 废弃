    }

    // --- 进入设置页时刷新 UI ---
    const _origNavigate = navigateTo;
    navigateTo = function(page) {
        _origNavigate(page);
        if (page === 'settings') {
            const auto = detectClient();
            // 首次进入且为 auto → 应用检测结果
            if (appSettings.browser === 'auto') {
