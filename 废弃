    rifle:   { name: '步枪',   dmg: 18, rpm: 600,  mag: 30, reload: 2.0, auto: true,  spread: 0.03, recoil: 0.010, color: 0x226622 },
    sniper:  { name: '狙击枪', dmg: 80, rpm: 90,   mag: 5,  reload: 3.0, auto: false, spread: 0.001, recoil: 0.04,  color: 0x442222 }
  };

  // ---------- 游戏状态 ----------
  let scene, camera, renderer, raycaster;
