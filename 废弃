    function exportReports() {
        let reports = [];
        try {
            reports = JSON.parse(localStorage.getItem(REPORT_STORAGE_KEY)) || [];
        } catch(e) {}
        if (reports.length === 0) {
            showBrowserBar('📭 暂无上报记录', 'warning', 2500);
            return;
        }

        // 统计云端/本地
        const cloudCount = reports.filter(r => r.source && r.source.includes('cloud')).length;
        const localCount = reports.length - cloudCount;

        const data = JSON.stringify(reports, null, 2);
        const filename = `网络安全中心_意见反馈_${Date.now()}.json`;

        // Edge / Chrome：使用 Blob + URL.createObjectURL
        try {
            const blob = new Blob([data], { type: 'application/json;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.style.display = 'none';
            document.body.appendChild(a);
            if (a.click) a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 1000);
            showBrowserBar(`✅ 已导出 ${reports.length} 条记录（云端${cloudCount}+本地${localCount}）`, 'info', 3000);
        } catch(e1) {
            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(data);
                    showBrowserBar('📋 已复制上报数据到剪贴板', 'info', 3000);
                } else {
                    showBrowserBar('❌ 导出失败，请截图或手动复制', 'warning', 4000);
                }
            } catch(e2) {
                showBrowserBar('❌ 导出失败：' + e2.message, 'warning', 4000);
            }
        }
    }

    /**
     * 离线时排队，恢复网络后自动同步到云端
     */
    async function syncPendingReports() {
        if (!navigator.onLine) return;
        if (!cloudState.connected) {
            await checkCloudConnection();
        }
        if (!cloudState.connected) return;

        let reports = [];
        try { reports = JSON.parse(localStorage.getItem(REPORT_STORAGE_KEY)) || []; } catch(e) {}
        const pending = reports.filter(r => !r.synced && r.source !== 'synced');

        if (pending.length === 0) return;

        showBrowserBar(`☁️ 正在同步 ${pending.length} 条待发送反馈...`, 'info', 2000);

        let syncedCount = 0;
        for (const report of pending) {
            const result = await submitToCloud(report);
            if (result.success) {
                report.synced = true;
                report.syncedAt = new Date().toISOString();
                report.source = 'synced';
                syncedCount++;
            }
        }

        // 保存更新后的记录
        if (syncedCount > 0) {
            try { localStorage.setItem(REPORT_STORAGE_KEY, JSON.stringify(reports)); } catch(e) {}
            showBrowserBar(`☁️ 已同步 ${syncedCount} 条反馈到云端！`, 'info', 3000);
        }
    }

    // 网络恢复时自动同步
    window.addEventListener('online', () => {
        showBrowserBar('🌐 网络已恢复，正在同步云端...', 'info', 2000);
        setTimeout(syncPendingReports, 1000);
    });

    // 页面加载时检测云端
    window.addEventListener('load', () => {
        setTimeout(checkCloudConnection, 1500);
        // 如果有待同步的，尝试同步
        setTimeout(syncPendingReports, 3000);
    });

    // 页面即将关闭时，用 sendBeacon 尽力发送
    window.addEventListener('pagehide', () => {
        let reports = [];
        try { reports = JSON.parse(localStorage.getItem(REPORT_STORAGE_KEY)) || []; } catch(e) {}
        const pending = reports.filter(r => !r.synced && r.source !== 'synced');
        if (pending.length > 0 && cloudState.endpoint) {
            const url = cloudState.endpoint + '/batch';
            try {
                navigator.sendBeacon(url, new Blob([JSON.stringify(pending)], {type:'application/json'}));
            } catch(e) {}
        }
    });

