          matchedPatterns.push(m[0].slice(0,80));
          if (!firstMatch) firstMatch = m[0].slice(0,80);
        }
      }

      if (matchedPatterns.length > 0) {
        // 规则权重不受 trust 降权 (trust 只影响扩展名风险分)
        let w = r.w;
        if (matchedPatterns.length > 1) {
          w = Math.round(w * (1 + 0.3 * (matchedPatterns.length - 1)));
        }
        const adj = Math.round(w * mult * 10) / 10;
        const cB = r.conf * 5;
        const sc = Math.round((adj + cB) * 10) / 10;
        hits.push({rule:r, score:sc, matched:firstMatch,
          matchedCount:matchedPatterns.length,
          allMatches:matchedPatterns});
        if (r.dec) break; // 确凿恶意, 不再累加
      }
    }

    // ---- 汇总 ----
    let total = 0, decHit = null;
    for (const h of hits) {
      if (h.rule.dec) { decHit = h; break; }
      total += h.score;
    }
    if (decHit) total = 100;

    // ---- 扩展名加成 ----
    const extRisk = getExtRisk(ext, trust);
    if (extRisk && !decHit && total < 100) {
      total += extRisk.score;
      hits.push({rule:{id:extRisk.label,name:'高风险扩展名',cat:'risk'},score:extRisk.score,matched:ext});
    }

    // ---- 文件名本身含勒索扩展名 (独立于内容) ----
    if (!decHit && total < 100) {
      const lowerName = file.name.toLowerCase();
      if (/\.(wannacry|cryptolocker|cerber|locky|petya|badrabbit|ryuk|maze|sodinokibi|revil|conti|blackmatter|darkside|avaddon|hive|blackcat|gandcrab|stop|djvu|clop|egregor)\b/.test(lowerName) ||
          /\.(encrypted|locked|crypted|ransom|r4ns0m|crypz|cryp1|onion|vault|recover|restore|decrypt|payfor|givemefile)\b/.test(lowerName)) {
        total = 100;
        hits.push({rule:{id:'RANSOM_EXT',name:'勒索软件扩展名(文件名)',cat:'malware'},score:100,matched:file.name});
      }
    }

    // ---- 熵值加成 (仅二进制) ----
    const isBenignText = BENIGN_TEXT.has(ext);
    if (!decHit && total < 100) {
      if (ent > 7.95 && !isBenignText && magic.type !== 'text') total += 4;
      if (ent > 7.5 && magic.type === 'unknown_binary') total += 3;
      // 大文件加分 (二进制且 >100MB)
      if (file.size > 100*1024*1024 && magic.type !== 'text') total += 2;
    }

    // ---- 短 payload 奖励: SQLi/XSS 类小文件 → 直接升到 suspicious 底线 ----
    if (!decHit && total > 0 && total < 100) {
      const isShortPayload = (magic.type === 'text' || isBenignText) && file.size < 5000;
      const hasPayloadRule = hits.some(h => h.rule.id === 'SQLI_PAYLOAD' || h.rule.id === 'XSS_PAYLOAD');
      if (isShortPayload && hasPayloadRule && trust < 0.3) {
        // 典型注入 payload: 小文件 + 命中规则 → 至少 suspicious
        if (total >= 6) total = Math.max(total, 18);  // 直接拉到 suspicious 底线
      }
    }

    total = Math.min(100, Math.max(0, Math.round(total)));

    // ---- 分级 (v4.1 阈值上调以降低误报) ----
    let level, verdict;
    if (decHit) { level='high'; verdict='确凿恶意('+decHit.rule.name+')'; }
    else if (total >= 40) { level='high'; verdict='高风险'; }
    else if (total >= 18) { level='suspicious'; verdict='可疑'; }
    else if (total >= 8)  { level='low'; verdict='低风险'; }
    else { level='safe'; verdict='安全'; }

    return {score:total, level, verdict,
      hits: hits.sort((a,b)=>b.score-a.score).slice(0,15).map(h=>({
        id:h.rule.id,name:h.rule.name,cat:h.rule.cat,
        weight:h.rule.w,score:h.score,decisive:h.rule.dec,
        conf:h.rule.conf,matched:h.matched,
      })),
      whitelisted:false};
  }

  // ===== 主分析函数 =====
  function analyzeFile(file, opts) {
    opts = opts || {};
    const result = {
      filename:file.name, size:file.size, type:file.type||'unknown',
      ext:getExt(file.name), ts:Date.now(), level:'safe', score:0,
      verdict:'安全', hits:[], magic:null, entropy:0, strCount:0,
      whitelisted:false, whiteReason:'', scanTime:0
    };
    const t0 = (performance&&performance.now)?performance.now():Date.now();

    return new Promise(function(resolve){
      // 排除项检查
      let excl;
      try { excl = JSON.parse(localStorage.getItem('yb_exclusions')||'[]'); }
      catch(e) { excl = []; }
      const isEx = excl.some(function(ex){
        return (ex.type==='name'&&file.name===ex.value) ||
          (ex.type==='ext'&&getExt(file.name)===ex.value) ||
          (ex.type==='path'&&(file.webkitRelativePath||'').startsWith(ex.value));
      });
      if (isEx) { result.verdict='已排除(用户设置)'; resolve(result); return; }

      if (file.size > 200*1024*1024) {
        result.level='error'; result.verdict='文件过大(>200MB)'; resolve(result); return;
      }

      const reader = new FileReader();
      reader.onload = function(e){
        const buf = new Uint8Array(e.target.result);
        const mag = detectMagic(buf);
        const ent = entropy(buf);
        const strs = extractStrings(buf, 5);
        result.magic = mag;
        result.entropy = Math.round(ent*100)/100;
        result.strCount = strs.length;

        const sr = scoreFile(file, mag, ent, strs, opts);
        if (sr.whitelisted) {
          result.whitelisted = true; result.whiteReason = sr.reason;
          result.level='safe'; result.score=0; result.verdict='安全(白名单)';
        } else {
          result.score = sr.score; result.level = sr.level;
          result.verdict = sr.verdict; result.hits = sr.hits;
        }
        result.surness = sr.hits.length ? sr.hits[0].conf : 0;
        result.scanTime = Math.round(((performance&&performance.now)?performance.now():Date.now())-t0);
        resolve(result);
      };
      reader.onerror = function(){
        result.level='error'; result.verdict='读取失败'; resolve(result);
      };
      reader.readAsArrayBuffer(file);
    });
  }

  // ===== 文件夹批量 =====
  function analyzeFolder(files, opts) {
    opts = opts || {};
    const results = [];
    const stats = {total:files.length,safe:0,low:0,suspicious:0,high:0,error:0};
    return new Promise(function(resolveAll){
      function next(i){
        if (i>=files.length) { resolveAll({results,stats}); return; }
        analyzeFile(files[i], opts).then(function(r){
          results.push(r);
          switch(r.level){
            case'safe':stats.safe++;break;
            case'low':stats.low++;break;
            case'suspicious':stats.suspicious++;break;
            case'high':stats.high++;break;
            default:stats.error++;
          }
          if (opts.onProgress) opts.onProgress({
            current:i+1, total:files.length,
            percent:Math.round((i+1)/files.length*100),
            currentFile:files[i].name, result:r, stats:stats
          });
          setTimeout(function(){next(i+1);},0);
        });
      }
      next(0);
    });
  }

  // ===== ZIP 解包 =====
  function analyzeZip(file, opts) {
    opts = opts || {};
    return new Promise(function(resolve){
      const reader = new FileReader();
      reader.onload = function(e){
        const buf = e.target.result;
        const view = new DataView(buf);
        const bytes = new Uint8Array(buf);
        const findings = [];
        let eocd = -1;
        const start = Math.max(0, bytes.length-65558);
        for (let i=start; i<bytes.length-3; i++) {
          if (view.getUint32(i,true)===0x06054B50) { eocd=i; break; }
        }
        if (eocd===-1) { resolve([{type:"error",message:"ZIP: no EOCD"}]); return; }
        const cdCount = view.getUint16(eocd+10,true);
        let cdOff = view.getUint32(eocd+16,true);
        for (let i=0; i<cdCount; i++) {
          if (view.getUint32(cdOff,true)!==0x02014B50) break;
          const nl = view.getUint16(cdOff+28,true);
          const xl = view.getUint16(cdOff+30,true);
          const cl = view.getUint16(cdOff+32,true);
          const name = new TextDecoder('utf-8').decode(bytes.slice(cdOff+46, cdOff+46+nl));
          const hr = HIGH_RISK.has(getExt(name));
          findings.push({
            type:hr?'high':'info', filename:name,
            compressedSize:view.getUint32(cdOff+20,true),
            uncompressedSize:view.getUint32(cdOff+24,true),
            risk:hr?'高风险压缩包内容':'普通文件'
          });
          cdOff += 46+nl+xl+cl;
        }
        resolve(findings);
      };
      reader.onerror = function(){ resolve([{type:"error",message:"ZIP read failed"}]); };
      reader.readAsArrayBuffer(file);
    });
  }

  // ===== 公共 API =====
  // ===== 文件大小格式化工具（兜底版，防止外部调用时未定义）=====
  function formatSize(bytes) {
    if (bytes == null || isNaN(bytes)) return '未知';
    bytes = Number(bytes);
    if (bytes < 1024) return bytes + ' B';
    const units = ['KB','MB','GB','TB','PB'];
    let i = -1;
    do { bytes /= 1024; i++; } while (bytes >= 1024 && i < units.length - 1);
    return bytes.toFixed(bytes < 10 ? 2 : bytes < 100 ? 1 : 0) + ' ' + units[i];
  }

  const YBSandbox = {
    version: '4.2.1',
    analyzeFile,
    analyzeFolder,
    analyzeZip,
    detectMagic,
    shannonEntropy: entropy,
    extractStrings,
    formatSize: formatSize,
    RULES: RULES.map(function(r){
      return {id:r.id,name:r.name,w:r.w,dec:r.dec,cat:r.cat,strong:!!r.strong};
    }),
    exclusions: (function(){ try{return JSON.parse(localStorage.getItem('yb_exclusions')||'[]');}catch(e){return[];} })(),
    addExclusion: function(t,v){
      this.exclusions.push({type:t,value:v,addedAt:Date.now()});
      localStorage.setItem('yb_exclusions',JSON.stringify(this.exclusions));
    },
    removeExclusion: function(i){
      this.exclusions.splice(i,1);
      localStorage.setItem('yb_exclusions',JSON.stringify(this.exclusions));
    },
    getExclusions: function(){ return this.exclusions || []; },
  };

  global.YBSandbox = YBSandbox;
  global.YBQVM = {
    analyzeFile, analyzeFolder,
    version: '4.2.1',
    _internal: { scoreFile, RULES, getExt, SELF_FILES }
  };

})(typeof window !== 'undefined' ? window : this);

