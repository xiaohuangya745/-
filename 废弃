    function defaultStudy() {
        return { enabled: false };
    }

    function loadStudy() {
        try {
            const raw = localStorage.getItem(STUDY_KEY);
            if (!raw) return defaultStudy();
            return Object.assign(defaultStudy(), JSON.parse(raw));
        } catch(e) { return defaultStudy(); }
    }

    function saveStudy(s) {
        try { localStorage.setItem(STUDY_KEY, JSON.stringify(s)); } catch(e) {}
    }

    function getStoredHash() {
        return localStorage.getItem(STUDY_PWD_KEY) || '';
