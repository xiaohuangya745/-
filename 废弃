    // 应用学习锁定：隐藏/显示导航项和首页按钮
    function applyStudyLock() {
        const enabled = studyState.enabled && !studyUnlocked;
        // 导航栏
        document.querySelectorAll('.nav-links a').forEach(a => {
            const page = a.dataset.page;
            if (!page) return;
            const allowed = STUDY_ALLOWED.includes(page);
            a.style.display = (enabled && !allowed) ? 'none' : '';
        });
        // 首页快捷按钮
        const homeActions = {
            'learn': ['知识教学', '开始学习'],
            'quiz': ['闯关答题', '⚔️'],
            'practice': ['大胆实践', '🔥'],
            'score': ['查看成绩', '📊'],
            'battle': ['最强大脑', '🧠'],
            'report': ['问题上报', '📢'],
            'settings': ['设置中心', '⚙️'],
            'game': ['AI 枪战', '🔫']
        };
        document.querySelectorAll('.action-btn').forEach(btn => {
            const onclick = (btn.getAttribute('onclick') || '');
            const m = onclick.match(/navigateTo\('(\w+)'\)/);
            if (!m) return;
            const page = m[1];
            const allowed = STUDY_ALLOWED.includes(page);
            btn.style.display = (enabled && !allowed) ? 'none' : '';
        });
    }

    // 检查某页面是否可访问
    function isPageAllowed(page) {
        if (!studyState.enabled) return true;
        if (studyUnlocked) return true;
        return STUDY_ALLOWED.includes(page);
    }

    // 开关回调
    async function onStudyModeToggle(on) {
        clearPwdErrors();
        if (on) {
            // 开启：需要设置密码
            const hasPwd = !!getStoredHash();
            if (!hasPwd) {
                // 显示密码设置区域
                const setArea = document.getElementById('passwordSetArea');
                if (setArea) setArea.classList.add('show');
                // 切换回关闭，等密码设置完再开
                const toggle = document.getElementById('studyModeToggle');
                if (toggle) toggle.checked = false;
                showSettingsToast('🔑 请先设置密码再开启学习模式');
            } else {
                studyState.enabled = true;
                studyUnlocked = false;
                saveStudy(studyState);
                renderStudyUI();
                showSettingsToast('📚 学习模式已开启');
                // 如果当前在非允许页，跳回首页
                const cur = document.querySelector('.page.active');
                if (cur) {
                    const id = cur.id.replace('page-', '');
                    if (!isPageAllowed(id)) navigateTo('home');
                }
            }
        } else {
            // 关闭：需要验证密码
            const hash = getStoredHash();
            if (!hash) {
                // 没有密码，直接关闭
                studyState.enabled = false;
                studyUnlocked = true;
                saveStudy(studyState);
                renderStudyUI();
                showSettingsToast('🔓 学习模式已关闭');
            } else {
                // 显示验证区域
                const verifyArea = document.getElementById('passwordVerifyArea');
                if (verifyArea) verifyArea.classList.add('show');
                const toggle = document.getElementById('studyModeToggle');
                if (toggle) toggle.checked = true; // 保持开启
                showSettingsToast('🔓 请输入密码以关闭学习模式');
            }
        }
    }

    // 密码提交（开启时设置）
    async function onPasswordSubmit() {
        clearPwdErrors();
        const input = document.getElementById('passwordInput');
        const confirmInput = document.getElementById('passwordConfirmInput');
        const errEl = document.getElementById('passwordError');
        const hintEl = document.getElementById('passwordHint');
        const btn = document.getElementById('passwordSubmitBtn');
        const label = document.getElementById('passwordSetLabel');

        const pwd = input ? input.value : '';
        const confirmPwd = confirmInput ? confirmInput.value : '';

        if (pwd.length < 6) {
            showPwdError(errEl, '❌ 密码长度至少 6 个字符');
            return;
        }

        // 两步确认
        if (!confirmInput || confirmInput.style.display === 'none') {
            // 第一步：要求确认
            if (confirmInput) {
                confirmInput.style.display = '';
                confirmInput.value = '';
                input.type = 'password';
                label.textContent = '🔑 请再次输入密码以确认：';
                btn.textContent = '确认';
                input.value = '';
                input.placeholder = '再次输入相同密码';
                if (hintEl) hintEl.textContent = '两次输入的密码必须一致。';
                // 标记等待确认
                window._studyPwdStep1 = pwd;
                return;
            }
        }

        const step1 = window._studyPwdStep1 || pwd;
        const finalPwd = (confirmInput && confirmInput.style.display !== 'none') ? confirmPwd : pwd;

        if (step1 !== finalPwd) {
            showPwdError(errEl, '❌ 两次输入的密码不一致，请重新设置');
            if (input) input.value = '';
            if (confirmInput) confirmInput.value = '';
            window._studyPwdStep1 = undefined;
            if (label) label.textContent = '🔑 请设置学习模式密码（至少 6 个字符）：';
            if (btn) btn.textContent = '确认设置';
            if (confirmInput) confirmInput.style.display = 'none';
            if (hintEl) hintEl.textContent = '密码将使用 SHA-256 哈希后存储于本地，服务器不会获取你的明文密码。';
            return;
