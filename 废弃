    scene.add(grid);

    // 障碍物（掩体）
    obstacles = [];
    const obsMat = new THREE.MeshStandardMaterial({ color: 0x223344, roughness: 0.6 });
    const obsPositions = [
      [10, 1.5, -5], [-12, 2, 8], [5, 1, 15], [-8, 1.5, -12],
      [18, 2.5, 12], [-18, 2, -8], [0, 3, 20], [15, 1.5, -18],
