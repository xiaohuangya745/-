    function playTerminalAnimation(lines) {
        const container = document.getElementById('termAnim');
        if (!container) return;

        // 每次调用前清除旧的动画定时器
        if (window._termAnimTimers) {
            window._termAnimTimers.forEach(t => clearTimeout(t));
        }
        window._termAnimTimers = [];

        container.innerHTML = '';
        let i = 0;

        function addLine() {
            // 如果容器已不在DOM中（页面已跳转），停止动画
            if (!document.getElementById('termAnim')) return;

            if (i >= lines.length) {
                const cursor = document.createElement('span');
                cursor.className = 'cursor';
                container.appendChild(cursor);
                return;
            }

            const line = lines[i];
            const div = document.createElement('div');
            div.className = 'terminal-line';
            div.style.animationDelay = '0s';

            if (line === '') {
                div.innerHTML = '&nbsp;';
            } else if (line.includes('[✓]')) {
                div.innerHTML = `<span style="color:#3fb950;">${line}</span>`;
            } else if (line.includes('[✗]') || line.includes('[!]') || line.includes('[CRIT]') || line.includes('[WARN]')) {
                div.innerHTML = `<span style="color:#f85149;">${line}</span>`;
            } else if (line.includes('$') || line.includes('#')) {
                div.innerHTML = `<span class="prompt">${line}</span>`;
            } else {
                div.textContent = line;
            }

            container.appendChild(div);
            i++;

            // 根据行内容调整速度
            let delay = 300;
            if (line.includes('sleep') || line.includes('等待')) delay = 800;
            else if (line === '') delay = 100;
            else if (line.length > 60) delay = 500;

            const t = setTimeout(addLine, delay);
            window._termAnimTimers.push(t);
        }

        addLine();
    }

