    // ===== 浏览器检测 + Edge 深度适配 =====
    function detectBrowser() {
        const ua = navigator.userAgent || '';
        const info = { name: 'unknown', version: '', engine: '', isEdge: false, isChromium: false, isIE: false };

        // Edge (Chromium)
        if (/Edg\//.test(ua)) {
            info.name = 'Microsoft Edge';
            info.isEdge = true;
            info.isChromium = true;
            const m = ua.match(/Edg\/(\d+\.\d+)/);
            if (m) info.version = m[1];
        }
        // Edge (Legacy)
        else if (/Edge\//.test(ua)) {
            info.name = 'Microsoft Edge (Legacy)';
            info.isEdge = true;
            info.isIE = true;
            const m = ua.match(/Edge\/(\d+\.\d+)/);
            if (m) info.version = m[1];
        }
        // IE
        else if (/MSIE |Trident\//.test(ua)) {
            info.name = 'Internet Explorer';
            info.isIE = true;
            const m = ua.match(/(?:MSIE |rv:)(\d+\.\d+)/);
            if (m) info.version = m[1];
        }
        // Chrome
        else if (/Chrome\//.test(ua) && !/Chromium/.test(ua)) {
            info.name = 'Google Chrome';
            info.isChromium = true;
            const m = ua.match(/Chrome\/(\d+\.\d+)/);
            if (m) info.version = m[1];
        }
        // Firefox
        else if (/Firefox\//.test(ua)) {
            info.name = 'Mozilla Firefox';
            const m = ua.match(/Firefox\/(\d+\.\d+)/);
            if (m) info.version = m[1];
        }
        // Safari
        else if (/Safari\//.test(ua) && !/Chrome/.test(ua)) {
            info.name = 'Apple Safari';
            const m = ua.match(/Version\/(\d+\.\d+)/);
            if (m) info.version = m[1];
        }

        // 渲染引擎
        if (/AppleWebKit\//.test(ua)) info.engine = 'WebKit';
        if (/Gecko\//.test(ua) || /Firefox/.test(ua)) info.engine = 'Gecko';
        if (/Trident\//.test(ua)) info.engine = 'Trident';
        if (/Blink\//.test(ua) || info.isChromium) info.engine = 'Blink';

        return info;
    }

    function applyBrowserAdaptation() {
        const browser = detectBrowser();
        document.body.setAttribute('data-browser', browser.name.replace(/\s+/g, '-').toLowerCase());
        document.body.setAttribute('data-engine', browser.engine.toLowerCase());

        // Edge 深度适配
        if (browser.isEdge) {
            document.body.classList.add('browser-edge');
            // Edge 特有优化
            if (browser.isChromium) {
                // Chromium Edge：启用硬件加速提示
                document.body.style.setProperty('-webkit-transform', 'translateZ(0)');
                // 优化滚动
                document.documentElement.style.setProperty('scroll-behavior', 'smooth');
            }
            // 显示适配提示
            showBrowserBar(`✅ 已深度适配 Microsoft Edge ${browser.version || ''}，享受最佳体验！`, 'info', 3500);
        }
        // IE / 旧版 Edge 警告
        else if (browser.isIE) {
            showBrowserBar(`⚠️ 检测到旧版浏览器，部分功能可能异常。推荐使用 Microsoft Edge / Chrome 最新版。`, 'warning', 6000);
        }
        // 其他浏览器提示
        else {
            showBrowserBar(`🌐 当前浏览器：${browser.name} ${browser.version || ''}，已自动适配。`, 'info', 3000);
        }

        return browser;
    }

