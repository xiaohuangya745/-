  // ---------- 敌人 ----------
  function createEnemy(type) {
    const d = DIFF[difficulty];
    let hp = d.hp, color = 0xff3333, size = 1, speed = 2, dmg = d.dmg;
    if (type === 'fast') { hp *= 0.7; color = 0xffcc00; size = 0.7; speed = 4; }
    else if (type === 'heavy') { hp *= 2; color = 0xaa44ff; size = 1.4; speed = 1.2; dmg *= 1.5; }

    const geo = type === 'fast' ? new THREE.ConeGeometry(size*0.5, size*1.2, 4) :
                type === 'heavy' ? new THREE.BoxGeometry(size, size*1.2, size) :
                new THREE.TetrahedronGeometry(size*0.6);
    const mat = new THREE.MeshStandardMaterial({ color, emissive: color, emissiveIntensity: 0.3, roughness: 0.4 });
    const mesh = new THREE.Mesh(geo, mat);

    // 随机出生点（远离玩家）
    let x, z, dist;
    do {
      x = rand(-40, 40); z = rand(-40, 40);
      dist = Math.hypot(x - camera.position.x, z - camera.position.z);
    } while (dist < 12);
    mesh.position.set(x, size*0.6, z);
    mesh.castShadow = renderer.shadowMap.enabled;
    enemyGroup.add(mesh);

    // HP 条（Sprite）
    const hpCanvas = document.createElement('canvas'); hpCanvas.width = 64; hpCanvas.height = 8;
    const hpCtx = hpCanvas.getContext('2d');
    const hpTex = new THREE.CanvasTexture(hpCanvas);
    const hpSprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: hpTex, depthTest: false }));
    hpSprite.scale.set(2, 0.25, 1);
    hpSprite.position.y = size * 1.5;
    mesh.add(hpSprite);

    const enemy = {
      mesh, type, hp: Math.ceil(hp), maxHp: Math.ceil(hp), dmg, speed, size,
      state: 'chase', hitTimer: 0, flashTimer: 0,
      headY: mesh.position.y + size * 0.8,
      hpCanvas, hpCtx, hpTex, hpSprite,
      updateHPBar: function() {
        const ctx = this.hpCtx; ctx.clearRect(0,0,64,8);
        ctx.fillStyle = '#333'; ctx.fillRect(0,0,64,8);
        ctx.fillStyle = '#0f0'; ctx.fillRect(0,0, 64*(this.hp/this.maxHp), 8);
        this.hpTex.needsUpdate = true;
      }
    };
    enemy.updateHPBar();
    enemies.push(enemy);
    return enemy;
  }

  // Boss
  function createBoss() {
    const d = DIFF[difficulty];
    const hp = d.hp * 10 * wave;
    const mesh = new THREE.Mesh(
      new THREE.OctahedronGeometry(2.5),
      new THREE.MeshStandardMaterial({ color: 0xff00ff, emissive: 0x440044, roughness: 0.2, metalness: 0.5 })
    );
    let x, z, dist;
    do { x = rand(-30,30); z = rand(-30,30); dist = Math.hypot(x,z); } while(dist < 18);
    mesh.position.set(x, 3, z);
    mesh.castShadow = renderer.shadowMap.enabled;
    enemyGroup.add(mesh);

    const enemy = {
      mesh, type: 'boss', hp, maxHp: hp, dmg: d.dmg * 2, speed: 1.5, size: 2.5,
      state: 'chase', hitTimer: 0, flashTimer: 0,
      headY: mesh.position.y + 2,
      hpCanvas: null, hpCtx: null, hpTex: null, hpSprite: null,
      updateHPBar: function() {}
    };
    enemies.push(enemy);
    bossActive = true;
    showMessage(`⚠️ BOSS 出现！ 血量 ${hp}`, 3000);
    playSound('wave');
  }

  // ---------- 射击 ----------
  function shoot() {
    const w = WEAPONS[currentWeapon];
    const now = performance.now();
    if (reloading) return;
    if (now - lastShotTime < 60000 / w.rpm) return;
    if (magAmmo <= 0) { playSound('reload'); startReload(); return; }
    lastShotTime = now;
    magAmmo--;

    // 后坐力
    pitch += rand(-w.recoil, w.recoil * 0.5);
    yaw += rand(-w.spread, w.spread);
    camera.rotation.set(pitch, yaw, 0, 'YXZ');

    // 枪口闪光
    muzzleFlash();

    // 射线检测
    raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
    const hits = raycaster.intersectObjects(enemyGroup.children, true);
    if (hits.length > 0) {
      const hit = hits[0];
      // 找到对应 enemy
      let target = null;
      for (const e of enemies) {
        if (e.mesh === hit.object || e.mesh.children.includes(hit.object)) { target = e; break; }
        // 递归查找
        e.mesh.traverse(c => { if (c === hit.object) target = e; });
        if (target) break;
      }
      if (target) {
        const isHead = hit.point.y > target.headY;
        const dmg = isHead ? w.dmg * 2.5 : w.dmg;
        target.hp -= dmg;
        target.flashTimer = 0.1;
        target.mesh.material.emissiveIntensity = 1.0;
        spawnHitParticle(hit.point, target.mesh.material.color.getHex());
        playSound('hit');
        combo++;
        if (target.hp <= 0) {
          killEnemy(target);
          combo += 2;
          playSound('kill');
        }
      }
    }
    playSound('shoot');
    updateHUD();

    // 自动换弹
    if (magAmmo === 0 && ammo > 0) startReload();
  }

  function muzzleFlash() {
    if (!weaponView) return;
    const flash = new THREE.Mesh(
      new THREE.SphereGeometry(0.12, 6, 6),
      new THREE.MeshBasicMaterial({ color: 0xffdd44, transparent: true, opacity: 0.9 })
    );
    flash.position.set(0.25, -0.18, -1.05);
    scene.add(flash);
    let life = 0.05;
    const tick = (dt) => {
      life -= dt;
      flash.scale.multiplyScalar(1 + dt * 5);
      flash.material.opacity = life / 0.05;
      if (life <= 0) { scene.remove(flash); }
      else requestAnimationFrame(() => tick(0.016));
    };
    tick(0.016);
  }

  function spawnHitParticle(pos, color) {
    const pCount = perfKey === 'eco' ? 3 : (perfKey === 'smooth' ? 5 : 10);
    for (let i = 0; i < pCount; i++) {
      const p = new THREE.Mesh(
        new THREE.SphereGeometry(0.06, 4, 4),
        new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 1 })
      );
      p.position.copy(pos);
      p.userData.vel = new THREE.Vector3(rand(-2,2), rand(1,3), rand(-2,2));
      p.userData.life = 0.4;
      scene.add(p);
      particles.push(p);
    }
  }

  function killEnemy(enemy) {
    // 爆炸粒子
    const pCount = perfKey === 'eco' ? 5 : (perfKey === 'smooth' ? 10 : 20);
    for (let i = 0; i < pCount; i++) {
      const p = new THREE.Mesh(
        new THREE.SphereGeometry(rand(0.08, 0.2), 4, 4),
        new THREE.MeshBasicMaterial({ color: enemy.mesh.material.color.getHex(), transparent: true, opacity: 1 })
      );
      p.position.copy(enemy.mesh.position);
      p.userData.vel = new THREE.Vector3(rand(-4,4), rand(2,6), rand(-4,4));
      p.userData.life = rand(0.4, 0.8);
      scene.add(p);
      particles.push(p);
    }
    enemyGroup.remove(enemy.mesh);
    enemies = enemies.filter(e => e !== enemy);
    kills++; score += enemy.type === 'boss' ? 500 : 100;
    waveEnemiesLeft--;
    combo += 5;
    if (enemy.type === 'boss') { bossActive = false; showMessage('🏆 BOSS 击败！', 2500); nextWave(); }
    else if (waveEnemiesLeft <= 0 && !bossActive) { showMessage(`🌊 第 ${wave} 波清除！`, 2000); setTimeout(nextWave, 2000); }
    updateHUD();
  }

  // ---------- 换弹 ----------
  function startReload() {
    const w = WEAPONS[currentWeapon];
    if (reloading || magAmmo === w.mag || ammo <= 0) return;
    reloading = true;
    showMessage('🔄 换弹中...', w.reload * 1000);
    playSound('reload');
    setTimeout(() => {
      const need = w.mag - magAmmo;
      const give = Math.min(need, ammo);
      magAmmo += give; ammo -= give;
      reloading = false;
      updateHUD();
    }, w.reload * 1000);
  }
  function reloadWeapon() {
    const w = WEAPONS[currentWeapon];
    magAmmo = w.mag; ammo = w.mag * 4; reloading = false;
  }

  // ---------- 波次 ----------
  function startWave() {
    const d = DIFF[difficulty];
    const baseCount = 3 + wave * 2;
    waveTotal = Math.min(baseCount, d.max);
    waveEnemiesLeft = waveTotal;
    showMessage(`🌊 第 ${wave} 波 — ${waveTotal} 敌人`, 2500);
    playSound('wave');
    scheduleSpawn();
  }
  function scheduleSpawn() {
    if (!running) return;
    const d = DIFF[difficulty];
    const delay = d.spawn * (0.8 + Math.random() * 0.4);
    spawnTimer = setTimeout(() => {
      if (!running) return;
      const r = Math.random();
      let type = 'normal';
      if (wave >= 2 && r < 0.3) type = 'fast';
      else if (wave >= 3 && r < 0.5) type = 'heavy';
      createEnemy(type);
      if (waveEnemiesLeft > 1) scheduleSpawn();
      else { clearTimeout(spawnTimer); setTimeout(() => { if (enemies.length === 0 && running) createBoss(); }, 2000); }
    }, delay);
  }
  function nextWave() {
    wave++;
    if (wave > 5) { victory(); return; }
    startWave();
  }

  // ---------- 伤害玩家 ----------
  function damagePlayer(amount) {
    hp -= amount;
    combo = 0;
    // 屏幕红闪
    const flash = document.createElement('div');
    flash.style.cssText = 'position:fixed;inset:0;background:radial-gradient(circle,rgba(255,0,0,0.4),transparent 70%);pointer-events:none;z-index:9999;';
    document.body.appendChild(flash);
    setTimeout(() => flash.remove(), 200);
    if (hp <= 0) { hp = 0; gameOver(); }
    updateHUD();
  }

  // ---------- 敌人 AI 更新 ----------
  function updateEnemies(dt) {
    const playerPos = camera.position.clone();
    for (const e of enemies) {
      if (e.flashTimer > 0) {
        e.flashTimer -= dt;
        if (e.flashTimer <= 0) e.mesh.material.emissiveIntensity = 0.3;
      }
      const toPlayer = new THREE.Vector3().subVectors(playerPos, e.mesh.position);
      toPlayer.y = 0;
      const dist = toPlayer.length();
      toPlayer.normalize();

      // 面朝玩家
      const targetRot = Math.atan2(toPlayer.x, toPlayer.z);
      e.mesh.rotation.y = targetRot;

      if (dist > 3) {
        // 追击
        e.mesh.position.x += toPlayer.x * e.speed * dt;
        e.mesh.position.z += toPlayer.z * e.speed * dt;
        // 简单避障
        for (const ob of obstacles) {
          if (ob.box.containsPoint(e.mesh.position)) {
            e.mesh.position.x -= toPlayer.x * e.speed * dt * 2;
            e.mesh.position.z -= toPlayer.z * e.speed * dt * 2;
          }
        }
        e.headY = e.mesh.position.y + e.size * 0.8;
      } else {
        // 攻击
        if (Math.random() < dt * (e.type === 'boss' ? 0.8 : 0.4)) {
          let acc = 0.8;
          if (dist > 15) acc = 0.55; else if (dist > 30) acc = 0.4;
          if (input.forward || input.back || input.left || input.right) acc *= 0.7;
          if (Math.random() < acc) damagePlayer(e.dmg);
        }
      }
      // HP 条跟随
      if (e.hpSprite) {
        e.hpSprite.position.y = e.size * 1.5;
        e.hpSprite.material.rotation = camera.rotation.y;
      }
    }
  }

  // ---------- 玩家移动 ----------
  function _mkVec(x,y,z){
    const v={x:x||0,y:y||0,z:z||0};
    v.set=()=>{};
    v.copy=()=>({x:0,y:0,z:0});
    v.normalize=function(){const l=Math.hypot(this.x,this.y,this.z)||1;this.x/=l;this.y/=l;this.z/=l;return this;};
    v.length=function(){return Math.hypot(this.x,this.y,this.z);};
    v.addScaledVector=function(a,s){this.x+=a.x*s;this.y+=a.y*s;this.z+=a.z*s;return this;};
    v.sub=function(a){this.x-=a.x;this.y-=a.y;this.z-=a.z;return this;};
    v.add=function(a){this.x+=a.x;this.y+=a.y;this.z+=a.z;return this;};
    v.crossVectors=function(){return _mkVec(0,1,0);};
    return v;
  }
  
  function updateMovement(dt) {
    let forward;
    try {
      const _fd = new THREE.Vector3();
      camera.getWorldDirection(_fd);
      forward = _fd;
      if (typeof forward.normalize !== 'function') forward = _mkVec(forward.x, forward.y, forward.z);
    } catch(e) { forward = _mkVec(0,0,-1); }
    forward.y = 0;
    try { forward.normalize(); } catch(e) { const l=Math.hypot(forward.x,forward.y,forward.z)||1; forward.x/=l; forward.y/=l; forward.z/=l; }
    let right;
    try { right = new THREE.Vector3().crossVectors(forward, camera.up).normalize(); }
    catch(e) { right = _mkVec(1,0,0); }
    const speed = (input.sprint ? 7 : 4.5) * dt;

    let dx = 0, dz = 0;
    if (input.forward) { dx += forward.x * speed; dz += forward.z * speed; }
    if (input.back)    { dx -= forward.x * speed; dz -= forward.z * speed; }
    if (input.left)    { dx -= right.x * speed; dz -= right.z * speed; }
    if (input.right)   { dx += right.x * speed; dz += right.z * speed; }

    const newX = camera.position.x + dx;
    const newZ = camera.position.z + dz;

    // 障碍物碰撞
    const playerBox = new THREE.Box3(
      new THREE.Vector3(newX - 0.4, 0, newZ - 0.4),
      new THREE.Vector3(newX + 0.4, 2, newZ + 0.4)
    );
    let blocked = false;
    for (const ob of obstacles) {
      if (ob.box.intersectsBox(playerBox)) { blocked = true; break; }
    }
    if (!blocked) { camera.position.x = newX; camera.position.z = newZ; }

    // 边界
    camera.position.x = clamp(camera.position.x, -58, 58);
    camera.position.z = clamp(camera.position.z, -58, 58);

    // 跳跃
    if (input.jump && onGround) { velocityY = 6; onGround = false; }
    if (!onGround) {
      velocityY -= 15 * dt;
      camera.position.y += velocityY * dt;
      if (camera.position.y <= 1.7) { camera.position.y = 1.7; onGround = true; velocityY = 0; }
    }
  }

  // ---------- 粒子更新 ----------
  function updateParticles(dt) {
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.userData.life -= dt;
      p.position.addScaledVector(p.userData.vel, dt);
      p.userData.vel.y -= 5 * dt;
      p.material.opacity = p.userData.life / 0.5;
      if (p.userData.life <= 0) { scene.remove(p); particles.splice(i, 1); }
    }
  }

  // ---------- HUD ----------
  function buildHUD() {
    if (hud) hud.remove();
    hud = document.createElement('div');
    hud.id = 'fps-hud';
    hud.style.cssText = `
      position:fixed;inset:0;pointer-events:none;z-index:1000;
      font-family:'Courier New',monospace;color:#0f0;
      text-shadow:0 0 4px #0f0;
    `;
    hud.innerHTML = `
      <div id="crosshair" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;border:2px solid rgba(0,255,0,0.8);border-radius:50%;"></div>
      <div id="crosshair-dot" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:2px;height:2px;background:#0f0;"></div>
      <div style="position:absolute;top:10px;left:10px;font-size:14px;line-height:1.6;">
        <div>❤️ <span id="fps-hp">100</span>/100</div>
        <div>🔫 <span id="fps-ammo">30/120</span></div>
        <div>⭐ 分数 <span id="fps-score">0</span></div>
        <div>💀 击杀 <span id="fps-kills">0</span></div>
        <div>🔥 连击 <span id="fps-combo">0</span></div>
      </div>
      <div style="position:absolute;top:10px;right:10px;font-size:14px;text-align:right;line-height:1.6;">
        <div>🌊 第 <span id="fps-wave">1</span> 波</div>
        <div id="fps-weapon" style="color:#ff0;">步枪</div>
        <div id="fps-diff" style="color:#aaa;font-size:12px;">普通</div>
      </div>
      <div id="fps-msg" style="position:absolute;top:30%;left:50%;transform:translateX(-50%);font-size:22px;color:#ff0;text-align:center;"></div>
      <div id="fps-bossbar-wrap" style="display:none;position:absolute;bottom:60px;left:50%;transform:translateX(-50%);width:400px;text-align:center;">
        <div style="font-size:14px;color:#f0f;margin-bottom:4px;">☠️ BOSS</div>
        <div style="width:100%;height:14px;background:#333;border:1px solid #f0f;border-radius:4px;overflow:hidden;">
          <div id="fps-bossbar" style="width:100%;height:100%;background:linear-gradient(90deg,#f0f,#a0a);transition:width 0.2s;"></div>
        </div>
      </div>
      <div style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font-size:12px;color:#666;">
        WASD移动 | 鼠标瞄准 | 左键射击 | R换弹 | 1/2/3武器 | Shift冲刺 | ESC暂停
      </div>
    `;
    container.appendChild(hud);
    crosshair = $('crosshair');
    hpBar = $('fps-hp'); ammoText = $('fps-ammo'); scoreText = $('fps-score');
    waveText = $('fps-wave'); killText = $('fps-kills'); msgText = $('fps-msg');
    bossBar = $('fps-bossbar'); bossBarWrap = $('fps-bossbar-wrap');
  }
  function updateHUD() {
    if (!hud) return;
    hpBar.textContent = Math.ceil(hp);
    hpBar.style.color = hp < 30 ? '#f00' : '#0f0';
    ammoText.textContent = `${magAmmo}/${ammo}`;
    scoreText.textContent = score;
    killText.textContent = kills;
    $('fps-combo').textContent = combo;
    waveText.textContent = wave;
    $('fps-weapon').textContent = WEAPONS[currentWeapon].name;
    $('fps-diff').textContent = {easy:'🟢 轻松',normal:'🔵 普通',hard:'🟠 困难',hell:'🔴 地狱'}[difficulty];
    // Boss bar
    const boss = enemies.find(e => e.type === 'boss');
    if (boss) {
      bossBarWrap.style.display = 'block';
      bossBar.style.width = (boss.hp / boss.maxHp * 100) + '%';
    } else {
      bossBarWrap.style.display = 'none';
    }
  }
  function showMessage(text, duration) {
    if (!msgText) return;
    msgText.textContent = text;
    msgText.style.opacity = '1';
    clearTimeout(showMessage._t);
    showMessage._t = setTimeout(() => { if (msgText) msgText.style.opacity = '0'; }, duration || 2000);
  }

  // ---------- 游戏流程 ----------
  function startGame(opts) {
    if (running) return;
    difficulty = (opts && opts.difficulty) || difficulty;
    perfKey = (opts && opts.perfKey) || perfKey;
    perfMode = (opts && opts.perfMode) || false;
    if (perfMode) perfKey = 'eco';

    ensureAudio();
    if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();

    container = $('fps-container') || document.body;
    canvas = $('fps-canvas');
    if (!canvas) {
      canvas = document.createElement('canvas');
      canvas.id = 'fps-canvas';
      canvas.style.cssText = 'display:block;width:100%;height:100%;cursor:none;';
      container.appendChild(canvas);
    }

    buildHUD();
    initScene();
    running = true;
    clock.start();
    startWave();
    requestAnimationFrame(loop);
    showMessage('🔫 准备战斗！点击锁定鼠标', 2500);
  }

  function stopGame() {
    running = false;
    if (spawnTimer) { clearTimeout(spawnTimer); spawnTimer = null; }
    // 清理场景
    if (scene) {
      scene.traverse(obj => {
        if (obj.geometry) obj.geometry.dispose();
        if (obj.material) {
          if (Array.isArray(obj.material)) obj.material.forEach(m => m.dispose());
          else obj.material.dispose();
        }
      });
    }
    if (renderer) {
      renderer.dispose();
      renderer.forceContextLoss();
    }
    if (hud) { hud.remove(); hud = null; }
    if (canvas && canvas.parentNode) canvas.parentNode.removeChild(canvas);
    if (document.pointerLockElement) document.exitPointerLock();
    mouseLocked = false;
    // 清理全局事件
    document.removeEventListener('mousemove', onMouseMove);
    document.removeEventListener('mousedown', onMouseDown);
    document.removeEventListener('keydown', onKeyDown);
    document.removeEventListener('keyup', onKeyUp);
    document.removeEventListener('pointerlockchange', onPointerLockChange);
  }

  function gameOver() {
    running = false;
    playSound('death');
    showMessage(`💀 阵亡！分数 ${score} | 波次 ${wave} | 击杀 ${kills}`, 5000);
    setTimeout(() => {
      if (confirm(`游戏结束！\n分数: ${score}\n波次: ${wave}\n击杀: ${kills}\n\n再来一局？`)) {
        startGame({ difficulty, perfKey, perfMode });
      } else {
        stopGame();
        if (window.GameAPI && window.GameAPI.onExit) window.GameAPI.onExit();
      }
    }, 1500);
  }

  function victory() {
    running = false;
    showMessage(`🏆 胜利！全部 ${wave-1} 波清除！分数 ${score}`, 5000);
    setTimeout(() => {
      alert(`🏆 最终分数: ${score}\n总击杀: ${kills}\n难度: ${difficulty}`);
      stopGame();
      if (window.GameAPI && window.GameAPI.onExit) window.GameAPI.onExit();
    }, 2000);
  }

  // ---------- 主循环 ----------
  function loop() {
    if (!running) return;
    requestAnimationFrame(loop);
    const dt = Math.min(clock.getDelta(), 0.1);

    updateMovement(dt);
    updateEnemies(dt);
    updateParticles(dt);
    updateHUD();

    // 武器晃动
    if (weaponView) {
      const t = performance.now() * 0.001;
      weaponView.position.x = 0.25 + Math.sin(t * 2) * 0.005 * (input.forward ? 1 : 0.3);
      weaponView.position.y = -0.2 + Math.abs(Math.sin(t * 4)) * 0.01 * (input.forward ? 1 : 0.3);
    }

    // 渲染
    renderer.render(scene, camera);
  }

  // ---------- 事件 ----------
  function onMouseMove(e) {
    if (!mouseLocked || !running) return;
    yaw -= e.movementX * sensitivity;
    pitch -= e.movementY * sensitivity;
    pitch = clamp(pitch, -Math.PI/2 + 0.01, Math.PI/2 - 0.01);
    camera.rotation.set(pitch, yaw, 0, 'YXZ');
  }
  function onMouseDown(e) {
    if (!running || !mouseLocked) return;
    if (e.button === 0) shoot();
  }
  function onKeyDown(e) {
    if (!running) return;
    keys[e.code] = true;
    input.forward = !!keys['KeyW'] || !!keys['ArrowUp'];
    input.back    = !!keys['KeyS'] || !!keys['ArrowDown'];
    input.left    = !!keys['KeyA'] || !!keys['ArrowLeft'];
    input.right   = !!keys['KeyD'] || !!keys['ArrowRight'];
    input.sprint  = !!keys['ShiftLeft'] || !!keys['ShiftRight'];
    input.jump    = !!keys['Space'];

    if (e.code === 'Digit1') switchWeapon('pistol');
    if (e.code === 'Digit2') switchWeapon('rifle');
    if (e.code === 'Digit3') switchWeapon('sniper');
    if (e.code === 'KeyR') startReload();
    if (e.code === 'Escape') { /* 浏览器自动释放 pointer lock */ }
  }
  function onKeyUp(e) {
    keys[e.code] = false;
    input.forward = !!keys['KeyW'] || !!keys['ArrowUp'];
    input.back    = !!keys['KeyS'] || !!keys['ArrowDown'];
    input.left    = !!keys['KeyA'] || !!keys['ArrowLeft'];
    input.right   = !!keys['KeyD'] || !!keys['ArrowRight'];
    input.sprint  = !!keys['ShiftLeft'] || !!keys['ShiftRight'];
    input.jump    = !!keys['Space'];
  }
  function onPointerLockChange() {
    mouseLocked = (document.pointerLockElement === canvas);
    if (!mouseLocked && running) showMessage('⏸️ 已暂停 — 点击画面继续', 999999);
    else if (mouseLocked && running) showMessage('', 0);
  }

  function switchWeapon(name) {
    if (!WEAPONS[name] || currentWeapon === name) return;
    currentWeapon = name;
    reloadWeapon();
    createWeaponView();
    showMessage(`🔫 ${WEAPONS[name].name}`, 1200);
    updateHUD();
  }

  // ---------- 公开 API ----------
  window.GameAPI = {
    start: function(opts) {
      // 绑定事件（只绑一次）
      document.addEventListener('mousemove', onMouseMove);
      document.addEventListener('mousedown', onMouseDown);
      document.addEventListener('keydown', onKeyDown);
      document.addEventListener('keyup', onKeyUp);
      document.addEventListener('pointerlockchange', onPointerLockChange);

      // 点击锁定
      const tryLock = () => {
        if (canvas && running) {
          canvas.requestPointerLock = canvas.requestPointerLock || canvas.mozRequestPointerLock;
          if (canvas.requestPointerLock) {
            try { canvas.requestPointerLock(); } catch(e) {}
          }
        }
      };
      // 延迟一帧确保 canvas 已挂载
      setTimeout(tryLock, 100);

      startGame(opts);
    },
    stop: stopGame,
    isRunning: () => running,
    setDifficulty: (d) => { if (DIFF[d]) difficulty = d; },
    setPerfKey: (k) => { if (PERF[k]) perfKey = k; },
    setPerfMode: (on) => { perfMode = !!on; if (perfMode) perfKey = 'eco'; },
    getStats: () => ({ hp, score, kills, wave, combo, magAmmo, ammo, weapon: currentWeapon, difficulty, perfKey }),
    switchWeapon
  };

  // 暴露 Three.js 依赖检查
  window.GameAPI._checkDeps = function() {
    if (typeof THREE === 'undefined') {
      console.error('[FPS] Three.js 未加载！请检查 CDN 链接。');
      return false;
    }
    return true;
  };

  console.log('%c🔫 FPS Engine v3.0 ready', 'color:#0f0;font-weight:bold;');

})();

