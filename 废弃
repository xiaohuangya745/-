  }
  // formatSize（双重保险，即使上面 IIFE 因异常未执行也能兜底）
  if (!window.YBSandbox.formatSize) {
    window.YBSandbox.formatSize = function(bytes) {
      if (bytes == null || isNaN(bytes)) return '未知';
      bytes = Number(bytes);
      if (bytes < 1024) return bytes + ' B';
      var u = ['KB','MB','GB','TB','PB'];
      var i = -1;
      do { bytes /= 1024; i++; } while (bytes >= 1024 && i < u.length - 1);
      return bytes.toFixed(bytes < 10 ? 2 : bytes < 100 ? 1 : 0) + ' ' + u[i];
    };
  }
  // 静默吞掉未处理的 Promise rejection（如 AbortError）
  window.addEventListener('unhandledrejection', function(e) {
    var reason = e.reason;
    if (reason && (reason.name === 'AbortError' || /abort|signal/i.test(reason.message||''))) {
      e.preventDefault(); // 静默，不打印红色报错
    }
  });
