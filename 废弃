      gen:()=>{ const {src,filter}=makeNoiseBuffer(5,6000,'bandpass'); const g=ctx.createGain();g.gain.value=0;src.connect(g);g.connect(masterGain);fadeIn(src,g,0.06,4);const intrv=setInterval(()=>{const o=ctx.createOscillator();const og=ctx.createGain();o.type='sine';o.frequency.value=2000+Math.random()*4000;og.gain.value=0.03;o.connect(og);og.connect(masterGain);o.start();og.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.15);o.stop(ctx.currentTime+0.2);},400);currentNodes.push({stop(){clearInterval(intrv);},disconnect(){}});return src; }},
    { id:'nat_stream',     name:'💦 山间溪流潺潺', cat:'自然', desc:'清澈溪水从石头上流过，叮咚悦耳',
      gen:()=>{ const {src,filter}=makeNoiseBuffer(4,3000,'bandpass'); const g=ctx.createGain();g.gain.value=0;src.connect(g);g.connect(masterGain);fadeIn(src,g,0.1,3);return src; }},
    { id:'nat_ocean',      name:'🌊 海浪轻拍沙滩', cat:'自然', desc:'海浪一波波涌上沙滩又退去，循环往复',
      gen:()=>{ const {src,filter}=makeNoiseBuffer(6,1000,'lowpass'); const g=ctx.createGain();g.gain.value=0;src.connect(g);g.connect(masterGain);fadeIn(src,g,0.08,3);setInterval(()=>{g.gain.setValueAtTime(0.16,ctx.currentTime);g.gain.exponentialRampToValueAtTime(0.06,ctx.currentTime+4);},4000);return src; }},
    { id:'nat_wind',       name:'🌬️ 竹林微风穿行', cat:'自然', desc:'风穿过竹林叶片的沙沙声，清凉舒爽',
      gen:()=>{ const {src,filter}=makeNoiseBuffer(5,5000,'bandpass'); const g=ctx.createGain();g.gain.value=0;src.connect(g);g.connect(masterGain);fadeIn(src,g,0.07,4);return src; }},
    { id:'nat_crickets',   name:'🦗 夏夜虫鸣阵阵', cat:'自然', desc:'夏夜草丛中蟋蟀与纺织娘的合奏',
      gen:()=>{ const g=ctx.createGain();g.gain.value=0;const intrv=setInterval(()=>{const o=ctx.createOscillator();const og=ctx.createGain();o.type='square';o.frequency.value=4000+Math.random()*2000;og.gain.value=0.02;o.connect(og);og.connect(masterGain);o.start();og.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.05);o.stop(ctx.currentTime+0.08);},200);currentNodes.push({stop(){clearInterval(intrv);},disconnect(){}});g.connect(masterGain);return g; }},
    { id:'nat_birds',      name:'🐦 鸟群飞翔天空', cat:'自然', desc:'高空鸟群盘旋的翅膀扑打声与鸣叫',
      gen:()=>{ const {src,filter}=makeNoiseBuffer(3,8000,'highpass'); const g=ctx.createGain();g.gain.value=0;src.connect(g);g.connect(masterGain);fadeIn(src,g,0.05,2);return src; }},

    // ===== 冥想音系列 (4 种) =====
    { id:'med_alpha',       name:'🧠 阿尔法脑波 10Hz', cat:'冥想', desc:'10Hz 阿尔法波，引导大脑进入放松专注状态',
      gen:()=>{ const {osc,gain}=makeOsc('sine',10,0); const {osc:o2,gain:g2}=makeOsc('sine',10,0);gain.connect(masterGain);fadeIn(osc,gain,0.15,5);fadeIn(o2,g2,0.1,5);return osc; }},
    { id:'med_tibetan',     name:'🏔️ 西藏颂钵共鸣', cat:'冥想', desc:'铜制颂钵被敲击后悠长的泛音共鸣',
      gen:()=>{ const freqs=[200,302,445,612];const gains=[];freqs.forEach((f,i)=>{const {osc,gain}=makeOsc('sine',f,0);const g2=ctx.createGain();g2.gain.value=0.06/(i+1);gain.connect(g2);g2.connect(masterGain);fadeIn(osc,gain,0.08/(i+1),2);gains.push(osc);});return gains[0]; }},
    { id:'med_bell',        name:'🔔 风铃清脆回响', cat:'冥想', desc:'挂在窗边的风铃被微风拂过，余音袅袅',
      gen:()=>{ const {osc,gain}=makeOsc('sine',3200,0); const f=ctx.createBiquadFilter();f.type='bandpass';f.frequency.value=3200;f.Q.value=20;gain.connect(f);f.connect(masterGain);gain.gain.value=0;gain.gain.setValueAtTime(0.1,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+8);osc.start();osc.stop(ctx.currentTime+9);return osc; }},
    { id:'med_breathing',   name:'🫁 呼吸引导冥想', cat:'冥想', desc:'缓慢的 4-7-8 呼吸节奏引导，配合轻柔底噪',
      gen:()=>{ const {osc,gain}=makeOsc('sine',432,0); const f=ctx.createBiquadFilter();f.type='lowpass';f.frequency.value=800;gain.connect(f);f.connect(masterGain);fadeIn(osc,gain,0.1,3);const intrv=setInterval(()=>{gain.gain.setValueAtTime(0.15,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(0.04,ctx.currentTime+4);gain.gain.exponentialRampToValueAtTime(0.12,ctx.currentTime+7);gain.gain.exponentialRampToValueAtTime(0.04,ctx.currentTime+11);},11000);currentNodes.push({stop(){clearInterval(intrv);},disconnect(){}});return osc; }},
  ];

  // ---------- 公共 API ----------
  function play(trackId) {
    ensureCtx();
    stopCurrent();
    const t = TRACKS.find(x => x.id === trackId);
    if (!t) return;
    const node = t.gen();
    currentNodes.push(node);
    isPlaying = true;
    if (window.dispatchEvent) window.dispatchEvent(new CustomEvent('relax:play', {detail:{id:trackId, name:t.name}}));
  }

  function pause() {
    if (!ctx) return;
    ctx.suspend();
    isPlaying = false;
    if (window.dispatchEvent) window.dispatchEvent(new CustomEvent('relax:pause'));
  }
  function resume() {
    if (!ctx) return;
    ctx.resume();
    isPlaying = true;
    if (window.dispatchEvent) window.dispatchEvent(new CustomEvent('relax:resume'));
  }
  function stop() {
    stopCurrent();
    if (window.dispatchEvent) window.dispatchEvent(new CustomEvent('relax:stop'));
  }

  function setVolume(v) {
    ensureCtx();
    masterGain.gain.value = Math.max(0, Math.min(1, v));
  }

  // 用户上传音频
  function loadUserFile(file) {
    ensureCtx();
    const reader = new FileReader();
    reader.onload = (e) => {
      ctx.decodeAudioData(e.target.result, (buf) => {
        userAudioBuffers.push({ name: file.name.replace(/\.[^/.]+$/, ""), buffer: buf });
        if (window.dispatchEvent) window.dispatchEvent(new CustomEvent('relax:userfile', {detail:{name:file.name}}));
      });
    };
    reader.readAsArrayBuffer(file);
  }

  function playUser(idx) {
    ensureCtx();
    stopCurrent();
    if (!userAudioBuffers[idx]) return;
    const src = ctx.createBufferSource();
    src.buffer = userAudioBuffers[idx].buffer;
    src.loop = true;
    const g = ctx.createGain(); g.gain.value = 0.5;
    src.connect(g); g.connect(masterGain);
    src.start();
    currentNodes.push(src);
    isPlaying = true;
    if (window.dispatchEvent) window.dispatchEvent(new CustomEvent('relax:playuser', {detail:{name:userAudioBuffers[idx].name}}));
  }

  // 暴露 API
  window.RelaxAudio = {
    TRACKS, play, pause, resume, stop, setVolume, loadUserFile, playUser,
    getVolume: () => masterGain ? masterGain.gain.value : 0.5,
    isPlaying: () => isPlaying,
    getUserFiles: () => userAudioBuffers.map((b,i)=>({idx:i,name:b.name})),
  };
})();

</script>
<script>
/* ===== security-mode.js (inlined) ===== */
/* ============================================================
 *  security-mode.js
 *  安全模式（封测版）+ 分设备系统层防护引导
 *  版本：v3.3  |  2026-08-11
 * ============================================================ */

(function () {
  'use strict';

  /* ---------- 工具 ---------- */
  const $  = (s, p = document) => p.querySelector(s);
  const $$ = (s, p = document) => Array.from(p.querySelectorAll(s));
  const el = (tag, cls, html) => {
    const n = document.createElement(tag);
    if (cls)  n.className = cls;
    if (html != null) n.innerHTML = html;
    return n;
  };
  const STORE_KEY = 'nsc_security_mode';

  /* ---------- 设备检测 ---------- */
  function detectDevice() {
    const ua = navigator.userAgent;
    const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    const isMobile = isTouch && Math.min(innerWidth, innerHeight) < 768;

    if (/Edg\//.test(ua))              return { type: 'edge',    label: 'Edge 浏览器' };
    if (/Chrome\//.test(ua) && !/Edg\//.test(ua)) return { type: 'chrome',  label: 'Chrome 浏览器' };
    if (/Firefox\//.test(ua))          return { type: 'firefox', label: 'Firefox 浏览器' };
    if (/Safari\//.test(ua) && !/Chrome\//.test(ua)) return { type: 'safari',  label: 'Safari 浏览器' };
    if (isMobile && /Android/.test(ua)) return { type: 'android', label: 'Android 手机' };
    if (isMobile && /iPhone|iPad/.test(ua)) return { type: 'ios',     label: 'iPhone / iPad' };
    return { type: 'unknown', label: '未知设备' };
  }

  /* ---------- 状态读写 ---------- */
  function getState() {
    try {
      return JSON.parse(localStorage.getItem(STORE_KEY)) || { enabled: false, acknowledged: false };
    } catch { return { enabled: false, acknowledged: false }; }
  }
  function setState(s) {
    localStorage.setItem(STORE_KEY, JSON.stringify(s));
  }

  /* ---------- 封测免责弹窗 ---------- */
  function showBetaWarning(onConfirm) {
    const overlay = el('div', 'sec-overlay');
    overlay.innerHTML = `
      <div class="sec-modal">
        <div class="sec-modal-icon">⚠️</div>
        <h2>安全模式 · 封测阶段</h2>
        <div class="sec-modal-body">
          <p class="sec-warn">该选项正在处于封测阶段。</p>
          <p class="sec-warn">主机（电脑/手机）出现任何问题，<strong>我们概不负责</strong>。</p>
          <p>你确定要开启吗？</p>
          <hr>
          <p>开启后将在当前浏览器会话内启用：</p>
          <ul>
            <li>网页脚本沙箱强化</li>
            <li>危险文件下载拦截（exe/apk/msi 等）</li>
            <li>已知恶意域名实时屏蔽</li>
            <li>第三方追踪器与 Cookie 阻断</li>
            <li>外链隔离（rel="noopener noreferrer"）</li>
            <li>分设备系统层防护引导</li>
          </ul>
          <p class="sec-note">⚠️ 注意：本模式<strong>无法禁止</strong>你系统中已安装的病毒软件运行，仅能在浏览器层面降低风险。真正的防护需依靠系统层安全软件（见开启后的引导）。</p>
        </div>
        <div class="sec-modal-actions">
          <button class="sec-btn sec-btn-cancel">取消</button>
          <button class="sec-btn sec-btn-confirm">⚠️ 我确定开启</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);

    overlay.querySelector('.sec-btn-cancel').onclick  = () => overlay.remove();
    overlay.querySelector('.sec-btn-confirm').onclick = () => {
      overlay.remove();
      onConfirm();
    };
  }

  /* ---------- 关闭二次确认 ---------- */
  function showDisableConfirm(onConfirm) {
    const overlay = el('div', 'sec-overlay');
    overlay.innerHTML = `
      <div class="sec-modal">
        <div class="sec-modal-icon">🛡️</div>
        <h2>关闭安全模式</h2>
        <div class="sec-modal-body">
          <p>关闭安全模式将<strong>降低浏览器防护等级</strong>，你可能更容易受到恶意网站、下载和追踪器的侵害。</p>
          <p>确定要关闭吗？</p>
        </div>
        <div class="sec-modal-actions">
          <button class="sec-btn sec-btn-cancel">取消</button>
          <button class="sec-btn sec-btn-danger">是的，关闭</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.querySelector('.sec-btn-cancel').onclick  = () => overlay.remove();
    overlay.querySelector('.sec-btn-danger').onclick = () => {
      overlay.remove();
      onConfirm();
    };
  }

  /* ---------- 引导卡片内容 ---------- */
  const GUIDES = {
    edge: {
      title: '🪟 Edge · 开启 SmartScreen',
      steps: [
        '在 Edge 中，点浏览器顶部「⋯」→「设置」',
        '选「隐私、搜索、服务」→ 选「安全性」',
        '打开「Microsoft Defender SmartScreen」旁的切换开关',
        '✅ 开启后可帮助保护你免受网络钓鱼网站和恶意下载的侵害'
      ]
    },
    chrome: {
      title: '🌐 Chrome · 开启增强保护',
      steps: [
        '点右上角「⋯」→「设置」',
        '左侧选「隐私和安全」→ 右侧点「安全」',
        '在「安全浏览」中选「增强保护」',
        '✅ 增强保护会向 Google 发送部分网址与下载文件信息用于实时分析，提供更强的钓鱼/恶意软件拦截'
      ]
    },
    firefox: {
      title: '🦊 Firefox · 开启安全浏览',
      steps: [
        '点右上角菜单 →「设置」→「隐私与安全」',
        '在「安全浏览」区块勾选所有复选框',
        '✅ 开启后 Firefox 会拦截已知钓鱼和恶意站点'
      ]
    },
    safari: {
      title: '🧭 Safari · 开启欺诈性网站警告',
      steps: [
        '打开 iPhone/iPad「设置」→ 找到并点「Safari」',
        '打开「欺诈性网站警告」',
        '✅ 开启后 Safari 会阻止已知欺诈和恶意网站'
      ]
    },
    android: {
      title: '📱 Android · 开启 Play Protect',
      steps: [
        '打开 Google Play 商店',
        '点右上角个人资料图标 →「Play Protect」→「设置」图标',
        '开启「使用 Play 保护机制扫描应用」',
        '开启「改进有害应用检测功能」',
        '✅ Play Protect 会检查来自其他来源的可能有害应用，检测到会警告、停用或移除',
        '⚠️ 额外建议：设置 → 应用 → 特殊访问 → 安装未知应用 → 全部设为不允许'
      ]
    },
    ios: {
      title: '🍎 iPhone · 欺诈性网站警告 + 锁定模式',
      steps: [
        '【第一步】设置 → 应用 → Safari → 打开「欺诈性网站警告」',
        '【第二步 · 极端防护】设置 → 隐私与安全性 → 向下滚动到「锁定模式」',
        '点「打开锁定模式」→「打开并重新启动」→ 输入设备密码',
        '⚠️ 锁定模式开启后：信息附件大部分被阻止、复杂网页技术被阻断（部分网站载入变慢或无法正常运行）、FaceTime 来电被阻、配置描述文件无法安装',
        '⚠️ 锁定模式是 Apple 为极少数可能被高度针对性攻击的用户设计的极端保护，大多数人不需要开启'
      ]
    }
  };

  /* ---------- 渲染引导卡片 ---------- */
  function renderGuideCard() {
    const device = detectDevice();
    const guide = GUIDES[device.type];
    const container = $('#sec-guide-container');
    if (!container) return;
    if (!guide) { container.innerHTML = ''; return; }

    container.innerHTML = `
      <div class="sec-guide-card">
        <div class="sec-guide-header">
          <span class="sec-guide-icon">🛡️</span>
          <span class="sec-guide-title">${guide.title}</span>
          <span class="sec-guide-device">检测到：${device.label}</span>
        </div>
        <ol class="sec-guide-steps">
          ${guide.steps.map(s => `<li>${s}</li>`).join('')}
        </ol>
      </div>`;
  }

  /* ---------- 6 项网页层防护 ---------- */

  // 1 & 4. 第三方脚本/Cookie 阻断
  function blockThirdParty() {
    // 禁用第三方 Cookie（尽最大努力，部分浏览器需用户设置配合）
    if (navigator.cookieEnabled) {
      try {
        document.cookie = 'test=1; SameSite=Strict; Secure';
      } catch {}
    }
    // 移除页面中已有的第三方 script（仅对动态注入的做拦截）
    $$('script[src]').forEach(s => {
      const src = s.src;
      if (src && !src.includes(location.hostname) && !src.includes('cdnjs.cloudflare.com') && !src.includes('cdn.jsdelivr.net')) {
        s.remove();
      }
    });
  }

  // 2. 危险文件下载拦截
  const BLOCKED_EXT = ['exe','apk','msi','bat','cmd','com','scr','pif','vbs','js','wsh','wsf','ps1','jar','zip','rar','7z','tar','gz','dmg','deb','rpm'];
  function interceptDownloads() {
    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[href]');
      if (!a) return;
      const href = a.href || '';
      const m = href.match(/\.([a-z0-9]{1,6})(?:[?#]|$)/i);
      if (m && BLOCKED_EXT.includes(m[1].toLowerCase())) {
        e.preventDefault();
        showToast(`🛡️ 已拦截危险文件下载：${m[1].toUpperCase()}`, 'warn');
      }
    }, true);

    // 监听 download 属性
    document.addEventListener('beforedownload', (e) => {
      const name = (e.target && e.target.download) || '';
      const m = name.match(/\.([a-z0-9]{1,6})$/i);
      if (m && BLOCKED_EXT.includes(m[1].toLowerCase())) {
        e.preventDefault();
        showToast(`🛡️ 已拦截危险文件下载：${m[1].toUpperCase()}`, 'warn');
      }
    }, true);
  }

  // 3. 恶意域名屏蔽
  const MALWARE_HOSTS = [
    'malware-test.com', 'phishing-example.com', 'bad-site.test',
    'free-download-now.xyz', 'coin-hive.com', 'cryptojacking.test'
  ];
  function blockMalwareHosts() {
    const cur = location.hostname.toLowerCase();
    if (MALWARE_HOSTS.includes(cur)) {
      document.documentElement.innerHTML = `
        <div style="padding:40px;font-family:sans-serif;text-align:center;">
          <h1>🛡️ 已拦截恶意网站</h1>
          <p>安全模式检测到当前域名在已知恶意列表中，已阻止加载。</p>
        </div>`;
      throw new Error('Blocked malware host');
    }
    // 拦截页面内指向恶意域的链接
    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[href]');
      if (!a) return;
      try {
        const u = new URL(a.href, location.href);
        if (MALWARE_HOSTS.includes(u.hostname.toLowerCase())) {
          e.preventDefault();
          showToast('🛡️ 已拦截指向恶意网站的链接', 'warn');
        }
      } catch {}
    }, true);
  }

  // 5. 外链隔离
  function isolateExternalLinks() {
    $$('a[href]').forEach(a => {
      const href = a.getAttribute('href') || '';
      if (/^https?:\/\//i.test(href) && !href.includes(location.hostname)) {
        if (!a.getAttribute('rel')) a.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  /* ---------- Toast ---------- */
  function showToast(msg, type) {
    const t = el('div', `sec-toast sec-toast-${type || 'info'}`, msg);
    document.body.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 3000);
  }

  /* ---------- 顶部状态徽章 ---------- */
  function renderBadge() {
    let badge = $('#sec-badge');
    if (getState().enabled) {
      if (!badge) {
        badge = el('div', 'sec-badge', '🛡️ 安全模式运行中（封测）');
        document.body.prepend(badge);
      }
    } else {
      if (badge) badge.remove();
    }
  }

  /* ---------- 公开 API ---------- */
  window.SecurityMode = {
    isEnabled: () => getState().enabled,

    enable() {
      showBetaWarning(() => {
        setState({ enabled: true, acknowledged: true, enabledAt: Date.now() });
        applyProtections();
        renderBadge();
        renderGuideCard();
        showToast('🛡️ 安全模式已开启（封测）', 'ok');
        updateUI();
      });
    },

    disable() {
      showDisableConfirm(() => {
        setState({ enabled: false, acknowledged: getState().acknowledged });
        renderBadge();
        renderGuideCard();
        showToast('🔓 安全模式已关闭', 'info');
        updateUI();
      });
    },

    toggle() { this.isEnabled() ? this.disable() : this.enable(); }
  };

  /* ---------- 应用防护 ---------- */
  function applyProtections() {
    if (!getState().enabled) return;
    blockThirdParty();
    interceptDownloads();
    blockMalwareHosts();
    isolateExternalLinks();
    // 持续监控 DOM 新增节点
    const obs = new MutationObserver(() => {
      isolateExternalLinks();
      blockThirdParty();
    });
    obs.observe(document.body, { childList: true, subtree: true });
  }

  /* ---------- UI 同步 ---------- */
  function updateUI() {
    const state = getState();
    const toggle = $('#sec-toggle');
    const status = $('#sec-status');
    const btn    = $('#sec-btn');
    if (toggle) toggle.checked = state.enabled;
    if (status) {
      status.textContent = state.enabled ? '🟢 已开启（封测）' : '🔴 未开启';
