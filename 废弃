    function getQuestionsForBattle(){
        const pool=BATTLE_QUESTIONS.slice();
        if(state.diffMode==='random'){
            // 按难度权重抽：diff1 权重5, diff2 权重4, diff3 权重3, diff4 权重2, diff5 权重1
            const weights={1:5,2:4,3:3,4:2,5:1};
            let weighted=[];
            pool.forEach(q=>{for(let k=0;k<(weights[q.diff]||1);k++) weighted.push(q);});
            let selected=[];
            let attempts=0;
            while(selected.length<30 && attempts<1000){
                const pick=weighted[Math.floor(Math.random()*weighted.length)];
                if(!selected.includes(pick)){selected.push(pick);}
                attempts++;
            }
            // 如果不够30，用剩余题补齐
            pool.forEach(q=>{if(selected.length<30 && !selected.includes(q)) selected.push(q);});
            return shuffle(selected.slice(0,30));
        } else {
            const map={easy:1,medium:2,hard:3,expert:4,insane:5};
            const target=map[state.diffMode]||0;
            // 优先取目标难度，混合上下各一档
            let filtered=pool.filter(x=>x.diff===target);
            if(filtered.length<20){
                filtered=filtered.concat(pool.filter(x=>x.diff===target-1||x.diff===target+1));
            }
            return shuffle(filtered).slice(0,30);
        }
    }
