    function performAIAnalysis(input, pq, diff) {
        const text = input.toLowerCase();
        const keywords = extractKeywords(pq);
        let foundKeywords = [];
        let missingKeywords = [];

        keywords.forEach(kw => {
            if (text.includes(kw.toLowerCase())) {
                foundKeywords.push(kw);
            } else {
                missingKeywords.push(kw);
            }
        });

        const keywordScore = Math.round((foundKeywords.length / keywords.length) * 50);
        const lengthScore = Math.min(Math.round(input.length / 20), 20);
        const structureScore = (input.includes('\n') || input.includes('1') || input.includes('一') || input.includes('首先')) ? 10 : 0;
        const innovationBonus = calculateInnovationBonus(input, diff);

        const totalScore = Math.min(keywordScore + lengthScore + structureScore + innovationBonus, 100);

        // 生成评语
        let level, comment, suggestions;
        if (totalScore >= 90) {
            level = '🏆 大师级';
            comment = '令人惊叹的深度分析！你不仅覆盖了核心知识点，还展现了超越题目的系统性思维。';
        } else if (totalScore >= 75) {
            level = '🔥 专家级';
            comment = '非常扎实的分析！你抓住了关键要点，思路清晰，展现出了专业的安全思维。';
        } else if (totalScore >= 60) {
            level = '📈 进阶中';
            comment = '不错的分析方向！你理解了基本思路，但在深度和细节上还有提升空间。';
        } else if (totalScore >= 40) {
            level = '🌱 起步期';
            comment = '你在正确的方向上，但分析还不够深入。别急，安全思维需要慢慢培养。';
        } else {
            level = '💡 待提升';
            comment = '你的回答偏离了核心要点。建议回顾知识教学相关内容，再回来挑战。';
        }

        return {
            score: totalScore,
            level,
            comment,
            foundKeywords,
            missingKeywords,
            keywordScore,
            lengthScore,
            structureScore,
            innovationBonus,
            inputLength: input.length
        };
    }

    function extractKeywords(pq) {
        // 动态关键词提取：基于题目+参考答案，生成该题应覆盖的关键词清单
        const title = (pq.title || '').toLowerCase();
