    }

    // 学习模式允许的页面
    const STUDY_ALLOWED = ['home', 'learn', 'quiz', 'practice', 'settings'];

    let studyState = loadStudy();
    let studyUnlocked = !studyState.enabled; // 未开启时视为"已解锁"

    // 渲染学习模式 UI
    function renderStudyUI() {
        const toggle = document.getElementById('studyModeToggle');
        const row = document.getElementById('studyModeRow');
        const badge = document.getElementById('studyBadge');
        const badgeInline = document.getElementById('studyBadgeInline');
        const desc = document.getElementById('studyModeDesc');
        const setArea = document.getElementById('passwordSetArea');
        const verifyArea = document.getElementById('passwordVerifyArea');
        const notice = document.getElementById('studyNotice');
        const slider = document.getElementById('studySlider');

        const enabled = studyState.enabled;
        const hasPwd = !!getStoredHash();

        if (toggle) toggle.checked = enabled;
        if (row) row.classList.toggle('study-active', enabled);
        if (badge) badge.classList.toggle('show', enabled);
        if (badgeInline) badgeInline.classList.toggle('show', enabled);
        if (slider) {
            slider.className = 'toggle-slider ' + (enabled ? 'study-slider-on' : 'study-slider');
        }

        if (enabled) {
            if (desc) desc.textContent = '学习模式已开启。仅「学习 / 闯关 / 实践 / 设置」可用，其余功能已锁定。关闭需验证密码。';
            if (setArea) setArea.classList.remove('show');
            if (verifyArea) verifyArea.classList.toggle('show', hasPwd);
            if (notice) notice.classList.add('show');
        } else {
            if (desc) desc.textContent = '开启后将锁定非学习类功能，仅保留「学习 / 闯关 / 实践 / 设置」。开启前请先设置密码（至少 6 个字符）。';
            if (verifyArea) verifyArea.classList.remove('show');
            if (notice) notice.classList.remove('show');
            if (setArea) setArea.classList.toggle('show', !hasPwd);
        }

