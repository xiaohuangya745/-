<script>
/* ===== audio-relax.js (inlined) ===== */
/*
 * 放松音频引擎 v1.0
 * 程序化生成 24 种放松音效 + 支持用户上传本地音频
 * 使用 Web Audio API，无需外部音频文件
 */
(function () {
  'use strict';

  const AudioCtx = window.AudioContext || window.webkitAudioContext;
  let ctx = null;
  let masterGain = null;
  let currentSource = null;
  let currentNodes = [];
  let isPlaying = false;
  let userAudioBuffers = []; // 用户上传的音频

  function ensureCtx() {
    if (!ctx) {
      ctx = new AudioCtx();
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }
    if (ctx.state === 'suspended') ctx.resume();
  }

  function stopCurrent() {
    currentNodes.forEach(n => { try { n.stop && n.stop(); } catch(e){} try { n.disconnect && n.disconnect(); } catch(e){} });
    currentNodes = [];
    isPlaying = false;
  }

  // ---------- 工具函数 ----------
  function makeOsc(type, freq, gainVal) {
    const o = ctx.createOscillator();
    const g = ctx.createGain();
    o.type = type; o.frequency.value = freq; g.gain.value = gainVal;
    o.connect(g); g.connect(masterGain);
    return { osc: o, gain: g };
  }
  function makeNoiseBuffer(durSec, filterFreq, filterType) {
    const len = ctx.sampleRate * durSec;
    const buf = ctx.createBuffer(1, len, ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i=0;i<len;i++) d[i] = Math.random()*2-1;
    const src = ctx.createBufferSource(); src.buffer = buf; src.loop = true;
    const f = ctx.createBiquadFilter(); f.type = filterType || 'lowpass'; f.frequency.value = filterFreq || 1000;
    src.connect(f); f.connect(masterGain);
    return { src, filter: f };
  }
  function fadeIn(node, gain, val, time) {
    gain.gain.setValueAtTime(0, ctx.currentTime);
    gain.gain.linearRampToValueAtTime(val, ctx.currentTime + (time||2));
    node.start();
  }

  // ---------- 24 种放松音效 ----------
  const TRACKS = [
    // ===== 采耳系列 (8 种) =====
    { id:'ear_pick_wood',  name:'🌿 木质耳勺轻刮', cat:'采耳', desc:'温润木制耳勺在耳廓边缘轻柔刮擦，酥麻放松',
      gen:()=>{ const {osc,gain}=makeOsc('sine',1800,0); const lfo=ctx.createOscillator();lfo.frequency.value=0.3;const lfoG=ctx.createGain();lfoG.gain.value=400;lfo.connect(lfoG);lfoG.connect(osc.frequency);fadeIn(osc,gain,0.08,3);lfo.start();currentNodes.push(lfo);return osc; }},
    { id:'ear_cotton_swab', name:'☁️ 棉签轻柔旋转', cat:'采耳', desc:'棉签在耳道口缓缓旋转，柔软细腻的摩擦音',
      gen:()=>{ const {src}=makeNoiseBuffer(4,8000,'bandpass'); const g=ctx.createGain();g.gain.value=0;src.connect(g);g.connect(masterGain);fadeIn(src,g,0.06,2);return src; }},
    { id:'ear_brush',      name:'🖌️ 软毛刷轻扫', cat:'采耳', desc:'极细毛刷扫过耳廓，触发酥麻颤栗感',
      gen:()=>{ const {src}=makeNoiseBuffer(3,12000,'highpass'); const g=ctx.createGain();g.gain.value=0;src.connect(g);g.connect(masterGain);fadeIn(src,g,0.05,2);return src; }},
    { id:'ear_massage',    name:'💆 耳廓穴位按摩', cat:'采耳', desc:'指腹按压耳周穴位，配合低频嗡鸣助眠',
      gen:()=>{ const {osc,gain}=makeOsc('sine',128,0); const {osc:o2,gain:g2}=makeOsc('sine',192,0);fadeIn(osc,gain,0.12,4);fadeIn(o2,g2,0.06,4);return osc; }},
    { id:'ear_bubble',     name:'🫧 气泡胶采耳', cat:'采耳', desc:'气泡胶在耳旁轻柔破裂，密集细小爆破音',
      gen:()=>{ const g=ctx.createGain();g.gain.value=0;const intrv=setInterval(()=>{const o=ctx.createOscillator();const og=ctx.createGain();o.type='sine';o.frequency.value=2000+Math.random()*4000;og.gain.value=0.04;o.connect(og);og.connect(g);og.connect(masterGain);o.start();o.frequency.exponentialRampToValueAtTime(100,ctx.currentTime+0.08);og.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.1);o.stop(ctx.currentTime+0.12);},120);currentNodes.push({stop(){clearInterval(intrv);},disconnect(){}});g.connect(masterGain);return g; }},
